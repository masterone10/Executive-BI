      <div>
        <h3 id="accRuleModalTitle" style="margin:0;font-size:16px;font-weight:700;color:var(--ink)">+ Add Account Rule</h3>
        <p id="accRuleModalSubtitle" style="margin:3px 0 0 0;font-size:12px;color:var(--mut)">Configure permanent eligibility and blocked agents for this account</p>
