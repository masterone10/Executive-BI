        <div style="flex:1">
          <label for="accRuleModalName" style="display:block;font-size:12px;font-weight:700;color:var(--slate);margin-bottom:6px">Account Name <span style="color:#DC2626">*</span></label>
          <div style="display:flex;flex-direction:column;gap:6px">
            <input type="text" id="accRuleModalName" list="accRuleModalAccountList" placeholder="Search or type account name..." required oninput="onAccountRuleModalAccountChange(this.value)" onchange="onAccountRuleModalAccountChange(this.value)" style="width:100%;box-sizing:border-box;padding:9px 12px;border:1px solid var(--line);border-radius:8px;font-size:13px;outline:none">
            <datalist id="accRuleModalAccountList"></datalist>
            <select id="accRuleModalAccountSelect" onchange="onAccountRuleModalAccountChange(this.value)" style="width:100%;box-sizing:border-box;padding:8px 12px;border:1px solid var(--line);border-radius:8px;font-size:12.5px;background:#F8FAFC;outline:none">
              <option value="">-- Choose Account from Uploaded Sheets --</option>
            </select>
          </div>
          <div id="accRuleSavedNotice" style="margin-top:6px;display:none"></div>
        </div>
        <div style="padding-top:28px">
          <label style="display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;cursor:pointer">
            <input type="checkbox" id="accRuleModalActive" checked style="width:16px;height:16px;accent-color:var(--green)">
            Active Rule
          </label>
        </div>
      </div>

      <div>
        <label style="display:block;font-size:12px;font-weight:700;color:var(--blue);margin-bottom:6px">New Orders Eligible Agents (Leave empty for All New Team)</label>
        <div id="accRuleNewEligContainer" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(160px, 1fr));gap:6px;max-height:120px;overflow-y:auto;border:1px solid var(--line);padding:8px;border-radius:8px"></div>
      </div>

      <div>
        <label style="display:block;font-size:12px;font-weight:700;color:var(--purple);margin-bottom:6px">Pending Orders Eligible Agents (Leave empty for All Pending Team)</label>
        <div id="accRulePenEligContainer" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(160px, 1fr));gap:6px;max-height:120px;overflow-y:auto;border:1px solid var(--line);padding:8px;border-radius:8px"></div>
      </div>

      <div>
        <label style="display:block;font-size:12px;font-weight:700;color:#DC2626;margin-bottom:6px">🚫 Blocked Agents (Blocked Always Wins)</label>
        <div id="accRuleBlockedContainer" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(160px, 1fr));gap:6px;max-height:120px;overflow-y:auto;border:1px solid #FECACA;background:#FFF5F5;padding:8px;border-radius:8px"></div>
      </div>

      <div>
        <label for="accRuleModalNotes" style="display:block;font-size:12px;font-weight:700;color:var(--slate);margin-bottom:6px">Notes / Description</label>
        <input type="text" id="accRuleModalNotes" placeholder="e.g. VIP client, restricted to senior CS" style="width:100%;box-sizing:border-box;padding:8px 12px;border:1px solid var(--line);border-radius:8px;font-size:12.5px;outline:none">
      </div>

      <div id="accRuleModalError" style="display:none;padding:10px 14px;background:#FEE2E2;border:1px solid #FECACA;color:#991B1B;border-radius:8px;font-size:12px;line-height:1.4"></div>

      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:6px">
        <button type="button" class="btn" onclick="closeAccountRuleModal()">Cancel</button>
        <button type="submit" class="btn primary" id="accRuleModalSubmitBtn">Save Account Rule</button>
      </div>
    </form>
  </div>
</div>

