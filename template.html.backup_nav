<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CS Executive Performance Dashboard</title>
<meta name="description" content="Executive BI dashboard for Customer Service operational logs with deduplication, employee scorecards, cancellation risk analysis, and interactive reporting.">
<meta property="og:title" content="CS Executive Performance Dashboard">
<meta property="og:description" content="Executive BI dashboard for Customer Service operational logs with deduplication, employee scorecards, cancellation risk analysis, and interactive reporting.">
<!--XLSX_LIB_PLACEHOLDER-->
<style>
:root{
  --navy:#1E3A8A;--blue:#2563EB;--green:#16A34A;--amber:#F59E0B;--red:#DC2626;--purple:#7C3AED;
  --bg:#F8FAFC;--panel:#FFFFFF;--panel2:#F1F5F9;--line:#E2E8F0;--slate:#334155;--mut:#64748B;--ink:#0F172A;
  --shadow:0 1px 3px rgba(15,23,42,.06),0 1px 2px rgba(15,23,42,.04);
  --shadow-lg:0 10px 25px -5px rgba(15,23,42,.08),0 8px 10px -6px rgba(15,23,42,.04);
}
*{margin:0;padding:0;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
body{background:var(--bg);color:var(--ink);display:flex;min-height:100vh}
.app{display:flex;width:100%}
.side{width:260px;background:#0F172A;color:#fff;display:flex;flex-direction:column;flex-shrink:0;position:fixed;top:0;bottom:0;left:0;z-index:40;border-right:1px solid #1E293B}
.brand{padding:20px 18px;border-bottom:1px solid #1E293B}
.brand .logo{display:flex;align-items:center;gap:10px}
.brand .mark{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,var(--blue),var(--purple));display:grid;place-items:center;font-weight:800;font-size:16px;color:#fff;box-shadow:0 4px 12px rgba(37,99,235,.3)}
.brand h1{font-size:15px;font-weight:800;letter-spacing:-.3px;color:#F8FAFC}
.brand span{font-size:11px;color:#94A3B8;display:block}
.nav{flex:1;overflow-y:auto;padding:14px 10px}
.nav .lbl{font-size:10px;font-weight:700;color:#64748B;text-transform:uppercase;letter-spacing:.8px;padding:10px 12px 5px}
.nav a{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:9px;color:#CBD5E1;text-decoration:none;font-size:12.5px;font-weight:500;margin-bottom:2px;cursor:pointer;transition:.15s}
.nav a:hover{background:rgba(255,255,255,.07);color:#fff}
.nav a.active{background:var(--blue);color:#fff;font-weight:600;box-shadow:0 4px 12px rgba(37,99,235,.35)}
.nav a .ic{font-size:14px;opacity:.9;width:18px;text-align:center}
.side .foot{padding:14px 18px;border-top:1px solid #1E293B;font-size:11px;color:#64748B;line-height:1.5}
.main{margin-left:260px;flex:1;display:flex;flex-direction:column;min-width:0}
.top{position:sticky;top:0;background:rgba(255,255,255,.94);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);padding:12px 28px;display:flex;align-items:center;justify-content:space-between;z-index:30;flex-wrap:wrap;gap:12px}
.top .tt h2{font-size:19px;font-weight:800;letter-spacing:-.4px}
.top .tt p{font-size:12px;color:var(--mut);margin-top:2px}
.global-date-selector{display:inline-flex;align-items:center;gap:12px;background:#fff;border:1px solid var(--line);padding:5px 12px;border-radius:12px;box-shadow:0 1px 3px rgba(15,23,42,.05)}
.gds-label-group{display:flex;flex-direction:column;border-right:1px solid var(--line);padding-right:10px}
.gds-caption{font-size:10px;font-weight:700;color:var(--mut);text-transform:uppercase;letter-spacing:.5px;line-height:1}
.gds-badge{font-size:13px;font-weight:800;color:var(--navy);letter-spacing:-.2px;white-space:nowrap;margin-top:3px}
.gds-controls{display:flex;align-items:center;gap:6px}
.gds-btn{padding:5px 10px;font-size:11.5px;font-weight:600;border-radius:7px;border:1px solid var(--line);background:var(--panel2);color:var(--slate);cursor:pointer;transition:all .15s ease;white-space:nowrap;outline:none;user-select:none}
.gds-btn:hover{background:#E2E8F0;color:var(--ink)}
.gds-btn.active-today{background:#EFF6FF;color:var(--blue);border-color:#BFDBFE;font-weight:700}
.gds-cal-wrap{position:relative;display:inline-flex;align-items:center}
.gds-date-input{position:absolute;top:0;left:0;width:100%;height:100%;opacity:0;cursor:pointer}
.actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:7px;padding:8px 14px;border-radius:8px;font-size:12px;font-weight:600;border:1px solid var(--line);background:#fff;color:var(--slate);cursor:pointer;text-decoration:none;transition:.15s;outline:none}
.btn:hover{background:var(--panel2);color:var(--ink)}
.btn.primary{background:var(--blue);color:#fff;border-color:var(--blue)}
.btn.primary:hover{background:#1D4ED8}
.btn.success{background:var(--green);color:#fff;border-color:var(--green)}
.btn.success:hover{background:#15803D}
.btn.amber{background:var(--amber);color:#fff;border-color:var(--amber)}
.btn.amber:hover{background:#D97706}
.btn.sm{padding:5px 9px;font-size:11px}
.wrap{padding:24px 28px;max-width:1600px}
.dedup-banner{background:linear-gradient(135deg,#EFF6FF,#EEF2FF);border:1px solid #DBEAFE;border-radius:14px;padding:14px 18px;display:flex;align-items:center;gap:14px;margin-bottom:20px}
.dedup-banner .di{width:36px;height:36px;border-radius:9px;background:var(--blue);color:#fff;display:grid;place-items:center;font-size:16px;flex-shrink:0}
.dedup-banner .dt b{font-size:13px;color:var(--navy);display:block}
.dedup-banner .dt p{font-size:12px;color:var(--slate);margin-top:2px}
.dedup-banner .dm{margin-left:auto;text-align:right;flex-shrink:0}
.dedup-banner .dm b{font-size:20px;font-weight:800;color:var(--navy);display:block}
.dedup-banner .dm span{font-size:10.5px;color:var(--mut)}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin-bottom:20px}
.kpi{background:var(--panel);border-radius:15px;padding:17px;box-shadow:var(--shadow);position:relative;overflow:hidden;border:1px solid var(--line)}
.kpi::before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--c,var(--navy))}
.kpi .ico{width:37px;height:37px;border-radius:10px;display:grid;place-items:center;font-size:16px;background:color-mix(in srgb,var(--c,var(--navy)) 12%,#fff);color:var(--c,var(--navy));margin-bottom:10px}
.kpi .val{font-size:25px;font-weight:800;letter-spacing:-.5px;line-height:1}
.kpi .lbl{font-size:11px;color:var(--mut);letter-spacing:.3px;margin-top:7px;font-weight:600;text-transform:uppercase}
.kpi .sub{font-size:11.5px;margin-top:7px;color:var(--slate)}
.kpi .sub b{color:var(--c,var(--navy))}
.grid{display:grid;gap:16px;margin-bottom:16px}
.g2{grid-template-columns:1.4fr 1fr}.g2e{grid-template-columns:1fr 1fr}.g3{grid-template-columns:repeat(3,1fr)}
.panel{background:var(--panel);border-radius:15px;padding:19px;box-shadow:var(--shadow);border:1px solid var(--line)}
.panel h3{font-size:14px;font-weight:700;margin-bottom:3px;display:flex;align-items:center;gap:8px}
.panel .hd{margin-bottom:15px;display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:8px}
.panel .hd p{font-size:11.5px;color:var(--mut);margin-top:2px}
.tag{font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;letter-spacing:.2px}
.page{display:none;animation:fade .32s ease}.page.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.bars{display:flex;flex-direction:column;gap:10px}
.bar-row{display:grid;grid-template-columns:150px 1fr 62px;align-items:center;gap:12px}
.bar-row .nm{font-size:12.5px;color:var(--slate);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bar-track{height:11px;background:var(--panel2);border-radius:20px;overflow:hidden}
.bar-fill{height:100%;border-radius:20px;background:linear-gradient(90deg,var(--navy),var(--blue));transition:width 1s cubic-bezier(.2,.7,.2,1)}
.bar-row .vv{font-size:12.5px;font-weight:700;text-align:right}
.rk{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:7px;font-size:11px;font-weight:800;background:var(--panel2);color:var(--mut);margin-right:8px}
.rk.g1{background:linear-gradient(135deg,#FDE68A,#F59E0B);color:#7c4a03}
.rk.g2{background:linear-gradient(135deg,#E2E8F0,#94A3B8);color:#33415a}
.rk.g3{background:linear-gradient(135deg,#FDBA74,#EA580C);color:#7c2d12}
.donut-wrap{display:flex;align-items:center;gap:20px}
.donut{width:150px;height:150px;border-radius:50%;flex-shrink:0;display:grid;place-items:center;position:relative}
.donut::after{content:'';position:absolute;width:96px;height:96px;border-radius:50%;background:#fff;box-shadow:inset 0 1px 4px rgba(15,23,42,.08)}
.donut .ctr{position:relative;z-index:2;text-align:center}
.donut .ctr b{font-size:21px;font-weight:800}
.donut .ctr span{font-size:10px;color:var(--mut);display:block}
.leg{display:flex;flex-direction:column;gap:11px;flex:1}
.leg .li{display:flex;align-items:center;gap:9px}
.leg .dot{width:12px;height:12px;border-radius:4px;flex-shrink:0}
.leg .lt{font-size:12.5px;color:var(--slate);flex:1;font-weight:600}
.leg .lv{font-size:13px;font-weight:800}
.leg .lp{font-size:11px;color:var(--mut);margin-left:6px;font-weight:600}
.ins{display:flex;gap:12px;padding:13px 15px;border-radius:11px;background:var(--panel2);margin-bottom:9px;border-left:3px solid var(--blue)}
.ins .n{width:24px;height:24px;border-radius:7px;background:var(--navy);color:#fff;display:grid;place-items:center;font-size:11px;font-weight:800;flex-shrink:0}
.ins p{font-size:12.8px;color:var(--slate);line-height:1.55}
.obs{padding:14px 16px;border-radius:12px;background:var(--panel2);margin-bottom:11px;border:1px solid var(--line)}
.obs .th{display:flex;align-items:center;gap:9px;margin-bottom:6px}
.obs .th .b{font-size:13px;font-weight:700}
.obs .th .chip{font-size:9.5px;font-weight:800;padding:2px 8px;border-radius:20px;background:#FEE2E2;color:#B91C1C;letter-spacing:.2px}
.obs p{font-size:12.5px;color:var(--slate);line-height:1.6}
.tbl-tools{display:flex;gap:10px;margin-bottom:13px;flex-wrap:wrap}
.search{flex:1;min-width:200px;position:relative}
.search input{width:100%;padding:9px 13px 9px 34px;border:1px solid var(--line);border-radius:9px;font-size:13px;outline:none;background:#fff}
.search input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.1)}
.search .si{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--mut);font-size:13px}
select.filter, input.date-in{padding:8px 12px;border:1px solid var(--line);border-radius:8px;font-size:12.5px;color:var(--slate);background:#fff;cursor:pointer;outline:none}
.tbl-scroll{overflow-x:auto;border-radius:12px;border:1px solid var(--line)}
table{width:100%;border-collapse:collapse;font-size:12.5px;background:#fff}
thead th{background:var(--navy);color:#fff;padding:11px 12px;text-align:left;font-weight:600;font-size:11.5px;white-space:nowrap;cursor:pointer;user-select:none;position:sticky;top:0}
thead th:hover{background:#162e6e}
tbody td{padding:10px 12px;border-bottom:1px solid var(--line);color:var(--slate);white-space:nowrap}
tbody tr:hover{background:var(--panel2)}
.nm-cell{font-weight:600;color:var(--ink)}
.grade{font-weight:800;padding:3px 9px;border-radius:7px;font-size:11px;display:inline-block;min-width:32px;text-align:center}
.gr-A{background:#DCFCE7;color:#15803D}.gr-B{background:#DBEAFE;color:#1D4ED8}.gr-C{background:#FEF3C7;color:#B45309}.gr-D{background:#FEE2E2;color:#B91C1C}
.risk{font-size:10.5px;font-weight:700;padding:3px 9px;border-radius:20px}
.risk-High{background:#FEE2E2;color:#B91C1C}.risk-Elevated{background:#FEF3C7;color:#B45309}
.risk-Normal{background:#DCFCE7;color:#15803D}.risk-Low{background:#F1F5F9;color:#64748B}
.mini{width:60px;height:7px;background:var(--panel2);border-radius:20px;overflow:hidden;display:inline-block;vertical-align:middle}
.mini i{display:block;height:100%;background:linear-gradient(90deg,var(--navy),var(--blue))}
.seg{font-size:10.5px;font-weight:700;padding:3px 9px;border-radius:20px}
.seg-top{background:#DCFCE7;color:#15803D}.seg-core{background:#DBEAFE;color:#1D4ED8}.seg-dev{background:#FEF3C7;color:#B45309}.seg-att{background:#FEE2E2;color:#B91C1C}
.prof-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:15px}
.prof{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px;box-shadow:var(--shadow);transition:.18s}
.prof:hover{box-shadow:var(--shadow-lg);transform:translateY(-2px)}
.prof .ph{display:flex;align-items:center;gap:11px;margin-bottom:13px}
.prof .av{width:44px;height:44px;border-radius:11px;display:grid;place-items:center;font-weight:800;color:#fff;font-size:15px;flex-shrink:0}
.prof .pn{font-size:14px;font-weight:700;line-height:1.2}
.prof .pr{font-size:11px;color:var(--mut);margin-top:2px}
.prof .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-bottom:12px}
.prof .st{background:var(--panel2);border-radius:9px;padding:8px 5px;text-align:center}
.prof .st b{font-size:14px;font-weight:800;display:block}
.prof .st span{font-size:9px;color:var(--mut);letter-spacing:.2px}
.prof .metric{margin-bottom:8px}
.prof .metric .ml{display:flex;justify-content:space-between;font-size:11px;margin-bottom:4px}
.prof .metric .ml span{color:var(--mut);font-weight:600}.prof .metric .ml b{color:var(--slate)}
.prof .pbar{height:7px;background:var(--panel2);border-radius:20px;overflow:hidden}
.prof .pbar i{display:block;height:100%;border-radius:20px}
.stack{display:flex;height:26px;border-radius:8px;overflow:hidden;margin:6px 0}
.stack .sg{display:grid;place-items:center;font-size:10px;font-weight:700;color:#fff;min-width:0}
.hstat{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--line)}
.hstat .d{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.hstat .t{flex:1}.hstat .t b{font-size:12.5px;display:block}.hstat .t span{font-size:11px;color:var(--mut)}
.hstat .v{font-size:15px;font-weight:800}

/* WORK ALLOCATION STYLES (NEW) */
.alloc-bar{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-bottom:20px;box-shadow:var(--shadow)}
.alloc-stats{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.alloc-stat{background:var(--panel2);padding:7px 14px;border-radius:8px;font-size:12px;color:var(--slate)}
.alloc-stat b{color:var(--ink);margin-left:4px;font-weight:700}
.alloc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(460px,1fr));gap:16px;margin-bottom:24px}
.alloc-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:14px}
.alloc-card .head{display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--line);padding-bottom:12px}
.alloc-card .head .av{width:38px;height:38px;border-radius:10px;background:var(--navy);color:#fff;display:grid;place-items:center;font-weight:800;font-size:14px}
.alloc-card .head .title{font-size:14px;font-weight:700;color:var(--ink)}
.alloc-card .head .dept{font-size:11px;color:var(--mut)}
.alloc-rows{display:flex;flex-direction:column;gap:10px}
.alloc-row{display:grid;grid-template-columns:1.8fr 1.3fr auto auto;align-items:center;gap:10px;background:var(--panel2);padding:10px 12px;border-radius:10px;border:1px solid #E2E8F0}
.alloc-row select{padding:8px 10px;border:1px solid var(--line);border-radius:7px;font-size:12px;color:var(--ink);background:#fff;outline:none}
.alloc-row select:focus{border-color:var(--blue)}
.avail-badge{font-size:11px;padding:4px 9px;border-radius:6px;background:#E0E7FF;color:#3730A3;font-weight:600;white-space:nowrap}
.btn-del{border:none;background:transparent;color:#94A3B8;cursor:pointer;font-size:15px;padding:4px;border-radius:6px}
.btn-del:hover{color:var(--red);background:#FEE2E2}
.empty-alloc{text-align:center;padding:40px;color:var(--mut);font-size:13px}

/* SWITCH TOGGLE */
.switch{position:relative;display:inline-block;width:34px;height:18px}
.switch input{opacity:0;width:0;height:0}
.slider{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background-color:#CBD5E1;transition:.2s;border-radius:20px}
.slider:before{position:absolute;content:"";height:14px;width:14px;left:2px;bottom:2px;background-color:white;transition:.2s;border-radius:50%}
input:checked + .slider{background-color:var(--green)}
input:checked + .slider:before{transform:translateX(16px)}

@media(max-width:1100px){
  .kpis{grid-template-columns:repeat(2,1fr)}
  .g2,.g2e,.g3{grid-template-columns:1fr}
  .alloc-grid{grid-template-columns:1fr}
  .side{transform:translateX(-100%);transition:.3s}
  .side.open{transform:none}
  .main{margin-left:0}
  .menu-btn{display:inline-flex!important}
}
.menu-btn{display:none}
</style>
</head>
<body>
<div class="app">
  <aside class="side" id="side">
    <div class="brand">
      <div class="logo">
        <div class="mark">CS</div>
        <div><h1>Executive BI</h1><span>Performance Suite & Allocation</span></div>
      </div>
    </div>
    <nav class="nav">
      <div class="lbl">Overview</div>
      <a class="active" data-p="overview"><span class="ic">▤</span> Executive Overview</a>
      <a data-p="daily"><span class="ic">📈</span> Daily Trend</a>

      <div class="lbl">Work Allocation</div>
      <a data-p="work-allocation"><span class="ic">📋</span> Work Allocation</a>
      <a data-p="account-config"><span class="ic">⚡</span> Account Configuration</a>
      <a data-p="allocation-history"><span class="ic">⏳</span> Allocation History</a>
      <a data-p="current-orders"><span class="ic">📦</span> Current Orders Pool</a>

      <div class="lbl">Tracking & Auditing</div>
      <a data-p="tracking-overview"><span class="ic">🛡️</span> Tracking Overview</a>
      <a data-p="accounts"><span class="ic">📑</span> Accounts Directory</a>
      <a data-p="employee-tracking"><span class="ic">👤</span> Employee Reality</a>
      <a data-p="order-tracking"><span class="ic">🔍</span> Order Tracking</a>
      <a data-p="tracking-audit"><span class="ic">📋</span> Quality & Audit</a>

      <div class="lbl">Team Management</div>
      <a data-p="team-setup"><span class="ic">⚙️</span> Team Setup</a>
      <a data-p="working-team"><span class="ic">👥</span> Today's Working Team</a>
      <a data-p="team-members"><span class="ic">⚙</span> Employee Master</a>

      <div class="lbl">Performance Analysis</div>
      <a data-p="scorecard"><span class="ic">★</span> Scorecard</a>
      <a data-p="employees"><span class="ic">◉</span> Employee Profiles</a>
      <a data-p="cancel"><span class="ic">✕</span> Cancellation Analysis</a>
      <a data-p="pending"><span class="ic">⏳</span> Pending Analysis</a>
      <a data-p="printed"><span class="ic">✓</span> Printed Analysis</a>
      <a data-p="phone"><span class="ic">☎</span> Alt Phone Analysis</a>
      <a data-p="orders"><span class="ic">＋</span> Added Orders</a>

      <div class="lbl">Intelligence & Data</div>
      <a data-p="insights"><span class="ic">◈</span> Executive Insights</a>
      <a data-p="data"><span class="ic">▦</span> Detailed Data</a>
    </nav>
    <div class="foot">
      Deduplicated · SQLite Persistent<br>
      <span style="color:#16A34A;font-weight:700">✓ Manual Allocation & Audit Ready</span>
    </div>
  </aside>

  <div class="main">
    <div class="top">
      <div style="display:flex;align-items:center;gap:14px">
        <button class="btn menu-btn" onclick="document.getElementById('side').classList.toggle('open')">☰</button>
        <div class="tt">
          <h2 id="pgTitle">Executive Overview</h2>
          <p id="pgSub">Customer Service — Deduplicated Performance & Work Distribution</p>
        </div>
      </div>

      <!-- GLOBAL PERSISTENT DATE SELECTOR -->
      <div class="global-date-selector" id="globalDateSelector">
        <div class="gds-label-group">
          <span class="gds-caption">Selected Date</span>
          <div class="gds-badge" id="globalDateDisplay">08 Sep 2026</div>
        </div>
        <div class="gds-controls">
          <button type="button" class="gds-btn" id="btnPrevDay" onclick="navigateDateOffset(-1)" title="Previous Day">
            ◀ Previous Day
          </button>
          <button type="button" class="gds-btn active-today" id="btnToday" onclick="navigateDateToday()" title="Return to Today">
            Today
          </button>
          <button type="button" class="gds-btn" id="btnNextDay" onclick="navigateDateOffset(1)" title="Next Day">
            Next Day ▶
          </button>
          <div class="gds-cal-wrap">
            <label class="gds-btn" for="globalCalendarPicker" title="Pick any date from calendar" style="position:relative;cursor:pointer;display:inline-flex;align-items:center;margin:0">
              📅 Calendar
              <input type="date" id="globalCalendarPicker" class="gds-date-input" onchange="onGlobalDatePicked(this.value)">
            </label>
          </div>
        </div>
      </div>

      <div class="actions">
        <label class="btn primary" for="dailyLogInput" title="Upload Daily Log (.xlsx) at end of day to record performance snapshot">
          ⭱ Import Daily Log
        </label>
        <input class="file-in" type="file" id="dailyLogInput" accept=".xlsx,.xls" style="display:none" onchange="uploadDailyLog(this)">

        <label class="btn" for="specificOrdersInput" title="Upload Specific Orders (.xlsx) to update active accounts and manual work pool">
          ⭱ Import Specific Orders
        </label>
        <input class="file-in" type="file" id="specificOrdersInput" accept=".xlsx,.xls" style="display:none" onchange="uploadSpecificOrders(this)">

        <button class="btn" onclick="document.getElementById('shareModal').style.display='flex'">⇪ Share</button>
        <a class="btn" href="/api/export/excel" download>⭳ Excel</a>
        <button class="btn" onclick="window.print()">⭳ PDF</button>
      </div>
    </div>
    <div class="wrap" id="root"></div>
  </div>
</div>

<script>
let D = __DATA_PLACEHOLDER__;
const NAVY='#1E3A8A',BLUE='#2563EB',GREEN='#16A34A',AMBER='#F59E0B',RED='#DC2626',PURPLE='#7C3AED',SLATE='#64748B',MUT='#64748B';
const AV=['#1E3A8A','#2563EB','#0891B2','#7C3AED','#DB2777','#0D9488','#EA580C','#4F46E5','#059669','#C026D3'];
const fmt=n=>Number(n||0).toLocaleString('en-US');
const initials=n=>(n||'').replace(/\((pen|cs)\)/gi,'').trim().split(/\s+/).filter(w=>!/^(cs|new|data|entry)$/i.test(w)).slice(0,2).map(w=>w[0]||'').join('').toUpperCase()||'CS';
const isCSName=n=>String(n||'').trim().toLowerCase().endsWith('cs');

window.filterCSAddedTable = function(val) {
  const q = String(val || '').trim().toLowerCase();
  const rows = document.querySelectorAll('#csAddedTable tbody tr[data-emp]');
  rows.forEach(r => {
    const emp = r.getAttribute('data-emp') || '';
    r.style.display = emp.includes(q) ? '' : 'none';
  });
};

function kpiCard(ico,val,lbl,sub,c){
  return `<div class="kpi" style="--c:${c}"><div class="ico">${ico}</div><div class="val">${val}</div><div class="lbl">${lbl}</div>${sub?`<div class="sub">${sub}</div>`:''}</div>`;
}

function barList(items,max,color,fmtV){
  max=max||Math.max(...(items||[]).map(i=>i.value),1);
  return `<div class="bars">${(items||[]).map((it,i)=>{
    const rk=i<3?`g${i+1}`:'';
    return `<div class="bar-row"><div class="nm"><span class="rk ${rk}">${i+1}</span>${it.name}</div><div class="bar-track"><div class="bar-fill" style="width:0" data-w="${(it.value/max*100)}" ${color?`data-c="${color}"`:''}></div></div><div class="vv">${fmtV?fmtV(it.value):fmt(it.value)}</div></div>`;
  }).join('')}</div>`;
}

function animateBars(){
  setTimeout(()=>document.querySelectorAll('.bar-fill[data-w]').forEach(b=>{
    const c=b.getAttribute('data-c');if(c)b.style.background=c;
    b.style.width=b.getAttribute('data-w')+'%';
  }),60);
}

function scoreCell(v){return `<div style="display:flex;align-items:center;gap:8px"><span class="mini"><i style="width:${Math.min(v,100)}%"></i></span><b style="font-size:12px">${v.toFixed(0)}</b></div>`;}
function segClass(s){return {'Top Performer':'top','Core Contributor':'core','Developing':'dev','Needs Attention':'att'}[s]||'core';}
function riskClass(r){return r==='Low Volume'?'Low':r;}

function lineChart(series,keys,colors,labels,pctMode){
  if(!series||!series.length)return '<div style="padding:20px;text-align:center;color:var(--mut)">No trend data available</div>';
  const W=680,H=250,pad=38,padB=32;const pts=series.length;
  const allv=[].concat(...keys.map(k=>series.map(s=>s[k]||0)));
  const max=Math.max(...allv)*1.1||1,min=pctMode?0:Math.min(...allv)*0.9||0;
  const x=i=>pts<=1?(W/2):pad+(W-pad*2)*(i/(pts-1));
  const y=v=>H-padB-(H-pad-padB)*((v-min)/(max-min||1));
  let g='';for(let t=0;t<=4;t++){const yy=pad+(H-pad-padB)*t/4;const val=(max-(max-min)*t/4);g+=`<line x1="${pad}" y1="${yy}" x2="${W-pad}" y2="${yy}" stroke="#EEF2F6"/><text x="${pad-6}" y="${yy+3}" font-size="9" fill="#94A3B8" text-anchor="end">${pctMode?val.toFixed(0)+'%':Math.round(val)}</text>`;}
  let lines='';keys.forEach((k,ki)=>{let p='';series.forEach((s,i)=>{p+=(i?'L':'M')+x(i)+' '+y(s[k]||0)+' ';});
   lines+=`<path d="${p}" fill="none" stroke="${colors[ki]}" stroke-width="2.2"/>`;
   series.forEach((s,i)=>{if(i%2===0||pts<12)lines+=`<circle cx="${x(i)}" cy="${y(s[k]||0)}" r="2.6" fill="${colors[ki]}"/>`;});});
  let xl='';series.forEach((s,i)=>{if(i%3===0||pts<12)xl+=`<text x="${x(i)}" y="${H-12}" font-size="8.5" fill="#94A3B8" text-anchor="middle">${(s.day||s.date||'').replace(/.*-/,'')}</text>`;});
  const leg=keys.map((k,ki)=>`<span style="display:inline-flex;align-items:center;gap:5px;margin-right:16px;font-size:11.5px;color:var(--slate)"><span style="width:11px;height:11px;border-radius:3px;background:${colors[ki]}"></span>${labels[ki]}</span>`).join('');
  return `<div style="margin-bottom:6px">${leg}</div><svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto">${g}${lines}${xl}</svg>`;
}

// -------------------------------------------------------------
// GLOBAL DATE NAVIGATION ENGINE
// -------------------------------------------------------------
function getTodayDate() {
  return '2026-09-08';
}

function getInitialDate() {
  try {
    const params = new URLSearchParams(window.location.search);
    const d = params.get('date');
    if (d && /^\d{4}-\d{2}-\d{2}$/.test(d)) return d;
  } catch (e) {}

  try {
    const s = sessionStorage.getItem('executive_bi_selected_date');
    if (s && /^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
  } catch (e) {}

  return getTodayDate();
}

let currentWorkDate = getInitialDate();
let currentAccountsList = [];
let todayWorkingEmployees = [];
let activeAllocations = []; // [ { employee_id, account, status, available_orders }, ... ]

function formatDisplayDate(dateStr) {
  if (!dateStr) return '';
  const parts = String(dateStr).split('-');
  if (parts.length !== 3) return dateStr;
  const y = parseInt(parts[0], 10);
  const m = parseInt(parts[1], 10) - 1;
  const d = parseInt(parts[2], 10);
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const dayStr = String(d).padStart(2, '0');
  return `${dayStr} ${months[m]} ${y}`;
}

function shiftDate(dateStr, offsetDays) {
  const parts = String(dateStr || getTodayDate()).split('-');
  const y = parseInt(parts[0], 10);
  const m = parseInt(parts[1], 10) - 1;
  const d = parseInt(parts[2], 10);
  const dt = new Date(Date.UTC(y, m, d));
  dt.setUTCDate(dt.getUTCDate() + offsetDays);
  return dt.toISOString().split('T')[0];
}

function updateUrlDate(dateStr) {
  try {
    const url = new URL(window.location.href);
    url.searchParams.set('date', dateStr);
    window.history.replaceState({ date: dateStr, page: currentPage }, '', url.toString());
  } catch (e) {}
}

function updateGlobalDateUI() {
  const disp = document.getElementById('globalDateDisplay');
  if (disp) disp.textContent = formatDisplayDate(currentWorkDate);

  const cal = document.getElementById('globalCalendarPicker');
  if (cal) cal.value = currentWorkDate;

  const btnToday = document.getElementById('btnToday');
  if (btnToday) {
    if (currentWorkDate === getTodayDate()) {
      btnToday.classList.add('active-today');
    } else {
      btnToday.classList.remove('active-today');
    }
  }

  // Synchronize on-page date pickers if present in DOM
  const allocDate = document.getElementById('allocDateInput');
  if (allocDate && allocDate.value !== currentWorkDate) allocDate.value = currentWorkDate;

  const teamDate = document.getElementById('workingTeamDateInput');
  if (teamDate && teamDate.value !== currentWorkDate) teamDate.value = currentWorkDate;

  const curOrdersDate = document.getElementById('curOrdersDateInput');
  if (curOrdersDate && curOrdersDate.value !== currentWorkDate) curOrdersDate.value = currentWorkDate;
}

function navigateDateOffset(offset) {
  const nextDate = shiftDate(currentWorkDate, offset);
  setGlobalSelectedDate(nextDate);
}

function navigateDateToday() {
  setGlobalSelectedDate(getTodayDate());
}

function onGlobalDatePicked(val) {
  if (val && /^\d{4}-\d{2}-\d{2}$/.test(val)) {
    setGlobalSelectedDate(val);
  }
}

async function setGlobalSelectedDate(newDate) {
  if (!newDate || !/^\d{4}-\d{2}-\d{2}$/.test(newDate)) return;
  currentWorkDate = newDate;

  updateUrlDate(newDate);
  try { sessionStorage.setItem('executive_bi_selected_date', newDate); } catch(e){}
  updateGlobalDateUI();

  // Fetch performance metrics for this date
  await fetchPerformanceDataForDate(newDate);

  // Re-render
  RENDERED = pages();
  show(currentPage);
}

async function fetchPerformanceDataForDate(dateStr) {
  try {
    const data = await apiFetch(`/api/data?date=${dateStr}`);
    if (data && data.exists !== false && (data.employees || data.hr)) {
      D = data;
    } else {
      D = {
        exists: false,
        date: dateStr,
        employees: [],
        log_totals: { actions: 0, printed: 0, pending: 0, processing: 0, cancelled: 0, alt: 0 },
        status_totals: { Printed: 0, Pending: 0, Processing: 0, Cancelled: 0 },
        hr: { days: 0, tot_new: 0, tot_printed: 0, tot_cancel: 0, tot_add: 0 },
        daily: [],
        rankings: { printed: [], pending: [], cancelled: [] },
        cancel_rate_rank: [],
        addedOrders: { totalAdded: 0, totalAddedCS: 0, totalAddedNonCS: 0, fromCS: 0, fromOtherDepartments: 0, topCSContributors: [], allCSContributors: [] }
      };
    }
  } catch (err) {
    D = {
      exists: false,
      date: dateStr,
      employees: [],
      log_totals: { actions: 0, printed: 0, pending: 0, processing: 0, cancelled: 0, alt: 0 },
      status_totals: { Printed: 0, Pending: 0, Processing: 0, Cancelled: 0 },
      hr: { days: 0, tot_new: 0, tot_printed: 0, tot_cancel: 0, tot_add: 0 },
      daily: [],
      rankings: { printed: [], pending: [], cancelled: [] },
      cancel_rate_rank: [],
      addedOrders: { totalAdded: 0, totalAddedCS: 0, totalAddedNonCS: 0, fromCS: 0, fromOtherDepartments: 0, topCSContributors: [], allCSContributors: [] }
    };
  }
}

function renderEmptyState(title, subtitle, icon, canUploadDaily = true) {
  const isFuture = currentWorkDate > getTodayDate();
  const displayDate = formatDisplayDate(currentWorkDate);
  const actualTitle = isFuture
    ? `No data available for ${displayDate}.`
    : (title || `No performance data for ${displayDate}.`);
  const actualSub = isFuture
    ? `This is a future date. No operational records have been recorded yet.`
    : (subtitle || `No Daily Log performance snapshot was recorded for this date.`);

  return `
    <div class="empty-state-panel" style="background:#fff;border:1px solid var(--line);border-radius:14px;padding:50px 24px;text-align:center;box-shadow:var(--shadow);max-width:640px;margin:36px auto">
      <div style="width:60px;height:60px;border-radius:16px;background:#EFF6FF;color:var(--blue);font-size:26px;display:grid;place-items:center;margin:0 auto 16px">
        ${icon || '📅'}
      </div>
      <h3 style="font-size:18px;font-weight:800;color:var(--navy);margin-bottom:8px">${actualTitle}</h3>
      <p style="font-size:13px;color:var(--mut);line-height:1.6;max-width:440px;margin:0 auto 20px">${actualSub}</p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
        ${canUploadDaily && !isFuture ? `
          <label class="btn primary" for="dailyLogInput" style="cursor:pointer">
            ⭱ Upload Daily Log for ${displayDate}
          </label>
        ` : ''}
        <button class="btn" onclick="navigateDateToday()">Return to Today</button>
      </div>
    </div>
  `;
}

function escapeHtml(str) {
  if (str === null || str === undefined) return '';
  return String(str).replace(/[&<>"']/g, m => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  }[m]));
}

async function apiFetch(url, options = {}) {
  const res = await fetch(url, options);
  const contentType = res.headers.get('content-type') || '';
  let data;

  if (contentType.includes('application/json')) {
    try {
      data = await res.json();
    } catch (e) {
      data = null;
    }
  } else {
    const rawText = await res.text();
    try {
      data = JSON.parse(rawText);
    } catch (e) {
      // Remove HTML tags, styles, scripts and redundant whitespace
      const cleanText = rawText.replace(/<style[^>]*>[\s\S]*?<\/style>/gi, '')
                               .replace(/<script[^>]*>[\s\S]*?<\/script>/gi, '')
                               .replace(/<[^>]+>/g, ' ')
                               .replace(/\s+/g, ' ')
                               .trim();
      const preview = cleanText.length > 250 ? cleanText.substring(0, 250) + '...' : cleanText;
      throw new Error(preview || `Server returned HTTP ${res.status}: ${res.statusText}`);
    }
  }

  if (!res.ok) {
    const errMsg = (data && (data.error || data.message)) || `Server returned HTTP ${res.status}`;
    throw new Error(errMsg);
  }

  return data;
}

async function loadWorkAllocationData() {
  const container = document.getElementById('workAllocContainer');
  try {
    const [overviewRes, accRes, teamRes, allocRes] = await Promise.all([
      apiFetch(`/api/work/current?date=${currentWorkDate}`),
      apiFetch(`/api/work/accounts?date=${currentWorkDate}`),
      apiFetch(`/api/working-team/${currentWorkDate}`),
      apiFetch(`/api/allocations/${currentWorkDate}`).catch(() => ({ exists: false, items: [] }))
    ]);

    currentAccountsList = accRes || [];
    todayWorkingEmployees = (teamRes || []).filter(e => e.is_working);

    if (allocRes && allocRes.exists && allocRes.items) {
      activeAllocations = allocRes.items.map(it => ({
        employee_id: it.employee_id,
        account: it.account,
        status: it.status,
        available_orders: it.available_orders_at_assignment
      }));
    } else {
      activeAllocations = [];
    }

    renderWorkAllocationUI(overviewRes);
  } catch (err) {
    console.error('Error loading work allocation data:', err);
    if (container) {
      container.innerHTML = `
        <div class="panel" style="border:1px solid #FECACA;background:#FEF2F2;padding:24px;border-radius:12px;margin:20px 0">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px">
            <span style="font-size:22px">⚠️</span>
            <h3 style="margin:0;color:#991B1B">Failed to Load Work Allocation</h3>
          </div>
          <p style="color:#7F1D1D;font-size:13px;margin:0 0 14px 0">
            ${escapeHtml(err.message || 'An error occurred while loading work allocation data.')}
          </p>
          <div style="display:flex;gap:10px">
            <button class="btn primary sm" onclick="loadWorkAllocationData()">↻ Retry</button>
            <button class="btn sm" onclick="show('working-team')">👥 Check Working Team</button>
          </div>
        </div>
      `;
    }
  }
}

let workAllocViewMode = 'agents'; // 'agents' or 'accounts'
let currentOrderLevelAllocation = null;

function setWorkAllocViewMode(mode) {
  workAllocViewMode = mode;
  const overview = {
    total_orders: currentAccountsList.reduce((acc, curr) => acc + (curr.total_orders || 0), 0),
    accounts_count: currentAccountsList.length
  };
  renderWorkAllocationUI(overview);
}

function renderWorkAllocationUI(overview) {
  const container = document.getElementById('workAllocContainer');
  if (!container) return;

  const totalOrders = overview ? (overview.total_orders || 0) : 0;
  const accCount = overview ? (overview.accounts_count || currentAccountsList.length) : currentAccountsList.length;
  const teamCount = todayWorkingEmployees.length;

  let html = `
    <div class="alloc-bar">
      <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
        <label style="font-size:12.5px;font-weight:700">Allocation Date:</label>
        <input type="date" class="date-in" id="allocDateInput" value="${currentWorkDate}" onchange="changeAllocDate(this.value)">
      </div>
      <div class="alloc-stats">
        <div class="alloc-stat">Today's CS Team: <b>${teamCount} Agents</b></div>
        <div class="alloc-stat">Active Accounts: <b>${accCount} Accounts</b></div>
        <div class="alloc-stat">Work Pool: <b>${fmt(totalOrders)} Orders</b></div>
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
        <!-- View Mode Switch -->
        <div style="display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#F8FAFC;margin-right:6px">
          <button class="btn sm ${workAllocViewMode === 'agents' ? 'primary' : ''}" style="border-radius:0;border:none;padding:5px 10px;font-size:11.5px" onclick="setWorkAllocViewMode('agents')">👥 By CS Agent</button>
          <button class="btn sm ${workAllocViewMode === 'accounts' ? 'primary' : ''}" style="border-radius:0;border:none;padding:5px 10px;font-size:11.5px" onclick="setWorkAllocViewMode('accounts')">📦 By Account</button>
        </div>

        <!-- Smart Allocation Engine Buttons -->
        <button class="btn primary" onclick="runAutoFairAllocation(false)" title="Distributes work fairly. Preserves existing allocations if any.">⚡ Auto Fair Allocation</button>
        <button class="btn sm" onclick="confirmRegenerateAllocation()" title="Wipe current assignments and distribute from scratch" style="background:#FFF1F2;color:#BE123C;border-color:#FECDD3">🔄 Re-allocate All</button>
        <button class="btn sm" onclick="openOrderLevelModal()" style="background:#F0FDF4;color:#15803D;border-color:#BBF7D0">🔍 Order Details</button>
        <button class="btn sm" onclick="openCopyModal()">📋 Copy Allocation</button>
        <button class="btn success sm" onclick="saveManualAllocation()">💾 Save Allocation</button>
      </div>
    </div>
  `;

  if (teamCount === 0) {
    html += `
      <div class="panel empty-alloc">
        <div style="font-size:28px;margin-bottom:8px">👥</div>
        <b style="font-size:15px;color:var(--ink)">No CS employees selected for today's working team yet</b>
        <p style="margin:6px 0 16px">Select the team members working on ${currentWorkDate} to start fair work distribution.</p>
        <button class="btn primary" onclick="show('working-team')">Manage Today's Working Team</button>
      </div>
    `;
    container.innerHTML = html;
    return;
  }

  if (currentAccountsList.length === 0) {
    html += `
      <div class="panel empty-alloc" style="margin-bottom:20px;border:1px dashed var(--blue);background:#EFF6FF">
        <div style="font-size:26px;margin-bottom:6px">📦</div>
        <b style="font-size:14px;color:var(--navy)">No Specific Orders uploaded for this date yet</b>
        <p style="margin:4px 0 14px;color:var(--slate)">Upload a Specific Orders Excel file (e.g. SpecificOrders.xlsx) to populate the accounts list and order queue.</p>
        <label class="btn primary" for="specificOrdersInput">⭱ Upload Specific Orders Now</label>
      </div>
    `;
  }

  if (workAllocViewMode === 'accounts') {
    // -------------------------------------------------------------
    // ACCOUNT CARDS VIEW (Highlights ONE SMALL ACCOUNT → ONE EMPLOYEE)
    // -------------------------------------------------------------
    html += `<div class="alloc-grid">`;
    
    currentAccountsList.forEach(acc => {
      const accName = typeof acc === 'string' ? acc : (acc.account || acc.account_name || 'Unknown');
      const accAssigned = activeAllocations.filter(a => a.account && a.account.toLowerCase() === accName.toLowerCase());
      const totalAssignedOrders = accAssigned.reduce((s, a) => s + (a.available_orders || 0), 0);
      const isSmallAccount = totalAssignedOrders > 0 && totalAssignedOrders < 30;

      html += `
        <div class="alloc-card" style="border-top:3px solid ${isSmallAccount ? '#10B981' : 'var(--blue)'}">
          <div class="head" style="background:#F8FAFC">
            <div class="av" style="background:${isSmallAccount ? '#10B981' : 'var(--navy)'};color:#fff">${isSmallAccount ? '🎯' : '🏢'}</div>
            <div style="flex:1">
              <div class="title" style="font-size:14px;display:flex;align-items:center;gap:6px">
                ${escapeHtml(accName)}
                ${isSmallAccount ? '<span class="tag" style="background:#DCFCE7;color:#15803D;font-size:10.5px;font-weight:700">1 Account → 1 CS</span>' : ''}
              </div>
              <div class="dept">Assigned Agents: <b>${accAssigned.length} CS</b> · Total Orders: <b>${totalAssignedOrders > 0 ? totalAssignedOrders : 'Pending distribution'}</b></div>
            </div>
          </div>
          <div class="alloc-rows" style="padding:12px 14px">
      `;

      if (accAssigned.length === 0) {
        html += `<div style="font-size:12px;color:var(--mut);padding:8px 0">No CS agents assigned to this account yet. Click "Auto Fair Allocation" or switch to CS Agent view.</div>`;
      } else {
        html += `<div style="display:flex;flex-direction:column;gap:6px">`;
        accAssigned.forEach(assign => {
          const emp = todayWorkingEmployees.find(e => e.id === assign.employee_id);
          const empName = emp ? emp.name : `Agent #${assign.employee_id}`;
          const isNew = (assign.status || '').toLowerCase().includes('new');
          const isPen = (assign.status || '').toLowerCase().includes('pending');
          const tagBg = isNew ? '#DBEAFE' : isPen ? '#F3E8FF' : '#DCFCE7';
          const tagCol = isNew ? '#1E40AF' : isPen ? '#6B21A8' : '#166534';
          const ordCount = assign.available_orders || 0;

          html += `
            <div style="display:flex;align-items:center;justify-content:space-between;background:#fff;border:1px solid var(--line);padding:8px 12px;border-radius:8px">
              <div style="display:flex;align-items:center;gap:8px">
                <div class="av" style="width:24px;height:24px;font-size:10px">${initials(empName)}</div>
                <b style="font-size:12.5px">${escapeHtml(empName)}</b>
              </div>
              <div style="display:flex;align-items:center;gap:8px">
                <span class="tag" style="background:${tagBg};color:${tagCol};font-weight:700;font-size:11px">${escapeHtml(assign.status || 'Active')}</span>
                <span style="font-size:12px;font-weight:700;color:var(--ink)">${ordCount ? ordCount + ' orders' : ''}</span>
              </div>
            </div>
          `;
        });
        html += `</div>`;
      }

      html += `
          </div>
        </div>
      `;
    });

    html += `</div>`;
  } else {
    // -------------------------------------------------------------
    // CS AGENT CARDS VIEW (DEFAULT - Shows Account count & Order count)
    // -------------------------------------------------------------
    html += `<div class="alloc-grid">`;

    todayWorkingEmployees.forEach(emp => {
      const empAssignments = activeAllocations.filter(a => a.employee_id === emp.id);
      const empTotalOrders = empAssignments.reduce((s, a) => s + (a.available_orders || 0), 0);
      const smallAccountsCount = empAssignments.filter(a => (a.available_orders || 0) < 30).length;

      html += `
        <div class="alloc-card" id="card-emp-${emp.id}">
          <div class="head">
            <div class="av">${initials(emp.name)}</div>
            <div style="flex:1">
              <div class="title">${escapeHtml(emp.name)}</div>
              <div class="dept"><b>${empAssignments.length} Accounts</b> (${smallAccountsCount} Small) · <b>${empTotalOrders} Orders</b></div>
            </div>
            <button class="btn sm" onclick="addAssignmentRow(${emp.id})">+ Add Account</button>
          </div>
          <div class="alloc-rows" id="rows-emp-${emp.id}">
      `;

      if (empAssignments.length === 0) {
        html += `<div style="font-size:12px;color:var(--mut);padding:10px 0" id="empty-msg-${emp.id}">No accounts assigned yet. Click "+ Add Account" to assign.</div>`;
      } else {
        empAssignments.forEach((assign, rowIdx) => {
          html += renderSingleAssignmentRow(emp.id, rowIdx, assign.account, assign.status, assign.available_orders);
        });
      }

      html += `
          </div>
        </div>
      `;
    });

    html += `</div>`;
  }

  container.innerHTML = html;
}

function renderSingleAssignmentRow(empId, rowIdx, selectedAccount, selectedStatus, availableCount) {
  const accOptions = currentAccountsList.map(a => {
    const name = typeof a === 'string' ? a : (a.account || a.account_name || '');
    return `<option value="${escapeHtml(name)}" ${name === selectedAccount ? 'selected' : ''}>${escapeHtml(name)}</option>`;
  }).join('');

  return `
    <div class="alloc-row" id="row-${empId}-${rowIdx}">
      <select onchange="onAccountChanged(${empId}, ${rowIdx}, this.value)">
        <option value="">-- Choose Account --</option>
        ${accOptions}
      </select>
      <select id="status-sel-${empId}-${rowIdx}" onchange="onStatusChanged(${empId}, ${rowIdx}, this.value)">
        <option value="New" ${selectedStatus === 'New' ? 'selected' : ''}>New</option>
        <option value="Pending" ${selectedStatus === 'Pending' ? 'selected' : ''}>Pending</option>
        <option value="New + Pending" ${selectedStatus === 'New + Pending' ? 'selected' : ''}>New + Pending</option>
      </select>
      <span class="avail-badge" id="avail-badge-${empId}-${rowIdx}">${availableCount ? availableCount + ' orders' : 'Available: -'}</span>
      <button class="btn-del" title="Remove assignment" onclick="removeAssignmentRow(${empId}, ${rowIdx})">✕</button>
    </div>
  `;
}

function addAssignmentRow(empId) {
  const emptyMsg = document.getElementById(`empty-msg-${empId}`);
  if (emptyMsg) emptyMsg.remove();

  const firstAcc = currentAccountsList[0];
  const firstAccName = typeof firstAcc === 'string' ? firstAcc : (firstAcc ? firstAcc.account || firstAcc.account_name || '' : '');
  const rowIdx = Date.now() + Math.floor(Math.random() * 1000);

  const newAssign = {
    employee_id: empId,
    account: firstAccName,
    status: 'New',
    available_orders: 0
  };
  activeAllocations.push(newAssign);

  const container = document.getElementById(`rows-emp-${empId}`);
  if (container) {
    const div = document.createElement('div');
    div.innerHTML = renderSingleAssignmentRow(empId, rowIdx, newAssign.account, newAssign.status, 0);
    container.appendChild(div.firstElementChild);

    if (newAssign.account) {
      updateAvailableCount(empId, rowIdx, newAssign.account, newAssign.status);
    }
  }
}

function removeAssignmentRow(empId, rowIdx) {
  const row = document.getElementById(`row-${empId}-${rowIdx}`);
  if (row) {
    const selAccount = row.querySelector('select')?.value || '';
    row.remove();
    const idx = activeAllocations.findIndex(a => a.employee_id === empId && a.account === selAccount);
    if (idx !== -1) activeAllocations.splice(idx, 1);
  }
}

async function onAccountChanged(empId, rowIdx, account) {
  const statusSel = document.getElementById(`status-sel-${empId}-${rowIdx}`);
  if (!account) return;

  try {
    const statuses = await apiFetch(`/api/work/account-statuses?date=${currentWorkDate}&account=${encodeURIComponent(account)}`);
    if (statusSel && Array.isArray(statuses) && statuses.length > 0) {
      statusSel.innerHTML = statuses.map(s => `<option value="${s}">${s}</option>`).join('');
    }
    const curStatus = statusSel ? statusSel.value : 'New';
    updateAvailableCount(empId, rowIdx, account, curStatus);
  } catch (e) {
    console.error('Failed to load statuses:', e);
  }
}

function onStatusChanged(empId, rowIdx, status) {
  const row = document.getElementById(`row-${empId}-${rowIdx}`);
  const account = row ? row.querySelector('select')?.value : '';
  if (account) {
    updateAvailableCount(empId, rowIdx, account, status);
  }
}

async function updateAvailableCount(empId, rowIdx, account, status) {
  const badge = document.getElementById(`avail-badge-${empId}-${rowIdx}`);
  if (!badge || !account) return;

  try {
    const res = await apiFetch(`/api/work/available-orders?date=${currentWorkDate}&account=${encodeURIComponent(account)}&status=${encodeURIComponent(status)}`);
    badge.textContent = res.display || `${res.total || 0} orders`;
  } catch (e) {
    badge.textContent = '-';
  }
}

async function changeAllocDate(newDate) {
  await setGlobalSelectedDate(newDate);
}

/**
 * Smart Fair Allocation Engine (Account + Status -> Eligible CS -> Fair Quota -> Random Order Codes)
 * Incremental by default: preserves existing allocations.
 */
async function runAutoFairAllocation(regenerate = false) {
  try {
    const res = await apiFetch(`/api/allocations/${currentWorkDate}/generate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        method: 'fair_random',
        regenerate
      })
    });

    if (res.success) {
      currentOrderLevelAllocation = res;
      // Convert order-level by_employee into activeAllocations structure for UI
      const newActive = [];
      if (Array.isArray(res.by_employee)) {
        for (const emp of res.by_employee) {
          if (Array.isArray(emp.accounts)) {
            for (const acc of emp.accounts) {
              newActive.push({
                employee_id: emp.employee_id,
                account: acc.account,
                status: acc.status,
                available_orders: acc.count || 0
              });
            }
          }
        }
      }
      activeAllocations = newActive;
      
      // Auto-save the generated allocation to finalize version
      await apiFetch(`/api/allocations/${currentWorkDate}/save-order-level`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          raw_allocations: res.raw_allocations,
          by_employee: res.by_employee,
          notes: regenerate ? 'Re-generated Fair Allocation (Scratch)' : 'Incremental Fair Allocation'
        })
      }).catch(console.warn);

      const presMsg = res.preserved_orders_count > 0 ? ` (${res.preserved_orders_count} previously assigned orders preserved)` : '';
      showToast('✓ Fair Allocation Complete!', `${res.assigned_orders} orders distributed across ${res.by_employee.length} agents${presMsg}.`);
      
      const overview = await apiFetch(`/api/work/current?date=${currentWorkDate}`).catch(() => null);
      renderWorkAllocationUI(overview);
    } else {
      alert('Allocation error: ' + (res.error || 'Failed to generate allocation'));
    }
  } catch (err) {
    console.error('Allocation failure:', err);
    alert('Failed to generate allocation: ' + err.message);
  }
}

function confirmRegenerateAllocation() {
  if (confirm(`⚠️ Are you sure you want to re-allocate ALL orders from scratch for ${currentWorkDate}?\n\nThis will re-calculate fair quotas and random order codes for all active accounts.`)) {
    runAutoFairAllocation(true);
  }
}

async function saveManualAllocation() {
  const assignments = [];
  const seen = new Set();

  for (const emp of todayWorkingEmployees) {
    const rows = document.querySelectorAll(`#rows-emp-${emp.id} .alloc-row`);
    for (const r of rows) {
      const selects = r.querySelectorAll('select');
      const account = selects[0]?.value;
      const status = selects[1]?.value;
      const badgeTxt = r.querySelector('.avail-badge')?.textContent || '';
      const numMatch = badgeTxt.match(/\d+/);
      const availCount = numMatch ? parseInt(numMatch[0], 10) : 0;

      if (!account) continue;

      const dupKey = `${emp.id}|${account}|${status}`;
      if (seen.has(dupKey)) {
        alert(`Duplicate assignment detected: ${emp.name} already has ${account} (${status}). Please remove the duplicate row.`);
        return;
      }
      seen.add(dupKey);

      assignments.push({
        employee_id: emp.id,
        account,
        status,
        available_orders: availCount
      });
    }
  }

  if (assignments.length === 0) {
    alert('Please assign at least one account before saving.');
    return;
  }

  try {
    const res = await apiFetch('/api/allocations', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        work_date: currentWorkDate,
        assignments,
        notes: `Saved via Executive Dashboard on ${new Date().toLocaleTimeString()}`
      })
    });

    if (res.success) {
      showToast('✓ Allocation saved successfully!', `${assignments.length} assignments stored for ${todayWorkingEmployees.length} agents.`);
    } else {
      alert('Error: ' + (res.error || 'Failed to save allocation'));
    }
  } catch (err) {
    alert('Save failed: ' + err.message);
  }
}

// -------------------------------------------------------------
// COPY ALLOCATION MODAL (Advanced Formats)
// -------------------------------------------------------------
async function openCopyModal() {
  const modal = document.getElementById('copyAllocationModal');
  if (!modal) return;

  // Populate CS agent dropdown
  const empSelect = document.getElementById('copyModalEmpSelect');
  if (empSelect) {
    empSelect.innerHTML = todayWorkingEmployees.map(e => `<option value="${e.id}">${escapeHtml(e.name)}</option>`).join('');
  }

  // Populate Account dropdown
  const accSelect = document.getElementById('copyModalAccSelect');
  if (accSelect) {
    accSelect.innerHTML = currentAccountsList.map(a => {
      const name = typeof a === 'string' ? a : (a.account || a.account_name || '');
      return `<option value="${escapeHtml(name)}">${escapeHtml(name)}</option>`;
    }).join('');
  }

  modal.style.display = 'flex';
  await refreshCopyPreview();
}

function closeCopyModal() {
  const modal = document.getElementById('copyAllocationModal');
  if (modal) modal.style.display = 'none';
}

async function refreshCopyPreview() {
  const format = document.getElementById('copyModalFormatSelect')?.value || 'all_employees';
  const empRow = document.getElementById('copyModalEmpRow');
  const accRow = document.getElementById('copyModalAccRow');
  const previewArea = document.getElementById('copyModalPreviewText');

  if (empRow) empRow.style.display = format === 'single_employee' ? 'block' : 'none';
  if (accRow) accRow.style.display = format === 'account' ? 'block' : 'none';

  let target = '';
  if (format === 'single_employee') {
    target = document.getElementById('copyModalEmpSelect')?.value || '';
  } else if (format === 'account') {
    target = document.getElementById('copyModalAccSelect')?.value || '';
  }

  try {
    let url = `/api/allocations/${currentWorkDate}/copy-text?format=${encodeURIComponent(format)}`;
    if (target) url += `&target=${encodeURIComponent(target)}`;
    const res = await apiFetch(url);
    if (previewArea) {
      previewArea.value = res.text || 'No allocation text available for selected parameters.';
    }
  } catch (err) {
    if (previewArea) previewArea.value = 'Failed to generate copy text: ' + err.message;
  }
}

async function executeCopyModalText() {
  const previewArea = document.getElementById('copyModalPreviewText');
  const text = previewArea ? previewArea.value : '';
  if (!text) {
    alert('No text to copy.');
    return;
  }
  try {
    await navigator.clipboard.writeText(text);
    showToast('📋 Copied to Clipboard!', 'Ready to paste directly into WhatsApp, Teams, or Slack.');
    closeCopyModal();
  } catch (err) {
    alert('Failed to copy: ' + err.message);
  }
}

async function copyAllocationText(format = 'standard') {
  try {
    const fmtParam = format === 'compact' ? 'compact' : 'all_employees';
    const res = await apiFetch(`/api/allocations/${currentWorkDate}/copy-text?format=${fmtParam}`);
    if (res.text) {
      await navigator.clipboard.writeText(res.text);
      showToast('📋 Copied to Clipboard!', 'Ready to paste into WhatsApp, Teams, or Slack.');
    } else {
      alert('No allocation text generated.');
    }
  } catch (err) {
    console.error(err);
    alert('Failed to copy: ' + err.message);
  }
}

// -------------------------------------------------------------
// ORDER-LEVEL AUDIT & MANUAL OVERRIDE MODAL
// -------------------------------------------------------------
let orderLevelModalData = null;

async function openOrderLevelModal() {
  const modal = document.getElementById('orderLevelModal');
  if (!modal) return;

  modal.style.display = 'flex';
  const content = document.getElementById('orderLevelModalContent');
  if (content) content.innerHTML = '<div style="text-align:center;padding:40px;color:var(--slate)"><div class="spin" style="margin-bottom:12px">⏳</div>Loading order-level allocations...</div>';

  try {
    const res = await apiFetch(`/api/allocations/${currentWorkDate}/order-level`);
    orderLevelModalData = res;
    renderOrderLevelModalTable();
  } catch (err) {
    if (content) {
      content.innerHTML = `
        <div style="text-align:center;padding:30px;color:var(--slate)">
          <div style="font-size:32px;margin-bottom:8px">📦</div>
          <b style="color:var(--ink)">No Order-Level Allocation Stored Yet</b>
          <p style="font-size:12.5px;margin:6px 0 16px">Click "⚡ Auto Fair Allocation" on the main screen to generate and assign individual order codes.</p>
          <button class="btn primary sm" onclick="closeOrderLevelModal();runAutoFairAllocation(false)">⚡ Generate Fair Allocation Now</button>
        </div>
      `;
    }
  }
}

function closeOrderLevelModal() {
  const modal = document.getElementById('orderLevelModal');
  if (modal) modal.style.display = 'none';
}

function renderOrderLevelModalTable() {
  const content = document.getElementById('orderLevelModalContent');
  if (!content || !orderLevelModalData) return;

  const orders = orderLevelModalData.orders || [];
  const search = (document.getElementById('orderLevelSearch')?.value || '').toLowerCase().trim();
  const accFilter = document.getElementById('orderLevelAccFilter')?.value || '';
  const empFilter = document.getElementById('orderLevelEmpFilter')?.value || '';

  const filtered = orders.filter(o => {
    if (search && !o.order_code.toLowerCase().includes(search) && !(o.employee_name || '').toLowerCase().includes(search)) return false;
    if (accFilter && o.account !== accFilter) return false;
    if (empFilter && String(o.employee_id) !== empFilter) return false;
    return true;
  });

  const empOptions = todayWorkingEmployees.map(e => `<option value="${e.id}">${escapeHtml(e.name)}</option>`).join('');

  let html = `
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:14px">
      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <input type="text" id="orderLevelSearch" placeholder="Search order code or agent..." value="${escapeHtml(search)}" oninput="renderOrderLevelModalTable()" style="padding:6px 12px;border:1px solid var(--line);border-radius:8px;font-size:12.5px;min-width:200px">
        <select id="orderLevelAccFilter" onchange="renderOrderLevelModalTable()" style="padding:6px 10px;border:1px solid var(--line);border-radius:8px;font-size:12px">
          <option value="">All Accounts</option>
          ${Array.from(new Set(orders.map(o => o.account))).map(a => `<option value="${escapeHtml(a)}" ${a === accFilter ? 'selected' : ''}>${escapeHtml(a)}</option>`).join('')}
        </select>
        <select id="orderLevelEmpFilter" onchange="renderOrderLevelModalTable()" style="padding:6px 10px;border:1px solid var(--line);border-radius:8px;font-size:12px">
          <option value="">All Agents</option>
          ${todayWorkingEmployees.map(e => `<option value="${e.id}" ${String(e.id) === empFilter ? 'selected' : ''}>${escapeHtml(e.name)}</option>`).join('')}
        </select>
      </div>
      <div style="font-size:12.5px;color:var(--slate)">
        Showing <b>${filtered.length}</b> of <b>${orders.length}</b> orders
      </div>
    </div>

    <div class="tbl-scroll" style="max-height:420px;overflow-y:auto;border:1px solid var(--line);border-radius:8px">
      <table>
        <thead>
          <tr>
            <th style="width:45px">#</th>
            <th>Order Code</th>
            <th>Account</th>
            <th>Status</th>
            <th>Assigned Agent</th>
            <th>Method / Rule</th>
            <th style="text-align:right">Override</th>
          </tr>
        </thead>
        <tbody>
          ${filtered.map((ord, idx) => {
            const isNew = (ord.status || '').toLowerCase().includes('new');
            const statusBg = isNew ? '#DBEAFE' : '#F3E8FF';
            const statusCol = isNew ? '#1E40AF' : '#6B21A8';
            return `
              <tr>
                <td><span class="rk">${idx + 1}</span></td>
                <td><b style="font-family:monospace;font-size:12px">${escapeHtml(ord.order_code)}</b></td>
                <td><b>${escapeHtml(ord.account)}</b></td>
                <td><span class="tag" style="background:${statusBg};color:${statusCol};font-weight:700">${escapeHtml(ord.status)}</span></td>
                <td>
                  <span style="font-weight:700;color:var(--ink)">${escapeHtml(ord.employee_name || 'UNASSIGNED')}</span>
                  ${ord.is_override ? '<span class="tag" style="background:#FEF3C7;color:#D97706;font-size:10px;margin-left:4px">Manual Override</span>' : ''}
                </td>
                <td style="font-size:11.5px;color:var(--mut)">${escapeHtml(ord.rule_note || ord.method || 'Fair Random')}</td>
                <td style="text-align:right">
                  <select onchange="overrideSingleOrder('${escapeHtml(ord.order_code)}', this.value)" style="padding:3px 6px;border:1px solid var(--line);border-radius:6px;font-size:11.5px;background:#fff">
                    <option value="">Reassign to...</option>
                    ${empOptions}
                  </select>
                </td>
              </tr>
            `;
          }).join('')}
        </tbody>
      </table>
    </div>
  `;

  content.innerHTML = html;
}

async function overrideSingleOrder(orderCode, employeeId) {
  if (!employeeId || !orderCode) return;
  try {
    const res = await apiFetch(`/api/allocations/${currentWorkDate}/override`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        order_code: orderCode,
        employee_id: parseInt(employeeId, 10)
      })
    });
    if (res.success) {
      showToast('✓ Order Reassigned', `Order ${orderCode} reassigned to ${res.employee_name}`);
      // Refresh order-level data
      const updated = await apiFetch(`/api/allocations/${currentWorkDate}/order-level`);
      orderLevelModalData = updated;
      renderOrderLevelModalTable();
    }
  } catch (err) {
    alert('Failed to override order: ' + err.message);
  }
}


// -------------------------------------------------------------
// TODAY'S WORKING TEAM MANAGEMENT (Part 12)
// -------------------------------------------------------------
async function loadWorkingTeamView() {
  const container = document.getElementById('workingTeamContainer');
  if (!container) return;

  try {
    const rows = await apiFetch(`/api/working-team/${currentWorkDate}`);
    let html = `
      <div class="panel">
        <div class="hd">
          <div>
            <h3>👥 Today's Working Team Setup</h3>
            <p>Select which CS agents are working on this specific date. Independent per date.</p>
          </div>
          <div style="display:flex;gap:10px;align-items:center">
            <input type="date" class="date-in" id="workingTeamDateInput" value="${currentWorkDate}" onchange="changeWorkingTeamDate(this.value)">
            <button class="btn sm" onclick="toggleAllWorkingTeam(true)">Select All</button>
            <button class="btn sm" onclick="toggleAllWorkingTeam(false)">Clear All</button>
            <button class="btn primary sm" onclick="saveWorkingTeamSelection()">💾 Save Today's Team</button>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;margin-top:14px">
    `;

    rows.forEach(e => {
      html += `
        <label style="display:flex;align-items:center;gap:12px;background:var(--panel2);padding:10px 14px;border-radius:10px;cursor:pointer;border:1px solid var(--line)">
          <input type="checkbox" class="team-chk" value="${e.id}" ${e.is_working ? 'checked' : ''} style="width:17px;height:17px;cursor:pointer">
          <div>
            <b style="font-size:13px;display:block">${escapeHtml(e.name)}</b>
            <span style="font-size:11px;color:var(--mut)">${escapeHtml(e.department)}</span>
          </div>
        </label>
      `;
    });

    html += `</div></div>`;
    container.innerHTML = html;
  } catch (err) {
    console.error('Error loading working team:', err);
    container.innerHTML = `
      <div class="panel" style="border:1px solid #FECACA;background:#FEF2F2;padding:24px;border-radius:12px;margin:20px 0">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px">
          <span style="font-size:22px">⚠️</span>
          <h3 style="margin:0;color:#991B1B">Failed to Load Working Team</h3>
        </div>
        <p style="color:#7F1D1D;font-size:13px;margin:0 0 14px 0">
          ${escapeHtml(err.message || 'An error occurred while loading today\'s working team.')}
        </p>
        <button class="btn primary sm" onclick="loadWorkingTeamView()">↻ Retry</button>
      </div>
    `;
  }
}

function changeWorkingTeamDate(d) {
  setGlobalSelectedDate(d);
}

function toggleAllWorkingTeam(val) {
  document.querySelectorAll('.team-chk').forEach(c => c.checked = val);
}

async function saveWorkingTeamSelection() {
  const checkedIds = Array.from(document.querySelectorAll('.team-chk:checked')).map(c => parseInt(c.value, 10));
  try {
    const res = await apiFetch(`/api/working-team/${currentWorkDate}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ employee_ids: checkedIds })
    });

    if (res.success) {
      showToast('✓ Working team updated!', `${checkedIds.length} agents set as active for ${currentWorkDate}.`);
      await loadWorkAllocationData();
    }
  } catch (e) {
    showToast('❌ Error Saving Team', e.message);
    alert('Failed to save working team: ' + e.message);
  }
}

// -------------------------------------------------------------
// EMPLOYEE MASTER (Part 11)
// -------------------------------------------------------------
let allEmployeesMaster = [];

async function loadTeamMembersView() {
  const container = document.getElementById('teamMembersContainer');
  if (!container) return;

  try {
    const empsData = await apiFetch('/api/employees');
    allEmployeesMaster = Array.isArray(empsData) ? empsData : (empsData.employees || []);
    
    let html = `
      <div class="panel">
        <div class="hd" style="align-items:flex-start">
          <div>
            <h3>⚙ Employee Master</h3>
            <p>Permanent Employee Registry. Historical performance and allocation records remain permanently intact even if inactive.</p>
          </div>
          <button class="btn primary sm" id="addEmployeeBtn" onclick="openAddEmployeeModal()">+ Add Employee</button>
        </div>

        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;gap:12px;flex-wrap:wrap">
          <div style="position:relative;flex:1;max-width:320px">
            <input type="text" id="empSearchInput" placeholder="🔍 Search employee name or dept..." oninput="filterEmployeeMasterTable(this.value)" style="width:100%;box-sizing:border-box;padding:8px 12px;border:1px solid var(--line);border-radius:8px;font-size:12.5px;outline:none">
          </div>
          <div style="font-size:12px;color:var(--mut);font-weight:600" id="empTotalCountLabel">
            Total Employees: ${allEmployeesMaster.length} (${allEmployeesMaster.filter(e => e.active).length} Active)
          </div>
        </div>

        <div class="tbl-scroll">
          <table>
            <thead>
              <tr>
                <th style="width:48px">#</th>
                <th>Name</th>
                <th style="width:130px">Department</th>
                <th style="width:140px">Status</th>
                <th style="width:120px">Created</th>
                <th style="width:90px">Actions</th>
              </tr>
            </thead>
            <tbody id="teamMembersTableBody">
    `;

    if (allEmployeesMaster.length === 0) {
      html += `<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--mut)">No employees found. Click "+ Add Employee" to add one.</td></tr>`;
    } else {
      allEmployeesMaster.forEach((e, idx) => {
        html += `
          <tr data-id="${e.id}" data-name="${escapeHtml(e.name)}" data-dept="${escapeHtml(e.department)}">
            <td>${idx + 1}</td>
            <td class="nm-cell">${escapeHtml(e.name)}</td>
            <td><span class="tag" style="background:${e.department==='CS'?'#DCFCE7':'#E0E7FF'};color:${e.department==='CS'?'#15803D':'#3730A3'}">${escapeHtml(e.department)}</span></td>
            <td>
              <div style="display:flex;align-items:center">
                <label class="switch" title="Toggle Active / Inactive">
                  <input type="checkbox" id="empSwitch_${e.id}" ${e.active ? 'checked' : ''} onchange="toggleEmployeeStatus(${e.id}, this.checked)">
                  <span class="slider"></span>
                </label>
                <span id="empStatusLabel_${e.id}" style="font-size:11px;margin-left:8px;font-weight:700;color:${e.active ? '#15803D' : '#94A3B8'}">${e.active ? 'Active' : 'Inactive'}</span>
              </div>
            </td>
            <td style="color:var(--mut);font-size:11px">${escapeHtml((e.created_at||'').split(' ')[0])}</td>
            <td>
              <button class="btn sm" id="editEmpBtn_${e.id}" onclick="openEditEmployeeModal(${e.id})">Edit</button>
            </td>
          </tr>
        `;
      });
    }

    html += `</tbody></table></div></div>`;
    container.innerHTML = html;
  } catch (err) {
    console.error('Error loading employee master:', err);
    container.innerHTML = `
      <div class="panel" style="border:1px solid #FECACA;background:#FEF2F2;padding:24px;border-radius:12px;margin:20px 0">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px">
          <span style="font-size:22px">⚠️</span>
          <h3 style="margin:0;color:#991B1B">Failed to Load Employee Master</h3>
        </div>
        <p style="color:#7F1D1D;font-size:13px;margin:0 0 14px 0">
          ${escapeHtml(err.message || 'An error occurred while loading employees.')}
        </p>
        <button class="btn primary sm" onclick="loadTeamMembersView()">↻ Retry</button>
      </div>
    `;
  }
}

function filterEmployeeMasterTable(query) {
  const q = (query || '').toLowerCase().trim();
  const rows = document.querySelectorAll('#teamMembersTableBody tr');
  let matchCount = 0;
  rows.forEach(r => {
    const text = (r.dataset.name || '') + ' ' + (r.dataset.dept || '');
    const match = !q || text.toLowerCase().includes(q);
    r.style.display = match ? '' : 'none';
    if (match) matchCount++;
  });
  const cnt = document.getElementById('empTotalCountLabel');
  if (cnt) {
    cnt.textContent = q ? `Filtered: ${matchCount} of ${allEmployeesMaster.length}` : `Total Employees: ${allEmployeesMaster.length} (${allEmployeesMaster.filter(e => e.active).length} Active)`;
  }
}

async function toggleEmployeeStatus(id, active) {
  try {
    const res = await apiFetch(`/api/employees/${id}/status`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ active: active ? 1 : 0 })
    });
    const lbl = document.getElementById(`empStatusLabel_${id}`);
    if (lbl) {
      lbl.textContent = active ? 'Active' : 'Inactive';
      lbl.style.color = active ? '#15803D' : '#94A3B8';
    }
    const cached = allEmployeesMaster.find(e => e.id === id);
    if (cached) cached.active = active ? 1 : 0;
    showToast(active ? '✓ Employee Activated' : '⏸ Employee Deactivated', `Status updated permanently in database.`);
  } catch (e) {
    showToast('❌ Status Error', 'Failed to update status: ' + (e.message || e));
    loadTeamMembersView();
  }
}

function openAddEmployeeModal() {
  const modal = document.getElementById('employeeModal');
  if (!modal) return;
  document.getElementById('empModalId').value = '';
  document.getElementById('empModalTitle').textContent = '+ Add Employee';
  document.getElementById('empModalSubtitle').textContent = 'Manually add a permanent team member to Master';
  document.getElementById('empModalName').value = '';
  document.getElementById('empModalDept').value = 'CS';
  document.getElementById('empModalActive').value = '1';
  
  const errBox = document.getElementById('empModalError');
  errBox.style.display = 'none';
  errBox.textContent = '';
  
  const submitBtn = document.getElementById('empModalSubmitBtn');
  submitBtn.disabled = false;
  submitBtn.textContent = 'Save Employee';

  modal.style.display = 'flex';
  setTimeout(() => document.getElementById('empModalName').focus(), 50);
}

function openEditEmployeeModal(id) {
  const modal = document.getElementById('employeeModal');
  if (!modal) return;
  const emp = allEmployeesMaster.find(e => e.id === id);
  if (!emp) {
    showToast('❌ Not Found', 'Employee not found in local cache. Refreshing...');
    loadTeamMembersView();
    return;
  }

  document.getElementById('empModalId').value = String(emp.id);
  document.getElementById('empModalTitle').textContent = '✏ Edit Employee';
  document.getElementById('empModalSubtitle').textContent = 'Update employee details (Employee ID remains permanent)';
  document.getElementById('empModalName').value = emp.name;
  
  const deptSelect = document.getElementById('empModalDept');
  let foundDept = false;
  for (let i = 0; i < deptSelect.options.length; i++) {
    if (deptSelect.options[i].value === emp.department) {
      foundDept = true;
      break;
    }
  }
  if (!foundDept && emp.department) {
    const opt = document.createElement('option');
    opt.value = emp.department;
    opt.textContent = emp.department;
    deptSelect.appendChild(opt);
  }
  deptSelect.value = emp.department || 'CS';

  document.getElementById('empModalActive').value = emp.active ? '1' : '0';

  const errBox = document.getElementById('empModalError');
  errBox.style.display = 'none';
  errBox.textContent = '';

  const submitBtn = document.getElementById('empModalSubmitBtn');
  submitBtn.disabled = false;
  submitBtn.textContent = 'Save Changes';

  modal.style.display = 'flex';
  setTimeout(() => document.getElementById('empModalName').focus(), 50);
}

function closeEmployeeModal() {
  const modal = document.getElementById('employeeModal');
  if (modal) modal.style.display = 'none';
}

async function handleEmployeeFormSubmit(e) {
  e.preventDefault();
  const id = document.getElementById('empModalId').value;
  const nameInput = document.getElementById('empModalName').value;
  const name = (nameInput || '').trim();
  const dept = document.getElementById('empModalDept').value;
  const active = parseInt(document.getElementById('empModalActive').value, 10);
  const errBox = document.getElementById('empModalError');
  const submitBtn = document.getElementById('empModalSubmitBtn');

  if (!name) {
    errBox.textContent = 'Employee name is required.';
    errBox.style.display = 'block';
    return;
  }

  // Client-side normalized duplicate check
  const norm = name.replace(/\s+/g, ' ').toLowerCase();
  const dup = allEmployeesMaster.find(emp => 
    emp.name.trim().replace(/\s+/g, ' ').toLowerCase() === norm && (!id || String(emp.id) !== String(id))
  );
  if (dup) {
    errBox.textContent = `Employee "${dup.name}" already exists.`;
    errBox.style.display = 'block';
    return;
  }

  errBox.style.display = 'none';
  submitBtn.disabled = true;
  submitBtn.textContent = 'Saving...';

  try {
    let res;
    if (id) {
      res = await apiFetch(`/api/employees/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, department: dept, active })
      });
      showToast('✓ Employee Updated', `${res.employee?.name || name} updated successfully.`);
    } else {
      res = await apiFetch('/api/employees', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, department: dept, active })
      });
      showToast('✓ Employee Added', `${res.employee?.name || name} added to Employee Master.`);
    }
    closeEmployeeModal();
    await loadTeamMembersView();
  } catch (err) {
    errBox.textContent = err.message || 'Failed to save employee.';
    errBox.style.display = 'block';
  } finally {
    submitBtn.disabled = false;
    submitBtn.textContent = id ? 'Save Changes' : 'Save Employee';
  }
}

// -------------------------------------------------------------
// 1. TEAM SETUP VIEW (Permanent New / Pending Membership)
// -------------------------------------------------------------
let teamSetupMembers = [];

async function loadTeamSetupView() {
  const container = document.getElementById('teamSetupContainer');
  if (!container) return;

  try {
    const [employees, memberships] = await Promise.all([
      apiFetch('/api/employees').catch(() => []),
      apiFetch('/api/team-membership').catch(() => [])
    ]);

    const memMap = new Map();
    if (Array.isArray(memberships)) {
      for (const m of memberships) {
        memMap.set(m.id, m.team_membership || 'Neither');
      }
    }

    teamSetupMembers = (Array.isArray(employees) ? employees : []).map(e => ({
      ...e,
      team_membership: memMap.get(e.id) || e.team_membership || 'Neither'
    }));

    renderTeamSetupUI();
  } catch (err) {
    console.error('Error loading team setup:', err);
    container.innerHTML = `
      <div class="panel" style="text-align:center;padding:40px 20px">
        <div style="font-size:36px;margin-bottom:12px">⚠️</div>
        <h3 style="margin:0 0 8px 0;color:var(--ink)">Failed to load Team Setup</h3>
        <p style="color:var(--mut);font-size:13px">${escapeHtml(err.message || 'Unknown error')}</p>
        <button class="btn primary" onclick="loadTeamSetupView()">↻ Retry</button>
      </div>
    `;
  }
}

function renderTeamSetupUI() {
  const container = document.getElementById('teamSetupContainer');
  if (!container) return;

  const csOnly = teamSetupMembers.filter(e => e.department === 'CS' || isCSName(e.name));
  const newCount = csOnly.filter(e => e.team_membership === 'New' || e.team_membership === 'Both').length;
  const pendingCount = csOnly.filter(e => e.team_membership === 'Pending' || e.team_membership === 'Both').length;
  const bothCount = csOnly.filter(e => e.team_membership === 'Both').length;
  const neitherCount = csOnly.filter(e => !e.team_membership || e.team_membership === 'Neither').length;

  let html = `
    <!-- Top Explanatory Banner -->
    <div style="background:linear-gradient(135deg, #1E3A8A, #2563EB);color:#fff;border-radius:14px;padding:16px 20px;margin-bottom:20px;display:flex;align-items:center;gap:16px;box-shadow:var(--shadow)">
      <div style="font-size:32px">⚙️</div>
      <div style="flex:1">
        <b style="font-size:15px;display:block;margin-bottom:3px">Permanent Team Setup (New & Pending Membership)</b>
        <p style="font-size:12px;opacity:0.9;margin:0;line-height:1.5">
          Defines permanent eligibility for <b>New Orders</b> vs. <b>Pending Orders</b> across the CS team. 
          This configuration is <b>permanent</b> and strictly separated from <i>Today's Working Team</i> (which controls daily attendance).
        </p>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn success sm" onclick="saveTeamSetupBulk()" style="background:#16A34A;color:#fff;border-color:#16A34A;font-weight:700">💾 Save All Changes</button>
      </div>
    </div>

    <!-- KPI Summary Cards -->
    <div class="kpis" style="margin-bottom:20px">
      ${kpiCard('👥', csOnly.length, 'Total CS Team', 'Permanent CS employees in Master', NAVY)}
      ${kpiCard('📦', newCount, 'New Orders Team', 'Eligible for New order allocation', BLUE)}
      ${kpiCard('⏳', pendingCount, 'Pending Orders Team', 'Eligible for Pending queue allocation', PURPLE)}
      ${kpiCard('🔄', bothCount, 'Both Teams (Flex)', 'Eligible for New + Pending', GREEN)}
    </div>

    <!-- Fast Action Tools -->
    <div class="panel" style="margin-bottom:20px;padding:14px 20px">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
        <div class="search" style="max-width:300px;min-width:220px">
          <span class="si">🔍</span>
          <input type="text" id="teamSetupSearch" placeholder="Filter CS employee..." oninput="filterTeamSetupTable(this.value)">
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button class="btn sm" onclick="setAllTeamMembership('New')">Set All to New</button>
          <button class="btn sm" onclick="setAllTeamMembership('Pending')">Set All to Pending</button>
          <button class="btn sm" onclick="setAllTeamMembership('Both')">Set All to Both</button>
          <button class="btn sm" onclick="setAllTeamMembership('Neither')">Clear All</button>
          <button class="btn primary sm" onclick="saveTeamSetupBulk()">💾 Save Changes</button>
        </div>
      </div>
    </div>

    <!-- Team Setup Table -->
    <div class="panel">
      <div class="hd">
        <div>
          <h3>👥 CS Team Membership Configuration</h3>
          <p>Toggle New and Pending flags for each agent. Click Save Changes when done.</p>
        </div>
      </div>
      <div class="tbl-scroll">
        <table id="teamSetupTable">
          <thead>
            <tr>
              <th style="width:60px">#</th>
              <th>Employee Name</th>
              <th>Department</th>
              <th>Status</th>
              <th style="text-align:center">New Orders Team</th>
              <th style="text-align:center">Pending Orders Team</th>
              <th>Current Assignment</th>
              <th style="text-align:right">Quick Actions</th>
            </tr>
          </thead>
          <tbody>
            ${csOnly.map((e, idx) => {
              const isNew = e.team_membership === 'New' || e.team_membership === 'Both';
              const isPending = e.team_membership === 'Pending' || e.team_membership === 'Both';
              return `
                <tr data-emp="${e.name.toLowerCase()}">
                  <td><span class="rk">${idx + 1}</span></td>
                  <td class="nm-cell">
                    <div style="display:flex;align-items:center;gap:8px">
                      <div class="av" style="width:28px;height:28px;font-size:11px">${initials(e.name)}</div>
                      <b>${escapeHtml(e.name)}</b>
                    </div>
                  </td>
                  <td>${escapeHtml(e.department || 'CS')}</td>
                  <td>${e.active ? '<span class="tag" style="background:#DCFCE7;color:#15803D">Active</span>' : '<span class="tag" style="background:#F1F5F9;color:#64748B">Inactive</span>'}</td>
                  <td style="text-align:center">
                    <input type="checkbox" id="chk-new-${e.id}" ${isNew ? 'checked' : ''} onchange="onTeamSetupCheckboxChanged(${e.id})" style="width:17px;height:17px;cursor:pointer;accent-color:var(--blue)">
                  </td>
                  <td style="text-align:center">
                    <input type="checkbox" id="chk-pending-${e.id}" ${isPending ? 'checked' : ''} onchange="onTeamSetupCheckboxChanged(${e.id})" style="width:17px;height:17px;cursor:pointer;accent-color:var(--purple)">
                  </td>
                  <td id="membership-badge-${e.id}">
                    ${renderMembershipTag(e.team_membership)}
                  </td>
                  <td style="text-align:right">
                    <div style="display:inline-flex;gap:4px">
                      <button class="btn sm" style="padding:2px 7px;font-size:10.5px" onclick="setSingleEmployeeMembership(${e.id}, 'New')">New</button>
                      <button class="btn sm" style="padding:2px 7px;font-size:10.5px" onclick="setSingleEmployeeMembership(${e.id}, 'Pending')">Pending</button>
                      <button class="btn sm" style="padding:2px 7px;font-size:10.5px" onclick="setSingleEmployeeMembership(${e.id}, 'Both')">Both</button>
                    </div>
                  </td>
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
      </div>
    </div>
  `;

  container.innerHTML = html;
}

function renderMembershipTag(membership) {
  if (membership === 'New') {
    return '<span class="tag" style="background:#DBEAFE;color:#1D4ED8;font-weight:700">📦 New Team</span>';
  } else if (membership === 'Pending') {
    return '<span class="tag" style="background:#F3E8FF;color:#7C3AED;font-weight:700">⏳ Pending Team</span>';
  } else if (membership === 'Both') {
    return '<span class="tag" style="background:#DCFCE7;color:#15803D;font-weight:700">🔄 Both (Flex)</span>';
  } else {
    return '<span class="tag" style="background:#F1F5F9;color:#64748B">Unassigned</span>';
  }
}

function onTeamSetupCheckboxChanged(empId) {
  const isNew = document.getElementById(`chk-new-${empId}`)?.checked;
  const isPending = document.getElementById(`chk-pending-${empId}`)?.checked;
  let val = 'Neither';
  if (isNew && isPending) val = 'Both';
  else if (isNew) val = 'New';
  else if (isPending) val = 'Pending';

  const emp = teamSetupMembers.find(e => e.id === empId);
  if (emp) emp.team_membership = val;

  const badgeCell = document.getElementById(`membership-badge-${empId}`);
  if (badgeCell) badgeCell.innerHTML = renderMembershipTag(val);
}

function setSingleEmployeeMembership(empId, val) {
  const emp = teamSetupMembers.find(e => e.id === empId);
  if (emp) emp.team_membership = val;

  const chkNew = document.getElementById(`chk-new-${empId}`);
  const chkPending = document.getElementById(`chk-pending-${empId}`);
  if (chkNew) chkNew.checked = (val === 'New' || val === 'Both');
  if (chkPending) chkPending.checked = (val === 'Pending' || val === 'Both');

  const badgeCell = document.getElementById(`membership-badge-${empId}`);
  if (badgeCell) badgeCell.innerHTML = renderMembershipTag(val);
}

function setAllTeamMembership(val) {
  teamSetupMembers.forEach(e => {
    if (e.department === 'CS' || isCSName(e.name)) {
      e.team_membership = val;
      const chkNew = document.getElementById(`chk-new-${e.id}`);
      const chkPending = document.getElementById(`chk-pending-${e.id}`);
      if (chkNew) chkNew.checked = (val === 'New' || val === 'Both');
      if (chkPending) chkPending.checked = (val === 'Pending' || val === 'Both');
      const badgeCell = document.getElementById(`membership-badge-${e.id}`);
      if (badgeCell) badgeCell.innerHTML = renderMembershipTag(val);
    }
  });
}

function filterTeamSetupTable(query) {
  const q = String(query || '').trim().toLowerCase();
  const rows = document.querySelectorAll('#teamSetupTable tbody tr[data-emp]');
  rows.forEach(r => {
    const emp = r.getAttribute('data-emp') || '';
    r.style.display = emp.includes(q) ? '' : 'none';
  });
}

async function saveTeamSetupBulk() {
  const updates = teamSetupMembers
    .filter(e => e.department === 'CS' || isCSName(e.name))
    .map(e => ({
      id: e.id,
      team_membership: e.team_membership || 'Neither'
    }));

  try {
    const res = await apiFetch('/api/team-membership/bulk', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ updates })
    });

    if (res.success) {
      showToast('✓ Team Setup Saved', `Updated permanent team membership for ${updates.length} CS agents.`);
    } else {
      alert('Failed to save team setup: ' + (res.error || 'Unknown error'));
    }
  } catch (err) {
    alert('Failed to save team setup: ' + err.message);
  }
}

// -------------------------------------------------------------
// 2. ACCOUNT CONFIGURATION VIEW (Part 3B)
// -------------------------------------------------------------
let allAccountRules = [];
let allAccountExceptions = [];
let allKnownAccounts = [];
let currentAccountConfigFilter = '';

async function loadAccountConfigView() {
  const container = document.getElementById('accountConfigContainer');
  if (!container) return;

  try {
    const [rules, exceptions, employees, knownAccounts] = await Promise.all([
      apiFetch('/api/account-rules').catch(() => []),
      apiFetch('/api/account-exceptions').catch(() => []),
      apiFetch('/api/employees').catch(() => []),
      apiFetch('/api/accounts/all').catch(() => [])
    ]);

    allAccountRules = Array.isArray(rules) ? rules : [];
    allAccountExceptions = Array.isArray(exceptions) ? exceptions : [];
    allEmployeesMaster = Array.isArray(employees) ? employees : [];
    allKnownAccounts = Array.isArray(knownAccounts) ? knownAccounts : [];

    renderAccountConfigUI();
  } catch (err) {
    console.error('Error loading account configuration:', err);
    container.innerHTML = `
      <div class="panel" style="text-align:center;padding:40px 20px">
        <div style="font-size:36px;margin-bottom:12px">⚠️</div>
        <h3 style="margin:0 0 8px 0;color:var(--ink)">Failed to load Account Configuration</h3>
        <p style="color:var(--mut);font-size:13px">${escapeHtml(err.message || 'Unknown error')}</p>
        <button class="btn primary" onclick="loadAccountConfigView()">↻ Retry</button>
      </div>
    `;
  }
}

function renderAccountConfigUI() {
  const container = document.getElementById('accountConfigContainer');
  if (!container) return;

  const empMap = new Map(allEmployeesMaster.map(e => [e.id, e.name]));
  const activeRulesCount = allAccountRules.filter(r => r.active).length;

  let html = `
    <!-- Top Explanatory Banner -->
    <div style="background:linear-gradient(135deg, #1E3A8A, #1D4ED8);color:#fff;border-radius:14px;padding:16px 20px;margin-bottom:20px;display:flex;align-items:center;gap:16px;box-shadow:var(--shadow)">
      <div style="font-size:32px">⚡</div>
      <div style="flex:1">
        <b style="font-size:15px;display:block;margin-bottom:3px">Account-Specific Eligibility Rules & Date Exceptions</b>
        <p style="font-size:12px;opacity:0.9;margin:0;line-height:1.5">
          Configure which agents are permitted or blocked for each specific account. 
          <b>Deterministic Rule Hierarchy:</b> Active Master &rarr; Daily Working Team &rarr; Team Membership (New/Pending) &rarr; Date Exceptions &rarr; Account Config &rarr; <b>Blocked Always Wins</b>.
        </p>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn success sm" onclick="openAccountRuleModal()" style="background:#16A34A;color:#fff;border-color:#16A34A;font-weight:700">+ Add Account Rule</button>
        <button class="btn amber sm" onclick="openAccountExceptionModal()" style="background:#F59E0B;color:#fff;border-color:#F59E0B;font-weight:700">+ Add Date Exception</button>
      </div>
    </div>

    <!-- KPI Summary Cards -->
    <div class="kpis" style="margin-bottom:20px">
      ${kpiCard('⚡', allAccountRules.length, 'Account Rules', `${activeRulesCount} active rules configured`, NAVY)}
      ${kpiCard('🚫', allAccountRules.reduce((s, r) => s + (r.blocked || []).length, 0), 'Blocked Restrictions', 'Explicit agent blocks enforced', RED)}
      ${kpiCard('📅', allAccountExceptions.length, 'Date Exceptions', 'Temporary overrides active', AMBER)}
      ${kpiCard('👥', allEmployeesMaster.filter(e => e.active).length, 'Master Employees', 'Active agents in system', GREEN)}
    </div>

    <!-- Section 1: Permanent Account Rules -->
    <div class="panel" style="margin-bottom:24px">
      <div class="hd">
        <div>
          <h3>⚡ Permanent Account Rules (${allAccountRules.length})</h3>
          <p>Defines which agents are allowed or blocked for New vs Pending queues per account.</p>
        </div>
        <div style="display:flex;gap:10px;align-items:center">
          <div class="search" style="max-width:260px">
            <span class="si">🔍</span>
            <input type="text" placeholder="Filter account..." oninput="filterAccountRulesTable(this.value)">
          </div>
          <button class="btn primary sm" onclick="openAccountRuleModal()">+ New Rule</button>
        </div>
      </div>

      <div class="tbl-scroll">
        <table id="accountRulesTable">
          <thead>
            <tr>
              <th style="width:50px">#</th>
              <th>Account Name</th>
              <th>Status</th>
              <th>New Eligible Agents</th>
              <th>Pending Eligible Agents</th>
              <th>Blocked Agents</th>
              <th>Notes</th>
              <th style="text-align:right">Actions</th>
            </tr>
          </thead>
          <tbody>
            ${allAccountRules.length === 0 ? `
              <tr>
                <td colspan="8" style="text-align:center;padding:36px;color:var(--mut)">
                  No permanent account rules configured yet. Standard team membership applies.
                </td>
              </tr>
            ` : allAccountRules.map((r, idx) => {
              const newNames = (r.new_eligible || []).map(id => typeof id === 'number' ? (empMap.get(id) || id) : id);
              const penNames = (r.pending_eligible || []).map(id => typeof id === 'number' ? (empMap.get(id) || id) : id);
              const blkNames = (r.blocked || []).map(id => typeof id === 'number' ? (empMap.get(id) || id) : id);

              return `
                <tr data-acc="${escapeHtml(r.account_name.toLowerCase())}">
                  <td><span class="rk">${idx + 1}</span></td>
                  <td class="nm-cell"><b>${escapeHtml(r.account_name)}</b></td>
                  <td>${r.active ? '<span class="tag" style="background:#DCFCE7;color:#15803D">Active</span>' : '<span class="tag" style="background:#F1F5F9;color:#64748B">Inactive</span>'}</td>
                  <td style="font-size:12px">
                    ${newNames.length === 0 ? '<span style="color:var(--mut)">All New Team</span>' : newNames.map(n => `<span class="tag" style="background:#DBEAFE;color:#1D4ED8;margin-right:4px">${escapeHtml(n)}</span>`).join('')}
                  </td>
                  <td style="font-size:12px">
                    ${penNames.length === 0 ? '<span style="color:var(--mut)">All Pending Team</span>' : penNames.map(n => `<span class="tag" style="background:#F3E8FF;color:#7C3AED;margin-right:4px">${escapeHtml(n)}</span>`).join('')}
                  </td>
                  <td style="font-size:12px">
                    ${blkNames.length === 0 ? '<span style="color:#15803D">None (Clean)</span>' : blkNames.map(n => `<span class="tag" style="background:#FEE2E2;color:#991B1B;margin-right:4px;font-weight:700">🚫 ${escapeHtml(n)}</span>`).join('')}
                  </td>
                  <td style="font-size:11.5px;color:var(--mut)">${escapeHtml(r.notes || '-')}</td>
                  <td style="text-align:right">
                    <div style="display:inline-flex;gap:6px">
                      <button class="btn sm" onclick="editAccountRule(${r.id})">✏ Edit</button>
                      <button class="btn sm" style="color:#DC2626" onclick="deleteAccountRulePrompt(${r.id}, '${escapeHtml(r.account_name)}')">🗑 Delete</button>
                    </div>
                  </td>
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Section 2: Date-Specific Account Exceptions -->
    <div class="panel">
      <div class="hd">
        <div>
          <h3>📅 Date-Specific Account Exceptions (${allAccountExceptions.length})</h3>
          <p>Temporary overrides for specific dates that take priority over permanent account rules.</p>
        </div>
        <button class="btn amber sm" onclick="openAccountExceptionModal()">+ Add Exception</button>
      </div>

      <div class="tbl-scroll">
        <table>
          <thead>
            <tr>
              <th style="width:50px">#</th>
              <th>Target Date</th>
              <th>Account</th>
              <th>Status Type</th>
              <th>Exception Rule</th>
              <th>Target Employee</th>
              <th>Notes</th>
              <th style="text-align:right">Action</th>
            </tr>
          </thead>
          <tbody>
            ${allAccountExceptions.length === 0 ? `
              <tr>
                <td colspan="8" style="text-align:center;padding:36px;color:var(--mut)">
                  No temporary date exceptions active. All allocations follow permanent rules.
                </td>
              </tr>
            ` : allAccountExceptions.map((exc, idx) => {
              const empName = exc.employee_name || empMap.get(exc.employee_id) || `Employee #${exc.employee_id}`;
              const isBlock = exc.exception_type === 'block' || exc.action_type === 'block';

              return `
                <tr>
                  <td><span class="rk">${idx + 1}</span></td>
                  <td><b>${exc.work_date ? formatDisplayDate(exc.work_date) : '<span class="tag" style="background:#EFF6FF;color:#1D4ED8">All Dates</span>'}</b></td>
                  <td class="nm-cell"><b>${escapeHtml(exc.account_name || exc.account)}</b></td>
                  <td><span class="tag" style="background:#F1F5F9;color:#334155">${escapeHtml(exc.status_type || 'Both')}</span></td>
                  <td>
                    ${isBlock
                      ? '<span class="tag" style="background:#FEE2E2;color:#991B1B;font-weight:700">🚫 Temporary Block</span>'
                      : '<span class="tag" style="background:#DCFCE7;color:#15803D;font-weight:700">✓ Allow Only</span>'}
                  </td>
                  <td><b>${escapeHtml(empName)}</b></td>
                  <td style="font-size:11.5px;color:var(--mut)">${escapeHtml(exc.notes || '-')}</td>
                  <td style="text-align:right">
                    <button class="btn sm" style="color:#DC2626" onclick="deleteAccountExceptionPrompt(${exc.id})">🗑 Remove</button>
                  </td>
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
      </div>
    </div>
  `;

  container.innerHTML = html;
}

function filterAccountRulesTable(query) {
  const q = String(query || '').trim().toLowerCase();
  const rows = document.querySelectorAll('#accountRulesTable tbody tr[data-acc]');
  rows.forEach(r => {
    const acc = r.getAttribute('data-acc') || '';
    r.style.display = acc.includes(q) ? '' : 'none';
  });
}

async function openAccountRuleModal(rule = null) {
  const modal = document.getElementById('accountRuleModal');
  if (!modal) return;

  // Refresh known accounts if needed
  if (!allKnownAccounts || allKnownAccounts.length === 0) {
    try {
      const accList = await apiFetch('/api/accounts/all').catch(() => []);
      if (Array.isArray(accList)) allKnownAccounts = accList;
    } catch (_) {}
  }

  const titleEl = document.getElementById('accRuleModalTitle');
  const subEl = document.getElementById('accRuleModalSubtitle');
  const idEl = document.getElementById('accRuleModalId');
  const nameEl = document.getElementById('accRuleModalName');
  const selectEl = document.getElementById('accRuleModalAccountSelect');
  const datalistEl = document.getElementById('accRuleModalAccountList');
  const activeEl = document.getElementById('accRuleModalActive');
  const notesEl = document.getElementById('accRuleModalNotes');
  const errBox = document.getElementById('accRuleModalError');
  const noticeBox = document.getElementById('accRuleSavedNotice');

  if (errBox) {
    errBox.style.display = 'none';
    errBox.textContent = '';
  }
  if (noticeBox) {
    noticeBox.style.display = 'none';
    noticeBox.innerHTML = '';
  }

  // Populate Datalist & Select Dropdown with all accounts found across sheets
  if (datalistEl) {
    datalistEl.innerHTML = allKnownAccounts.map(a => `<option value="${escapeHtml(a)}"></option>`).join('');
  }
  if (selectEl) {
    const options = [
      `<option value="">-- Choose Account from Uploaded Sheets (${allKnownAccounts.length} accounts found) --</option>`
    ];
    for (const acc of allKnownAccounts) {
      const hasRule = allAccountRules.some(r => r.account_name && r.account_name.toLowerCase() === acc.toLowerCase());
      options.push(`<option value="${escapeHtml(acc)}">${escapeHtml(acc)}${hasRule ? ' (⚙ Saved Rule)' : ''}</option>`);
    }
    selectEl.innerHTML = options.join('');
  }

  const isEdit = !!rule;
  idEl.value = isEdit ? String(rule.id) : '';
  titleEl.textContent = isEdit ? '✏ Edit Account Rule' : '+ Add Account Rule';
  subEl.textContent = isEdit ? `Configure eligibility for ${rule.account_name}` : 'Select or type an account from sheets to configure and save permanently';
  nameEl.value = isEdit ? rule.account_name : '';
  if (selectEl) {
    selectEl.value = isEdit ? rule.account_name : '';
  }
  activeEl.checked = isEdit ? !!rule.active : true;
  notesEl.value = isEdit ? (rule.notes || '') : '';

  // Populate employee checkboxes
  const csEmps = allEmployeesMaster.filter(e => e.department === 'CS' || isCSName(e.name));

  const newEligSet = new Set(isEdit ? (rule.new_eligible || []) : []);
  const penEligSet = new Set(isEdit ? (rule.pending_eligible || []) : []);
  const blkSet = new Set(isEdit ? (rule.blocked || []) : []);

  const buildCheckboxList = (prefix, selectedSet) => {
    return csEmps.map(e => {
      const isChecked = selectedSet.has(e.id) || selectedSet.has(e.name);
      return `
        <label style="display:flex;align-items:center;gap:6px;font-size:12px;cursor:pointer;padding:4px 6px;border-radius:6px;background:#F8FAFC">
          <input type="checkbox" name="${prefix}" value="${e.id}" ${isChecked ? 'checked' : ''} style="width:14px;height:14px;accent-color:var(--blue)">
          <span style="white-space:nowrap">${escapeHtml(e.name)}</span>
        </label>
      `;
    }).join('');
  };

  document.getElementById('accRuleNewEligContainer').innerHTML = buildCheckboxList('new_eligible', newEligSet);
  document.getElementById('accRulePenEligContainer').innerHTML = buildCheckboxList('pending_eligible', penEligSet);
  document.getElementById('accRuleBlockedContainer').innerHTML = buildCheckboxList('blocked', blkSet);

  if (isEdit && noticeBox) {
    noticeBox.style.display = 'block';
    noticeBox.innerHTML = `<span style="color:#15803D;background:#DCFCE7;padding:5px 10px;border-radius:6px;font-weight:700;display:inline-flex;align-items:center;gap:5px;font-size:12px">✓ Saved configuration loaded for "${escapeHtml(rule.account_name)}". Edits will update the permanent database.</span>`;
  }

  modal.style.display = 'flex';
}

function onAccountRuleModalAccountChange(accountName) {
  const cleanName = String(accountName || '').trim();
  const nameEl = document.getElementById('accRuleModalName');
  const selectEl = document.getElementById('accRuleModalAccountSelect');
  const idEl = document.getElementById('accRuleModalId');
  const activeEl = document.getElementById('accRuleModalActive');
  const notesEl = document.getElementById('accRuleModalNotes');
  const noticeBox = document.getElementById('accRuleSavedNotice');

  if (nameEl && nameEl.value !== cleanName) {
    nameEl.value = cleanName;
  }
  if (selectEl && selectEl.value !== cleanName) {
    selectEl.value = cleanName;
  }

  if (!cleanName) {
    if (noticeBox) noticeBox.style.display = 'none';
    return;
  }

  // Check if we have an existing rule for this account
  const existingRule = allAccountRules.find(r => r.account_name && r.account_name.toLowerCase() === cleanName.toLowerCase());

  if (existingRule) {
    idEl.value = String(existingRule.id || '');
    activeEl.checked = !!existingRule.active;
    notesEl.value = existingRule.notes || '';

    const newEligSet = new Set(existingRule.new_eligible || []);
    const penEligSet = new Set(existingRule.pending_eligible || []);
    const blkSet = new Set(existingRule.blocked || []);

    document.querySelectorAll('input[name="new_eligible"]').forEach(cb => {
      const val = parseInt(cb.value, 10);
      cb.checked = newEligSet.has(val) || newEligSet.has(cb.nextElementSibling?.textContent?.trim());
    });
    document.querySelectorAll('input[name="pending_eligible"]').forEach(cb => {
      const val = parseInt(cb.value, 10);
      cb.checked = penEligSet.has(val) || penEligSet.has(cb.nextElementSibling?.textContent?.trim());
    });
    document.querySelectorAll('input[name="blocked"]').forEach(cb => {
      const val = parseInt(cb.value, 10);
      cb.checked = blkSet.has(val) || blkSet.has(cb.nextElementSibling?.textContent?.trim());
    });

    if (noticeBox) {
      noticeBox.style.display = 'block';
      noticeBox.innerHTML = `<span style="color:#15803D;background:#DCFCE7;padding:5px 10px;border-radius:6px;font-weight:700;display:inline-flex;align-items:center;gap:5px;font-size:12px">✓ Saved configuration loaded (${(existingRule.new_eligible||[]).length} New, ${(existingRule.pending_eligible||[]).length} Pending, ${(existingRule.blocked||[]).length} Blocked). Changes will update permanently.</span>`;
    }
  } else {
    // New account from sheets without saved rules
    idEl.value = '';
    activeEl.checked = true;
    notesEl.value = '';

    document.querySelectorAll('input[name="new_eligible"]').forEach(cb => { cb.checked = false; });
    document.querySelectorAll('input[name="pending_eligible"]').forEach(cb => { cb.checked = false; });
    document.querySelectorAll('input[name="blocked"]').forEach(cb => { cb.checked = false; });

    if (noticeBox) {
      noticeBox.style.display = 'block';
      noticeBox.innerHTML = `<span style="color:#1D4ED8;background:#EFF6FF;padding:5px 10px;border-radius:6px;font-weight:600;display:inline-flex;align-items:center;gap:5px;font-size:12px">✦ New Account detected — Configure allowed / blocked agents below and click Save. The system will remember these rules whenever this account appears in any sheet!</span>`;
    }
  }
}

function editAccountRule(ruleId) {
  const rule = allAccountRules.find(r => r.id === ruleId);
  if (rule) {
    openAccountRuleModal(rule);
  }
}

function closeAccountRuleModal() {
  const modal = document.getElementById('accountRuleModal');
  if (modal) modal.style.display = 'none';
}

async function handleAccountRuleSubmit(e) {
  e.preventDefault();
  const id = document.getElementById('accRuleModalId').value;
  const account_name = document.getElementById('accRuleModalName').value.trim();
  const active = document.getElementById('accRuleModalActive').checked ? 1 : 0;
  const notes = document.getElementById('accRuleModalNotes').value.trim();
  const errBox = document.getElementById('accRuleModalError');
  const submitBtn = document.getElementById('accRuleModalSubmitBtn');

  if (!account_name) {
    errBox.textContent = 'Account name is required.';
    errBox.style.display = 'block';
    return;
  }

  const getCheckedValues = (name) => {
    const checkboxes = document.querySelectorAll(`input[name="${name}"]:checked`);
    return Array.from(checkboxes).map(c => parseInt(c.value, 10));
  };

  const new_eligible = getCheckedValues('new_eligible');
  const pending_eligible = getCheckedValues('pending_eligible');
  const blocked = getCheckedValues('blocked');

  submitBtn.disabled = true;
  submitBtn.textContent = 'Saving...';
  errBox.style.display = 'none';

  try {
    const payload = {
      account_name,
      new_eligible,
      pending_eligible,
      blocked,
      active,
      notes
    };
    if (id) payload.id = parseInt(id, 10);

    const res = await apiFetch('/api/account-rules', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    if (res.success) {
      showToast('✓ Account Rule Saved Permanently', `Rules for "${account_name}" saved to database. They will automatically apply whenever this account appears in sheets!`);
      closeAccountRuleModal();
      await loadAccountConfigView();
    } else {
      errBox.textContent = res.error || 'Failed to save account rule.';
      errBox.style.display = 'block';
    }
  } catch (err) {
    errBox.textContent = err.message || 'Failed to save account rule.';
    errBox.style.display = 'block';
  } finally {
    submitBtn.disabled = false;
    submitBtn.textContent = 'Save Account Rule';
  }
}

async function deleteAccountRulePrompt(id, name) {
  if (!confirm(`Are you sure you want to delete the rule for "${name}"?`)) return;
  try {
    const res = await apiFetch(`/api/account-rules/${id}`, { method: 'DELETE' });
    if (res.success) {
      showToast('🗑 Rule Deleted', `Rule for "${name}" was removed.`);
      await loadAccountConfigView();
    } else {
      alert('Delete failed: ' + (res.error || 'Unknown error'));
    }
  } catch (err) {
    alert('Delete failed: ' + err.message);
  }
}

function openAccountExceptionModal() {
  const modal = document.getElementById('accountExceptionModal');
  if (!modal) return;

  document.getElementById('accExcModalAccount').value = '';
  document.getElementById('accExcModalDate').value = currentWorkDate;
  document.getElementById('accExcModalStatus').value = 'Both';
  document.getElementById('accExcModalType').value = 'allow_only';
  document.getElementById('accExcModalNotes').value = '';

  const empSelect = document.getElementById('accExcModalEmp');
  const csEmps = allEmployeesMaster.filter(e => e.department === 'CS' || isCSName(e.name));
  empSelect.innerHTML = csEmps.map(e => `<option value="${e.id}">${escapeHtml(e.name)}</option>`).join('');

  const errBox = document.getElementById('accExcModalError');
  errBox.style.display = 'none';
  errBox.textContent = '';

  modal.style.display = 'flex';
}

function closeAccountExceptionModal() {
  const modal = document.getElementById('accountExceptionModal');
  if (modal) modal.style.display = 'none';
}

async function handleAccountExceptionSubmit(e) {
  e.preventDefault();
  const account_name = document.getElementById('accExcModalAccount').value.trim();
  const work_date = document.getElementById('accExcModalDate').value || null;
  const status_type = document.getElementById('accExcModalStatus').value;
  const exception_type = document.getElementById('accExcModalType').value;
  const employee_id = parseInt(document.getElementById('accExcModalEmp').value, 10);
  const notes = document.getElementById('accExcModalNotes').value.trim();
  const errBox = document.getElementById('accExcModalError');
  const submitBtn = document.getElementById('accExcModalSubmitBtn');

  if (!account_name) {
    errBox.textContent = 'Account name is required.';
    errBox.style.display = 'block';
    return;
  }
  if (!employee_id) {
    errBox.textContent = 'Employee selection is required.';
    errBox.style.display = 'block';
    return;
  }

  submitBtn.disabled = true;
  submitBtn.textContent = 'Saving...';
  errBox.style.display = 'none';

  try {
    const res = await apiFetch('/api/account-exceptions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        account_name,
        work_date,
        status_type,
        exception_type,
        employee_id,
        notes
      })
    });

    if (res.success) {
      showToast('✓ Exception Created', `Exception for "${account_name}" saved.`);
      closeAccountExceptionModal();
      await loadAccountConfigView();
    } else {
      errBox.textContent = res.error || 'Failed to save exception.';
      errBox.style.display = 'block';
    }
  } catch (err) {
    errBox.textContent = err.message || 'Failed to save exception.';
    errBox.style.display = 'block';
  } finally {
    submitBtn.disabled = false;
    submitBtn.textContent = 'Save Exception';
  }
}

async function deleteAccountExceptionPrompt(id) {
  if (!confirm('Are you sure you want to remove this exception?')) return;
  try {
    const res = await apiFetch(`/api/account-exceptions/${id}`, { method: 'DELETE' });
    if (res.success) {
      showToast('🗑 Exception Removed', 'Account exception deleted.');
      await loadAccountConfigView();
    } else {
      alert('Delete failed: ' + (res.error || 'Unknown error'));
    }
  } catch (err) {
    alert('Delete failed: ' + err.message);
  }
}

// -------------------------------------------------------------
// 3. ACCOUNTS DIRECTORY VIEW (Date-Aware Reporting & Audit)
// -------------------------------------------------------------
let currentAccountsDirectory = [];
let accDirectoryViewMode = 'grid'; // 'grid' | 'table'
let currentAccDetailData = null;
let currentAccDetailTab = 'overview';

async function loadAccountsDirectoryView() {
  const container = document.getElementById('accountsDirectoryContainer');
  if (!container) return;

  try {
    const data = await apiFetch(`/api/accounts/directory/${currentWorkDate}`);
    currentAccountsDirectory = Array.isArray(data?.accounts) ? data.accounts : [];
    renderAccountsDirectoryUI(data);
  } catch (err) {
    console.error('Error loading accounts directory:', err);
    container.innerHTML = `
      <div class="panel" style="text-align:center;padding:40px 20px">
        <div style="font-size:36px;margin-bottom:12px">⚠️</div>
        <h3 style="margin:0 0 8px 0;color:var(--ink)">Failed to load Accounts Directory</h3>
        <p style="color:var(--mut);font-size:13px">${escapeHtml(err.message || 'Unknown error')}</p>
        <button class="btn primary" onclick="loadAccountsDirectoryView()">↻ Retry</button>
      </div>
    `;
  }
}

function renderAccountsDirectoryUI(data) {
  const container = document.getElementById('accountsDirectoryContainer');
  if (!container) return;

  const accounts = currentAccountsDirectory;
  const totalOrders = accounts.reduce((s, a) => s + (a.opening_orders?.total || a.opening_orders || 0), 0);
  const totalNew = accounts.reduce((s, a) => s + (a.opening_orders?.new || 0), 0);
  const totalPending = accounts.reduce((s, a) => s + (a.opening_orders?.pending || 0), 0);
  const workedAccounts = accounts.filter(a => (a.unique_orders_worked || a.orders_worked || 0) > 0);
  const unassignedWorkAccounts = accounts.filter(a => a.has_unassigned_work);

  let html = `
    <!-- Top Source & Date Sync Header -->
    <div class="panel" style="margin-bottom:20px;padding:16px 20px">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
        <div>
          <h3 style="margin:0 0 4px 0;font-size:17px;color:var(--navy)">📑 Accounts Directory</h3>
          <p style="margin:0;font-size:12.5px;color:var(--mut)">
            Comprehensive account inventory, assigned vs. actually worked agents, and detailed audit for <b>${formatDisplayDate(currentWorkDate)}</b>.
          </p>
        </div>
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
          <span class="tag" style="background:#DBEAFE;color:#1D4ED8;font-weight:700;font-size:12px">${accounts.length} Accounts</span>
          <span class="tag" style="background:#DCFCE7;color:#15803D;font-weight:700;font-size:12px">${fmt(totalOrders)} Total Orders</span>
        </div>
      </div>
    </div>

    <!-- Top KPI Grid -->
    <div class="kpis" style="margin-bottom:20px">
      ${kpiCard('📑', accounts.length, 'Total Active Accounts', `In opening pool for ${formatDisplayDate(currentWorkDate)}`, NAVY)}
      ${kpiCard('📦', fmt(totalOrders), 'Opening Work Pool', `${fmt(totalNew)} New · ${fmt(totalPending)} Pending`, BLUE)}
      ${kpiCard('✓', workedAccounts.length, 'Worked Accounts', `${accounts.length > 0 ? ((workedAccounts.length / accounts.length) * 100).toFixed(1) : 0}% touched in Daily Log`, GREEN)}
      ${kpiCard('⚠️', unassignedWorkAccounts.length, 'Outside Allocation', 'Accounts touched by unassigned agents', unassignedWorkAccounts.length > 0 ? AMBER : GREEN)}
    </div>

    <!-- Toolbar: Search, Filter, and Toggle -->
    <div class="panel" style="margin-bottom:20px;padding:14px 20px">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
        <div class="search" style="max-width:320px;min-width:240px">
          <span class="si">🔍</span>
          <input type="text" id="accDirSearch" placeholder="Search account name..." oninput="filterAccountsDirectory()">
        </div>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
          <select id="accDirFilter" class="filter" onchange="filterAccountsDirectory()">
            <option value="all">All Accounts (${accounts.length})</option>
            <option value="worked">Worked Accounts (${workedAccounts.length})</option>
            <option value="untouched">Untouched Accounts (${accounts.length - workedAccounts.length})</option>
            <option value="outside">Outside Allocation (${unassignedWorkAccounts.length})</option>
          </select>
          <div style="display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden">
            <button class="gds-btn ${accDirectoryViewMode === 'grid' ? 'active-today' : ''}" style="border:none;border-radius:0" onclick="setAccDirViewMode('grid')">▦ Cards</button>
            <button class="gds-btn ${accDirectoryViewMode === 'table' ? 'active-today' : ''}" style="border:none;border-radius:0" onclick="setAccDirViewMode('table')">▤ Table</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content: Cards or Table -->
    <div id="accDirContent">
      ${accDirectoryViewMode === 'grid' ? renderAccountsGrid(accounts) : renderAccountsTable(accounts)}
    </div>
  `;

  container.innerHTML = html;
}

function renderAccountsGrid(accounts) {
  if (accounts.length === 0) {
    return `
      <div class="panel" style="text-align:center;padding:40px;color:var(--mut)">
        No accounts found for ${formatDisplayDate(currentWorkDate)}. Upload Specific Orders to populate.
      </div>
    `;
  }

  return `
    <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(340px, 1fr));gap:16px" id="accCardsGrid">
      ${accounts.map(acc => {
        const op = acc.opening_orders || {};
        const opTotal = op.total !== undefined ? op.total : (acc.total_orders || 0);
        const opNew = op.new !== undefined ? op.new : 0;
        const opPen = op.pending !== undefined ? op.pending : 0;
        const workedOrders = acc.unique_orders_worked || acc.orders_worked || 0;
        const realActions = acc.real_actions_count || acc.real_actions || 0;
        const assigned = acc.assigned_employees || [];
        const workedEmps = acc.actual_employees || [];
        const hasOutside = acc.has_unassigned_work;

        return `
          <div class="panel acc-card" data-name="${escapeHtml(acc.account_name.toLowerCase())}" data-worked="${workedOrders > 0 ? '1' : '0'}" data-outside="${hasOutside ? '1' : '0'}" style="display:flex;flex-direction:column;justify-content:space-between;transition:box-shadow .2s;border:1px solid ${hasOutside ? '#FDE68A' : 'var(--line)'};background:${hasOutside ? '#FFFDF5' : '#fff'}">
            <div>
              <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;gap:8px">
                <div style="flex:1">
                  <h3 style="margin:0 0 3px 0;font-size:15px;color:var(--navy);word-break:break-word">
                    ${escapeHtml(acc.account_name)}
                  </h3>
                  <span style="font-size:11.5px;color:var(--mut)">
                    ${opTotal} opening orders · ${workedOrders} worked
                  </span>
                </div>
                ${hasOutside ? '<span class="tag" style="background:#FEE2E2;color:#991B1B;font-weight:700">⚠️ Outside Alloc</span>' : (workedOrders > 0 ? '<span class="tag" style="background:#DCFCE7;color:#15803D">✓ Active</span>' : '<span class="tag" style="background:#F1F5F9;color:#64748B">Untouched</span>')}
              </div>

              <!-- Metrics Mini Grid -->
              <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:6px;background:var(--panel2);padding:10px;border-radius:10px;margin-bottom:12px;text-align:center">
                <div>
                  <span style="font-size:10px;color:var(--mut);display:block">New / Pen</span>
                  <b style="font-size:13px;color:var(--ink)">${fmt(opNew)} / ${fmt(opPen)}</b>
                </div>
                <div>
                  <span style="font-size:10px;color:var(--mut);display:block">Worked</span>
                  <b style="font-size:13px;color:#15803D">${fmt(workedOrders)}</b>
                </div>
                <div>
                  <span style="font-size:10px;color:var(--mut);display:block">Actions</span>
                  <b style="font-size:13px;color:var(--blue)">${fmt(realActions)}</b>
                </div>
              </div>

              <!-- Assigned vs Actually Worked -->
              <div style="font-size:12px;margin-bottom:12px;line-height:1.4">
                <div style="margin-bottom:6px">
                  <span style="color:var(--mut);font-weight:600;font-size:11px;text-transform:uppercase">Assigned:</span>
                  ${assigned.length === 0 ? '<span style="color:#94A3B8;margin-left:4px">Unassigned</span>' : assigned.map(n => `<span class="tag" style="background:#EFF6FF;color:#1D4ED8;margin-left:4px">${escapeHtml(n)}</span>`).join('')}
                </div>
                <div>
                  <span style="color:var(--mut);font-weight:600;font-size:11px;text-transform:uppercase">Actually Worked:</span>
                  ${workedEmps.length === 0 ? '<span style="color:#94A3B8;margin-left:4px">None</span>' : workedEmps.map(n => {
                    const isOutside = !assigned.includes(n);
                    return `<span class="tag" style="background:${isOutside ? '#FEE2E2' : '#DCFCE7'};color:${isOutside ? '#991B1B' : '#15803D'};margin-left:4px">${escapeHtml(n)}${isOutside ? ' ⚠️' : ''}</span>`;
                  }).join('')}
                </div>
              </div>
            </div>

            <!-- Card Actions -->
            <div style="display:flex;gap:8px;border-top:1px solid var(--line);padding-top:12px;margin-top:4px">
              <button class="btn sm primary" style="flex:1;justify-content:center" onclick="openAccountDetailModal('${escapeHtml(acc.account_name)}')">🔍 View Audit</button>
              <a class="btn sm" style="justify-content:center" href="/api/accounts/export/${currentWorkDate}/${encodeURIComponent(acc.account_name)}" download title="Download 4-Sheet Excel Workbook">📥 XLSX</a>
            </div>
          </div>
        `;
      }).join('')}
    </div>
  `;
}

function renderAccountsTable(accounts) {
  return `
    <div class="panel">
      <div class="tbl-scroll">
        <table id="accTable">
          <thead>
            <tr>
              <th style="width:50px">#</th>
              <th>Account Name</th>
              <th style="text-align:right">Opening Orders</th>
              <th style="text-align:right">New</th>
              <th style="text-align:right">Pending</th>
              <th style="text-align:right">Worked Today</th>
              <th style="text-align:right">Real Actions</th>
              <th>Assigned CS Agents</th>
              <th>Actually Worked By</th>
              <th style="text-align:right">Audit Actions</th>
            </tr>
          </thead>
          <tbody>
            ${accounts.map((acc, idx) => {
              const op = acc.opening_orders || {};
              const opTotal = op.total !== undefined ? op.total : (acc.total_orders || 0);
              const opNew = op.new !== undefined ? op.new : 0;
              const opPen = op.pending !== undefined ? op.pending : 0;
              const workedOrders = acc.unique_orders_worked || acc.orders_worked || 0;
              const realActions = acc.real_actions_count || acc.real_actions || 0;
              const assigned = acc.assigned_employees || [];
              const workedEmps = acc.actual_employees || [];
              const hasOutside = acc.has_unassigned_work;

              return `
                <tr data-name="${escapeHtml(acc.account_name.toLowerCase())}" data-worked="${workedOrders > 0 ? '1' : '0'}" data-outside="${hasOutside ? '1' : '0'}">
                  <td><span class="rk">${idx + 1}</span></td>
                  <td class="nm-cell">
                    <b>${escapeHtml(acc.account_name)}</b>
                    ${hasOutside ? '<span class="tag" style="background:#FEE2E2;color:#991B1B;font-size:10px;margin-left:6px">⚠️ Outside Alloc</span>' : ''}
                  </td>
                  <td style="text-align:right"><b>${fmt(opTotal)}</b></td>
                  <td style="text-align:right;color:#1D4ED8">${fmt(opNew)}</td>
                  <td style="text-align:right;color:#7C3AED">${fmt(opPen)}</td>
                  <td style="text-align:right;font-weight:700;color:#15803D">${fmt(workedOrders)}</td>
                  <td style="text-align:right">${fmt(realActions)}</td>
                  <td>
                    ${assigned.length === 0 ? '<span style="color:var(--mut)">Unassigned</span>' : assigned.map(n => `<span class="tag" style="background:#EFF6FF;color:#1D4ED8;margin-right:3px">${escapeHtml(n)}</span>`).join('')}
                  </td>
                  <td>
                    ${workedEmps.length === 0 ? '<span style="color:var(--mut)">None</span>' : workedEmps.map(n => {
                      const isOutside = !assigned.includes(n);
                      return `<span class="tag" style="background:${isOutside ? '#FEE2E2' : '#DCFCE7'};color:${isOutside ? '#991B1B' : '#15803D'};margin-right:3px">${escapeHtml(n)}${isOutside ? ' ⚠️' : ''}</span>`;
                    }).join('')}
                  </td>
                  <td style="text-align:right">
                    <div style="display:inline-flex;gap:4px">
                      <button class="btn sm primary" onclick="openAccountDetailModal('${escapeHtml(acc.account_name)}')">🔍 Audit</button>
                      <a class="btn sm" href="/api/accounts/export/${currentWorkDate}/${encodeURIComponent(acc.account_name)}" download>📥 XLSX</a>
                    </div>
                  </td>
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
      </div>
    </div>
  `;
}

function setAccDirViewMode(mode) {
  accDirectoryViewMode = mode;
  renderAccountsDirectoryUI();
}

function filterAccountsDirectory() {
  const q = (document.getElementById('accDirSearch')?.value || '').trim().toLowerCase();
  const filter = document.getElementById('accDirFilter')?.value || 'all';

  const cards = document.querySelectorAll('#accCardsGrid .acc-card');
  const rows = document.querySelectorAll('#accTable tbody tr');

  const checkItem = (name, worked, outside) => {
    const matchesQuery = name.includes(q);
    let matchesFilter = true;
    if (filter === 'worked') matchesFilter = (worked === '1');
    else if (filter === 'untouched') matchesFilter = (worked === '0');
    else if (filter === 'outside') matchesFilter = (outside === '1');
    return matchesQuery && matchesFilter;
  };

  cards.forEach(c => {
    const ok = checkItem(c.dataset.name, c.dataset.worked, c.dataset.outside);
    c.style.display = ok ? 'flex' : 'none';
  });

  rows.forEach(r => {
    const ok = checkItem(r.dataset.name, r.dataset.worked, r.dataset.outside);
    r.style.display = ok ? '' : 'none';
  });
}

// -------------------------------------------------------------
// ACCOUNT DETAILED AUDIT MODAL (4-Sheet In-App Audit)
// -------------------------------------------------------------
async function openAccountDetailModal(accountName) {
  const modal = document.getElementById('accountDetailModal');
  if (!modal) return;

  document.getElementById('accDetailTitle').textContent = `Account: ${accountName}`;
  document.getElementById('accDetailSub').textContent = `Full 4-Sheet reconciliation & audit trail for ${formatDisplayDate(currentWorkDate)}`;
  document.getElementById('accDetailExportLink').href = `/api/accounts/export/${currentWorkDate}/${encodeURIComponent(accountName)}`;
  
  const content = document.getElementById('accDetailContent');
  content.innerHTML = `<div style="text-align:center;padding:50px;color:var(--mut)">Loading account audit details...</div>`;
  modal.style.display = 'flex';

  try {
    currentAccDetailData = await apiFetch(`/api/accounts/details/${currentWorkDate}/${encodeURIComponent(accountName)}`);
    currentAccDetailTab = 'overview';
    renderAccountDetailModalContent();
  } catch (err) {
    content.innerHTML = `
      <div style="text-align:center;padding:40px;color:#991B1B">
        <b>Failed to load account details:</b> ${escapeHtml(err.message || 'Error')}
      </div>
    `;
  }
}

function closeAccountDetailModal() {
  const modal = document.getElementById('accountDetailModal');
  if (modal) modal.style.display = 'none';
}

function setAccountDetailTab(tab) {
  currentAccDetailTab = tab;
  renderAccountDetailModalContent();
}

function renderAccountDetailModalContent() {
  const content = document.getElementById('accDetailContent');
  if (!content || !currentAccDetailData) return;

  const d = currentAccDetailData;
  const m = d.metrics || {};
  const elig = d.eligibility || {};
  const orders = d.orders || [];
  const empAct = d.employee_activity || [];
  const timeline = d.timeline || [];

  // Tab navigation bar
  let navHtml = `
    <div style="display:flex;gap:8px;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:16px;flex-wrap:wrap">
      <button class="gds-btn ${currentAccDetailTab === 'overview' ? 'active-today' : ''}" onclick="setAccountDetailTab('overview')">📊 Overview & Eligibility</button>
      <button class="gds-btn ${currentAccDetailTab === 'orders' ? 'active-today' : ''}" onclick="setAccountDetailTab('orders')">📦 Orders List (${orders.length})</button>
      <button class="gds-btn ${currentAccDetailTab === 'employees' ? 'active-today' : ''}" onclick="setAccountDetailTab('employees')">👥 Employee Activity (${empAct.length})</button>
      <button class="gds-btn ${currentAccDetailTab === 'timeline' ? 'active-today' : ''}" onclick="setAccountDetailTab('timeline')">⏱ Timeline Events (${timeline.length})</button>
    </div>
  `;

  let tabBody = '';

  if (currentAccDetailTab === 'overview') {
    tabBody = `
      <!-- Top Overview Metrics -->
      <div class="kpis" style="margin-bottom:16px">
        ${kpiCard('📦', fmt(m.total_orders), 'Opening Orders', `${fmt(m.new_orders)} New · ${fmt(m.pending_orders)} Pending`, NAVY)}
        ${kpiCard('✓', fmt(m.unique_orders_worked), 'Worked Today', `${fmt(m.real_actions)} deduplicated actions`, GREEN)}
        ${kpiCard('🖨', fmt(m.printed_orders), 'Printed Orders', `${fmt(m.pending_status_orders)} pending · ${fmt(m.cancelled_orders)} cancelled`, BLUE)}
        ${kpiCard('⚠️', d.outside_employees.length, 'Outside Allocation', d.outside_employees.length > 0 ? d.outside_employees.join(', ') : 'Clean', d.outside_employees.length > 0 ? RED : GREEN)}
      </div>

      <!-- Eligibility Engine Audit Breakdown -->
      <div class="panel" style="background:#F8FAFC;border:1px solid var(--line);margin-bottom:16px">
        <h4 style="margin:0 0 10px 0;font-size:14px;color:var(--navy)">⚡ Deterministic Eligibility Engine Audit</h4>
        <div style="display:grid;grid-template-columns:repeat(2, 1fr);gap:14px;font-size:12.5px">
          <div>
            <span style="color:var(--mut);display:block;margin-bottom:4px;font-weight:600">Configured New Eligible (Permanent):</span>
            <b>${elig.configured_new_eligible && elig.configured_new_eligible.length > 0 ? elig.configured_new_eligible.join(', ') : 'All New Team Members'}</b>
          </div>
          <div>
            <span style="color:var(--mut);display:block;margin-bottom:4px;font-weight:600">Configured Pending Eligible (Permanent):</span>
            <b>${elig.configured_pending_eligible && elig.configured_pending_eligible.length > 0 ? elig.configured_pending_eligible.join(', ') : 'All Pending Team Members'}</b>
          </div>
          <div>
            <span style="color:var(--mut);display:block;margin-bottom:4px;font-weight:600">Blocked Agents (Blocked Always Wins):</span>
            <b style="color:${(elig.blocked_employees || []).length > 0 ? '#991B1B' : '#15803D'}">
              ${(elig.blocked_employees || []).length > 0 ? elig.blocked_employees.join(', ') : 'None (No Blocks Active)'}
            </b>
          </div>
          <div>
            <span style="color:var(--mut);display:block;margin-bottom:4px;font-weight:600">Working Today CS Agents:</span>
            <b>${elig.working_cs_count || 0} Agents Active on ${formatDisplayDate(currentWorkDate)}</b>
          </div>
          <div style="background:#EFF6FF;padding:10px;border-radius:8px">
            <span style="color:#1D4ED8;display:block;font-weight:700;font-size:11.5px">Final Eligible for New Today:</span>
            <b style="color:#1E3A8A;font-size:13px">${(elig.final_eligible_new_today || []).join(', ') || 'None Available'}</b>
          </div>
          <div style="background:#F3E8FF;padding:10px;border-radius:8px">
            <span style="color:#7C3AED;display:block;font-weight:700;font-size:11.5px">Final Eligible for Pending Today:</span>
            <b style="color:#5B21B6;font-size:13px">${(elig.final_eligible_pending_today || []).join(', ') || 'None Available'}</b>
          </div>
        </div>
      </div>
    `;
  } else if (currentAccDetailTab === 'orders') {
    tabBody = `
      <div class="search" style="margin-bottom:12px;max-width:320px">
        <span class="si">🔍</span>
        <input type="text" placeholder="Filter order code or agent..." oninput="filterAccDetailOrders(this.value)">
      </div>
      <div class="tbl-scroll" style="max-height:460px;overflow-y:auto">
        <table id="accDetailOrdersTable">
          <thead>
            <tr>
              <th>Order Code</th>
              <th>Opening Status</th>
              <th>Latest Status</th>
              <th>Assigned To</th>
              <th>Actually Worked By</th>
              <th>Actions</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            ${orders.length === 0 ? `
              <tr><td colspan="7" style="text-align:center;padding:30px;color:var(--mut)">No orders found for this account.</td></tr>
            ` : orders.map(o => `
              <tr data-text="${(o.order_code + ' ' + (o.actual_employees || []).join(' ') + ' ' + o.assigned_employee).toLowerCase()}">
                <td class="nm-cell">
                  <a style="color:var(--blue);cursor:pointer;font-weight:700;text-decoration:underline" onclick="closeAccountDetailModal();show('order-tracking');loadOrderTrackingView('${escapeHtml(o.order_code)}')">
                    ${escapeHtml(o.order_code)}
                  </a>
                </td>
                <td><span class="tag" style="background:#EFF6FF;color:#1D4ED8">${escapeHtml(o.opening_status || 'New')}</span></td>
                <td><b>${escapeHtml(o.last_logged_status || '-')}</b></td>
                <td>${escapeHtml(o.assigned_employee)}</td>
                <td>${(o.actual_employees || []).map(n => `<span class="tag" style="background:#DCFCE7;color:#15803D;margin-right:3px">${escapeHtml(n)}</span>`).join('') || '-'}</td>
                <td><b>${o.real_actions_count || 0}</b></td>
                <td>
                  ${o.is_worked_outside_allocation
                    ? '<span class="tag" style="background:#FEE2E2;color:#991B1B">⚠️ Outside Alloc</span>'
                    : (o.orders_worked_today ? '<span class="tag" style="background:#DCFCE7;color:#15803D">✓ Worked</span>' : '<span class="tag" style="background:#F1F5F9;color:#64748B">Untouched</span>')}
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  } else if (currentAccDetailTab === 'employees') {
    tabBody = `
      <div class="tbl-scroll" style="max-height:460px;overflow-y:auto">
        <table>
          <thead>
            <tr>
              <th>Employee Name</th>
              <th>Assignment</th>
              <th style="text-align:right">Allocated Orders</th>
              <th style="text-align:right">Orders Worked</th>
              <th style="text-align:right">Real Actions</th>
              <th style="text-align:right">Printed</th>
              <th style="text-align:right">Pending</th>
              <th style="text-align:right">Cancelled</th>
              <th style="text-align:right">Alt Phones</th>
            </tr>
          </thead>
          <tbody>
            ${empAct.length === 0 ? `
              <tr><td colspan="9" style="text-align:center;padding:30px;color:var(--mut)">No employee activity recorded for this account.</td></tr>
            ` : empAct.map(ea => `
              <tr>
                <td class="nm-cell"><b>${escapeHtml(ea.employee_name)}</b></td>
                <td>${ea.is_assigned ? '<span class="tag" style="background:#DCFCE7;color:#15803D">Assigned</span>' : '<span class="tag" style="background:#FEE2E2;color:#991B1B">Unassigned</span>'}</td>
                <td style="text-align:right">${fmt(ea.allocated_orders)}</td>
                <td style="text-align:right;font-weight:700;color:#15803D">${fmt(ea.orders_worked)}</td>
                <td style="text-align:right;font-weight:700">${fmt(ea.real_actions)}</td>
                <td style="text-align:right;color:#15803D">${fmt(ea.printed)}</td>
                <td style="text-align:right;color:#7C3AED">${fmt(ea.pending)}</td>
                <td style="text-align:right;color:#DC2626">${fmt(ea.cancelled)}</td>
                <td style="text-align:right;color:#2563EB">${fmt(ea.alt)}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  } else if (currentAccDetailTab === 'timeline') {
    tabBody = `
      <div style="max-height:460px;overflow-y:auto;padding-right:8px">
        ${timeline.length === 0 ? `
          <p style="text-align:center;color:var(--mut);padding:30px">No chronological log events recorded for this account's orders.</p>
        ` : `
          <div style="display:flex;flex-direction:column;gap:10px">
            ${timeline.map(ev => `
              <div style="display:flex;gap:12px;padding:10px 14px;border-radius:10px;background:#F8FAFC;border:1px solid #E2E8F0;align-items:center">
                <span class="rk">${ev.step_number}</span>
                <div style="flex:1">
                  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2px">
                    <b>${escapeHtml(ev.order_code)}</b>
                    <span style="font-size:11px;color:var(--mut)">${escapeHtml(ev.event_time || '-')}</span>
                  </div>
                  <div style="font-size:12px;color:var(--slate)">
                    Action: <b>${escapeHtml(ev.action || '-')}</b> &rarr; Status: <b>${escapeHtml(ev.status || '-')}</b> by <b>${escapeHtml(ev.employee_name)}</b>
                  </div>
                </div>
              </div>
            `).join('')}
          </div>
        `}
      </div>
    `;
  }

  content.innerHTML = navHtml + tabBody;
}

function filterAccDetailOrders(query) {
  const q = String(query || '').trim().toLowerCase();
  const rows = document.querySelectorAll('#accDetailOrdersTable tbody tr[data-text]');
  rows.forEach(r => {
    const text = r.getAttribute('data-text') || '';
    r.style.display = text.includes(q) ? '' : 'none';
  });
}

// -------------------------------------------------------------
// ALLOCATION HISTORY VIEW (Part 22)
// -------------------------------------------------------------
async function loadAllocationHistoryView() {
  const container = document.getElementById('allocHistoryContainer');
  if (!container) return;

  let rows = [];
  try {
    rows = await apiFetch('/api/allocations-history');
  } catch(e) {
    rows = [];
  }
  let html = `
    <div class="panel">
      <div class="hd">
        <div>
          <h3>⏳ Allocation History</h3>
          <p>Audit trail of daily work distribution across historical sessions.</p>
        </div>
      </div>
      <div class="tbl-scroll">
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Agents Assigned</th>
              <th>Total Account Assignments</th>
              <th>Assigned Orders Workload</th>
              <th>Notes</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
  `;

  if (rows.length === 0) {
    html += `<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--mut)">No allocations saved yet.</td></tr>`;
  } else {
    rows.forEach(r => {
      html += `
        <tr>
          <td class="nm-cell"><b>${r.allocation_date}</b></td>
          <td>${r.employee_count} agents</td>
          <td>${r.assignment_count} assignments</td>
          <td><b>${fmt(r.total_workload)} orders</b></td>
          <td style="color:var(--mut);font-size:11.5px">${r.notes || '-'}</td>
          <td>
            <button class="btn sm" onclick="inspectAllocHistoryDate('${r.allocation_date}')">Inspect / Load</button>
          </td>
        </tr>
      `;
    });
  }

  html += `</tbody></table></div></div>`;
  container.innerHTML = html;
}

function inspectAllocHistoryDate(date) {
  setGlobalSelectedDate(date);
  show('work-allocation');
}

// -------------------------------------------------------------
// CURRENT ORDERS & TWO-FILE SPECIFIC ORDERS MERGE POOL (Part 4, 30, 54)
// -------------------------------------------------------------
let curOrdersSearch = '';
let curOrdersAccountFilter = '';
let curOrdersStatusFilter = '';
let curOrdersPage = 0;
const curOrdersLimit = 50;

async function loadCurrentOrdersView() {
  const container = document.getElementById('currentOrdersContainer');
  if (!container) return;

  const [poolStatus, ordersData] = await Promise.all([
    apiFetch(`/api/orders/pool-status/${currentWorkDate}`).catch(() => null),
    apiFetch(`/api/orders/current/${currentWorkDate}?account=${encodeURIComponent(curOrdersAccountFilter)}&status=${encodeURIComponent(curOrdersStatusFilter)}&search=${encodeURIComponent(curOrdersSearch)}&limit=${curOrdersLimit}&offset=${curOrdersPage * curOrdersLimit}`).catch(() => ({ orders: [], total: 0 }))
  ]);

  const f1 = poolStatus ? poolStatus.file1 : null;
  const f2 = poolStatus ? poolStatus.file2 : null;
  const summary = poolStatus ? poolStatus.summary : null;
  const accounts = (poolStatus && poolStatus.accounts) ? poolStatus.accounts : [];
  const totalOrders = poolStatus ? poolStatus.total_orders : 0;

  let html = `
    <!-- Operational Source Separation Banner -->
    <div style="background:linear-gradient(135deg, #1E3A8A, #1D4ED8);color:#fff;border-radius:14px;padding:16px 20px;margin-bottom:20px;display:flex;align-items:center;gap:16px;box-shadow:var(--shadow)">
      <div style="font-size:32px">📦</div>
      <div style="flex:1">
        <b style="font-size:15px;display:block;margin-bottom:3px">Operational Source B: Specific Orders (Today's Current Work Pool)</b>
        <p style="font-size:12px;opacity:0.9;margin:0;line-height:1.5">
          Dedicated purely to today's active inventory and manual work allocation. Two files per day (File #1 and File #2) are merged into one consolidated pool.
          <b>Never</b> used as performance history. <b>Never</b> mixed with the Daily Log.
        </p>
      </div>
      <div style="text-align:right;background:rgba(255,255,255,0.15);padding:8px 14px;border-radius:10px;border:1px solid rgba(255,255,255,0.2)">
        <span style="font-size:10.5px;text-transform:uppercase;letter-spacing:0.5px;display:block">Active Work Date</span>
        <input type="date" class="date-in" id="curOrdersDateInput" value="${currentWorkDate}" style="background:#fff;color:var(--navy);font-weight:700;border:none;margin-top:4px" onchange="setGlobalSelectedDate(this.value);curOrdersPage=0;loadCurrentOrdersView();">
      </div>
    </div>

    <!-- Two-File Staging Grid (Part 4, 30, 54) -->
    <div class="grid g2e" style="margin-bottom:20px">
      <!-- File 1 Card -->
      <div class="panel" style="border: 2px ${f1 ? 'solid #10B981' : 'dashed var(--line)'}; background: ${f1 ? '#F0FDF4' : '#fff'}">
        <div class="hd" style="margin-bottom:10px">
          <div>
            <h3 style="color:${f1 ? '#15803D' : 'var(--navy)'}">
              ${f1 ? '✓' : '⭱'} Specific Orders File #1
              ${f1 ? '<span class="tag" style="background:#DCFCE7;color:#15803D">Staged & Ready</span>' : '<span class="tag" style="background:#FEE2E2;color:#991B1B">Pending Upload</span>'}
            </h3>
            <p>${f1 ? f1.file_name : 'Upload the first Specific Orders Excel file for today'}</p>
          </div>
        </div>
        ${f1 ? `
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;background:#fff;padding:10px;border-radius:8px;border:1px solid #E2E8F0;margin-bottom:12px;font-size:12px">
            <div><span style="color:var(--mut);display:block;font-size:10.5px">Total Rows</span><b>${fmt(f1.row_count)}</b></div>
            <div><span style="color:var(--mut);display:block;font-size:10.5px">Valid Orders</span><b style="color:#15803D">${fmt(f1.valid_orders_count)}</b></div>
            <div><span style="color:var(--mut);display:block;font-size:10.5px">Uploaded</span><b>${f1.upload_date ? f1.upload_date.split(' ')[1] || f1.upload_date : '-'}</b></div>
          </div>
        ` : `
          <p style="font-size:12px;color:var(--mut);margin-bottom:14px">Required to ensure all today's accounts are represented in the work pool.</p>
        `}
        <div style="display:flex;gap:8px">
          <label class="btn ${f1 ? '' : 'primary'} sm" style="cursor:pointer">
            ${f1 ? '↻ Replace File #1' : '⭱ Choose File #1'}
            <input type="file" accept=".xlsx,.xls" style="display:none" onchange="uploadSpecificOrdersSlot(1, this)">
          </label>
        </div>
      </div>

      <!-- File 2 Card -->
      <div class="panel" style="border: 2px ${f2 ? 'solid #10B981' : 'dashed var(--line)'}; background: ${f2 ? '#F0FDF4' : '#fff'}">
        <div class="hd" style="margin-bottom:10px">
          <div>
            <h3 style="color:${f2 ? '#15803D' : 'var(--navy)'}">
              ${f2 ? '✓' : '⭱'} Specific Orders File #2
              ${f2 ? '<span class="tag" style="background:#DCFCE7;color:#15803D">Staged & Ready</span>' : '<span class="tag" style="background:#FEE2E2;color:#991B1B">Pending Upload</span>'}
            </h3>
            <p>${f2 ? f2.file_name : 'Upload the second Specific Orders Excel file for today'}</p>
          </div>
        </div>
        ${f2 ? `
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;background:#fff;padding:10px;border-radius:8px;border:1px solid #E2E8F0;margin-bottom:12px;font-size:12px">
            <div><span style="color:var(--mut);display:block;font-size:10.5px">Total Rows</span><b>${fmt(f2.row_count)}</b></div>
            <div><span style="color:var(--mut);display:block;font-size:10.5px">Valid Orders</span><b style="color:#15803D">${fmt(f2.valid_orders_count)}</b></div>
            <div><span style="color:var(--mut);display:block;font-size:10.5px">Uploaded</span><b>${f2.upload_date ? f2.upload_date.split(' ')[1] || f2.upload_date : '-'}</b></div>
          </div>
        ` : `
          <p style="font-size:12px;color:var(--mut);margin-bottom:14px">Upload File #2 to merge complementary order queues into today's pool.</p>
        `}
        <div style="display:flex;gap:8px">
          <label class="btn ${f2 ? '' : 'primary'} sm" style="cursor:pointer">
            ${f2 ? '↻ Replace File #2' : '⭱ Choose File #2'}
            <input type="file" accept=".xlsx,.xls" style="display:none" onchange="uploadSpecificOrdersSlot(2, this)">
          </label>
        </div>
      </div>
    </div>

    <!-- Merge & Consolidation Panel (Part 4, 30, 54) -->
    <div class="panel" style="margin-bottom:20px;border:1px solid var(--line);box-shadow:var(--shadow)">
      <div class="hd">
        <div>
          <h3>⚡ Two-File Consolidation & Merged Pool</h3>
          <p>Deterministic deduplication consolidating File #1 and File #2 into one active pool.</p>
        </div>
        <div style="display:flex;gap:8px">
          <button class="btn success" onclick="triggerManualMergePool()">⚡ Re-Merge Pool</button>
          <button class="btn primary" onclick="show('work-allocation')">📋 Open Work Allocation</button>
        </div>
      </div>

      <!-- Metrics Breakdown -->
      <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:14px">
        <div style="background:var(--panel2);padding:12px;border-radius:10px;border:1px solid var(--line);text-align:center">
          <span style="font-size:10.5px;color:var(--mut);text-transform:uppercase;font-weight:700">File 1 Orders</span>
          <b style="font-size:20px;color:var(--navy);display:block;margin-top:4px">${fmt(summary ? summary.file1_orders : (f1 ? f1.valid_orders_count : 0))}</b>
        </div>
        <div style="background:var(--panel2);padding:12px;border-radius:10px;border:1px solid var(--line);text-align:center">
          <span style="font-size:10.5px;color:var(--mut);text-transform:uppercase;font-weight:700">File 2 Orders</span>
          <b style="font-size:20px;color:var(--navy);display:block;margin-top:4px">${fmt(summary ? summary.file2_orders : (f2 ? f2.valid_orders_count : 0))}</b>
        </div>
        <div style="background:var(--panel2);padding:12px;border-radius:10px;border:1px solid var(--line);text-align:center">
          <span style="font-size:10.5px;color:var(--mut);text-transform:uppercase;font-weight:700">Combined Raw</span>
          <b style="font-size:20px;color:var(--slate);display:block;margin-top:4px">${fmt(summary ? summary.merged_orders_count : ((f1 ? f1.valid_orders_count : 0) + (f2 ? f2.valid_orders_count : 0)))}</b>
        </div>
        <div style="background:#ECFDF5;padding:12px;border-radius:10px;border:1px solid #A7F3D0;text-align:center">
          <span style="font-size:10.5px;color:#065F46;text-transform:uppercase;font-weight:700">Unique Pool Size</span>
          <b style="font-size:20px;color:#059669;display:block;margin-top:4px">${fmt(summary ? summary.unique_orders_count : totalOrders)}</b>
        </div>
        <div style="background:#FFFBEB;padding:12px;border-radius:10px;border:1px solid #FDE68A;text-align:center">
          <span style="font-size:10.5px;color:#92400E;text-transform:uppercase;font-weight:700">Duplicates Removed</span>
          <b style="font-size:20px;color:#D97706;display:block;margin-top:4px">${fmt(summary ? summary.duplicate_orders_count : 0)}</b>
        </div>
      </div>

      <!-- Deduplication Narrative & Status Preservation Guarantee -->
      <div style="background:#F8FAFC;border-left:4px solid var(--blue);padding:12px 16px;border-radius:8px;font-size:12.5px;line-height:1.55;color:var(--slate);margin-bottom:12px">
        <b>Deduplication Policy & Audit Explanation:</b>
        ${summary ? summary.duplicates_explanation : 'Consolidated orders across files into unique order entries without double-counting. Pending and New statuses preserved.'}
        ${(summary && summary.duplicate_orders_count > 0) ? `
          <button class="btn sm" style="margin-left:10px;padding:2px 8px;font-size:11px" onclick="toggleDuplicatesModal(true)">🔍 Inspect Duplicates Log</button>
        ` : ''}
      </div>
    </div>

    <!-- Active Accounts in Pool -->
    <div class="panel" style="margin-bottom:20px">
      <div class="hd">
        <div>
          <h3>📦 Active Merchant Accounts Available Today (${accounts.length})</h3>
          <p>Extracted exclusively from today's merged pool. Strictly isolated from historical logs.</p>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px">
        ${accounts.length === 0 ? `
          <div style="grid-column:1/-1;padding:24px;text-align:center;color:var(--mut)">No accounts found in current work pool. Upload File #1 or File #2 above.</div>
        ` : accounts.map(a => `
          <div style="background:var(--panel2);padding:12px 14px;border-radius:10px;border:1px solid var(--line);display:flex;justify-content:space-between;align-items:center">
            <b style="font-size:13px;color:var(--ink)">${a}</b>
            <span class="tag" style="background:#EFF6FF;color:var(--blue);font-weight:700">Active</span>
          </div>
        `).join('')}
      </div>
    </div>

    <!-- Current Orders Explorer -->
    <div class="panel">
      <div class="hd">
        <div>
          <h3>🔍 Current Orders Explorer (${fmt(ordersData.total)} Orders)</h3>
          <p>Browse, search, and verify all orders currently in today's work pool.</p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
          <input type="text" class="search" style="padding:6px 12px;border:1px solid var(--line);border-radius:8px;font-size:12px;width:180px" placeholder="Search code/account..." value="${curOrdersSearch}" oninput="curOrdersSearch=this.value;curOrdersPage=0;loadCurrentOrdersView();">
          <select class="filter" style="font-size:12px" onchange="curOrdersAccountFilter=this.value;curOrdersPage=0;loadCurrentOrdersView();">
            <option value="">All Accounts (${accounts.length})</option>
            ${accounts.map(a => `<option value="${a}" ${a===curOrdersAccountFilter?'selected':''}>${a}</option>`).join('')}
          </select>
          <select class="filter" style="font-size:12px" onchange="curOrdersStatusFilter=this.value;curOrdersPage=0;loadCurrentOrdersView();">
            <option value="">All Statuses</option>
            <option value="New" ${curOrdersStatusFilter==='New'?'selected':''}>New</option>
            <option value="Pending" ${curOrdersStatusFilter==='Pending'?'selected':''}>Pending</option>
            <option value="Processing" ${curOrdersStatusFilter==='Processing'?'selected':''}>Processing</option>
            <option value="Printed" ${curOrdersStatusFilter==='Printed'?'selected':''}>Printed</option>
            <option value="Cancelled" ${curOrdersStatusFilter==='Cancelled'?'selected':''}>Cancelled</option>
          </select>
        </div>
      </div>
      <div class="tbl-scroll">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Order Code</th>
              <th>Account</th>
              <th>Status</th>
              <th>Source File</th>
              <th>Order Date</th>
            </tr>
          </thead>
          <tbody>
            ${(ordersData.orders || []).length === 0 ? `
              <tr><td colspan="6" style="text-align:center;padding:24px;color:var(--mut)">No orders match your filter criteria.</td></tr>
            ` : (ordersData.orders || []).map((o, idx) => `
              <tr>
                <td>${curOrdersPage * curOrdersLimit + idx + 1}</td>
                <td class="nm-cell"><b>${o.order_code}</b></td>
                <td><span class="tag" style="background:#EFF6FF;color:var(--blue)">${o.account}</span></td>
                <td><span class="tag" style="background:${o.status==='New'?'#DBEAFE':o.status==='Pending'?'#F3E8FF':o.status==='Printed'?'#DCFCE7':'#FEE2E2'};color:${o.status==='New'?'#1D4ED8':o.status==='Pending'?'#7C3AED':o.status==='Printed'?'#15803D':'#B91C1C'}">${o.status}</span></td>
                <td><span class="tag" style="background:var(--panel2);color:var(--slate)">Slot #${o.source_file_slot || 1}</span></td>
                <td style="color:var(--mut);font-size:11px">${o.order_date || currentWorkDate}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
      <!-- Pagination Controls -->
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:14px;font-size:12px;color:var(--mut)">
        <span>Showing ${Math.min(ordersData.total, curOrdersPage * curOrdersLimit + 1)} - ${Math.min(ordersData.total, (curOrdersPage + 1) * curOrdersLimit)} of ${fmt(ordersData.total)} orders</span>
        <div style="display:flex;gap:6px">
          <button class="btn sm" ${curOrdersPage===0?'disabled':''} onclick="curOrdersPage--;loadCurrentOrdersView();">◀ Previous</button>
          <button class="btn sm" ${(curOrdersPage+1)*curOrdersLimit >= ordersData.total ? 'disabled':''} onclick="curOrdersPage++;loadCurrentOrdersView();">Next ▶</button>
        </div>
      </div>
    </div>

    <!-- Duplicate Orders Audit Modal -->
    <div id="dupAuditModal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(15,23,42,0.6);z-index:9999;place-items:center;padding:20px">
      <div style="background:#fff;border-radius:14px;max-width:800px;width:100%;max-height:85vh;display:flex;flex-direction:column;box-shadow:var(--shadow-lg)">
        <div style="padding:16px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center">
          <h3 style="margin:0">🔍 Duplicate Orders Audit Log (${summary ? summary.duplicate_orders_count : 0})</h3>
          <button class="btn sm" onclick="toggleDuplicatesModal(false)">✕ Close</button>
        </div>
        <div style="padding:16px 20px;overflow-y:auto;flex:1">
          <p style="font-size:12px;color:var(--mut);margin-top:0">The following orders occurred in multiple files or rows and were consolidated without double-counting:</p>
          <div class="tbl-scroll">
            <table>
              <thead>
                <tr>
                  <th>Order Code</th>
                  <th>Account</th>
                  <th>File Slot</th>
                  <th>Original Status</th>
                  <th>Resolved Status</th>
                  <th>Resolution Reason</th>
                </tr>
              </thead>
              <tbody>
                ${summary && summary.duplicate_details ? summary.duplicate_details.map(d => `
                  <tr>
                    <td><b>${d.order_code}</b></td>
                    <td>${d.account || '-'}</td>
                    <td>Slot #${d.file_slot}</td>
                    <td>${d.status}</td>
                    <td><b>${d.resolved_status || d.status}</b></td>
                    <td style="font-size:11px;color:var(--slate)">${d.reason}</td>
                  </tr>
                `).join('') : '<tr><td colspan="6" style="text-align:center;padding:16px;color:var(--mut)">No duplicate records.</td></tr>'}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  `;

  container.innerHTML = html;
}

function toggleDuplicatesModal(show) {
  const m = document.getElementById('dupAuditModal');
  if (m) m.style.display = show ? 'grid' : 'none';
}

async function uploadSpecificOrdersSlot(slot, input) {
  if (!input.files || !input.files[0]) return;
  const file = input.files[0];
  const formData = new FormData();
  formData.append('file', file);
  formData.append('work_date', currentWorkDate);
  formData.append('file_slot', slot);

  showToast(`⏳ Uploading Specific Orders File #${slot}...`, `Staging ${file.name}...`);

  try {
    const res = await apiFetch('/api/uploads/specific-orders', {
      method: 'POST',
      body: formData
    });

    if (res.success) {
      showToast(`✓ Specific Orders File #${slot} Uploaded!`, `${file.name} staged successfully. Pool updated.`);
      await loadCurrentOrdersView();
      await loadWorkAllocationData();
    } else {
      alert('Error: ' + (res.error || 'Failed to upload Specific Orders'));
    }
  } catch (err) {
    alert('Upload error: ' + err.message);
  } finally {
    input.value = '';
  }
}

async function triggerManualMergePool() {
  showToast('⏳ Merging Files...', 'Consolidating File 1 and File 2 into Work Pool...');
  try {
    const res = await apiFetch('/api/uploads/specific-orders/merge', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ work_date: currentWorkDate })
    });

    if (res.success) {
      showToast('✓ Pool Merged!', `Consolidated ${res.unique_orders} unique orders across ${res.accounts_count} accounts.`);
      await loadCurrentOrdersView();
      await loadWorkAllocationData();
    } else {
      alert('Merge error: ' + (res.error || 'Failed to merge files'));
    }
  } catch (err) {
    alert('Error: ' + err.message);
  }
}

// -------------------------------------------------------------
// UPLOADS: DAILY LOG & SPECIFIC ORDERS (Part 3, 13, 14, 57)
// -------------------------------------------------------------
async function uploadDailyLog(input) {
  if (!input.files || !input.files[0]) return;
  const file = input.files[0];
  const formData = new FormData();
  formData.append('file', file);
  formData.append('work_date', currentWorkDate);

  showToast('⏳ Processing Daily Log...', 'Deduplicating rows and calculating KPIs...');

  try {
    const res = await apiFetch('/api/uploads/daily-log', {
      method: 'POST',
      body: formData
    });

    if (res.success) {
      showToast('✓ Daily Log Processed!', `${file.name} · ${res.summary.deduped_actions} real actions (${res.summary.duplicates_removed_pct}% duplicates removed).`);
      // Reload updated data
      await fetchPerformanceDataForDate(currentWorkDate);
      RENDERED = pages();
      show(currentPage);
    } else {
      alert('Error: ' + (res.error || 'Failed to process Daily Log'));
    }
  } catch (err) {
    alert('Upload error: ' + err.message);
  } finally {
    input.value = '';
  }
}

async function uploadSpecificOrders(input) {
  // Delegate to Slot 1 by default
  await uploadSpecificOrdersSlot(1, input);
}

// -------------------------------------------------------------
// TRACKING & QUALITY AUDIT UI (Phases 9-25)
// -------------------------------------------------------------
let currentTrackedOrderCode = '';
let currentTrackedEmployeeId = '';

async function loadOrderTrackingView(orderCodeToSearch) {
  const container = document.getElementById('orderTrackingContainer');
  if (!container) return;

  if (orderCodeToSearch) currentTrackedOrderCode = orderCodeToSearch.trim();

  let orderData = null;
  if (currentTrackedOrderCode) {
    try {
      orderData = await apiFetch(`/api/tracking/${currentWorkDate}/order/${encodeURIComponent(currentTrackedOrderCode)}`);
    } catch (e) {
      orderData = null;
    }
  }

  let html = `
    <div class="panel" style="margin-bottom:20px">
      <div class="hd" style="flex-wrap:wrap;gap:12px">
        <div>
          <h3>🔍 Order Tracking & Chronological Audit</h3>
          <p>Inspect any order's full lifecycle across New Orders, Pending Orders, and the Daily Log.</p>
        </div>
        <div style="display:flex;align-items:center;gap:8px">
          <input type="text" id="orderSearchInput" class="date-in" placeholder="Enter Order Code (e.g. ir5425, wh3010)..."
                 value="${escapeHtml(currentTrackedOrderCode)}" style="padding:8px 14px;border:1px solid var(--line);border-radius:8px;font-size:13px;width:240px"
                 onkeydown="if(event.key==='Enter') searchOrderFromInput()">
          <button class="btn primary sm" onclick="searchOrderFromInput()">Search</button>
        </div>
      </div>
    </div>
  `;

  if (!currentTrackedOrderCode) {
    html += `
      <div class="panel" style="text-align:center;padding:50px 20px">
        <div style="font-size:44px;margin-bottom:12px">📦</div>
        <h3 style="font-size:16px;color:var(--navy);margin-bottom:6px">Search an Order to Inspect Lifecycle</h3>
        <p style="font-size:13px;color:var(--mut);max-width:520px;margin:0 auto 20px">
          Enter an order code above to view its opening source, assigned employee, actual worker(s), and chronological status transitions from the Daily Log.
        </p>
      </div>
    `;
  } else if (!orderData || orderData.error) {
    html += `
      <div class="panel" style="text-align:center;padding:40px 20px">
        <div style="font-size:36px;color:var(--red);margin-bottom:10px">⚠️</div>
        <h3 style="color:var(--red);margin-bottom:6px">Order Not Found</h3>
        <p style="color:var(--mut);font-size:13px">No opening inventory or Daily Log activity found for order "<b>${escapeHtml(currentTrackedOrderCode)}</b>" on ${formatDisplayDate(currentWorkDate)}.</p>
      </div>
    `;
  } else {
    const isConflict = orderData.is_opening_conflict;
    const isOutside = orderData.is_worked_outside_allocation;
    const isAssigned = orderData.is_assigned_work;

    html += `
      <!-- Order Summary Card -->
      <div class="panel" style="margin-bottom:20px;border-left:5px solid ${isConflict ? 'var(--amber)' : (isOutside ? 'var(--purple)' : 'var(--blue)')}">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:14px;margin-bottom:16px">
          <div>
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
              <h2 style="font-size:22px;color:var(--navy);font-weight:800;margin:0">${escapeHtml(orderData.order_code)}</h2>
              <span class="tag" style="background:#EFF6FF;color:#1D4ED8;font-size:12px;font-weight:700">
                ${orderData.source_file_slot ? `Slot #${orderData.source_file_slot}` : 'Daily Log Only'}
              </span>
              ${isConflict ? '<span class="tag" style="background:#FEF3C7;color:#B45309;font-weight:700">⚠️ Opening Status Conflict</span>' : ''}
              ${isOutside ? '<span class="tag" style="background:#FEE2E2;color:#991B1B;font-weight:700">Worked Outside Allocation</span>' : (isAssigned ? '<span class="tag" style="background:#DCFCE7;color:#15803D;font-weight:700">✓ Assigned Work</span>' : '<span class="tag" style="background:#F1F5F9;color:#64748B">Untouched</span>')}
            </div>
            <div style="font-size:13px;color:var(--mut)">
              Merchant / Account: <b style="color:var(--navy)">${escapeHtml(orderData.account || 'Unassigned / Unknown')}</b> · Work Date: <b>${escapeHtml(orderData.work_date)}</b>
            </div>
          </div>
          <div style="text-align:right">
            <div style="font-size:11px;color:var(--mut);text-transform:uppercase;font-weight:700">Current / Final Status</div>
            <div style="font-size:18px;font-weight:800;color:${orderData.current_final_status === 'Printed' ? '#16A34A' : (orderData.current_final_status === 'Cancelled' ? '#DC2626' : '#2563EB')}">
              ${escapeHtml(orderData.current_final_status || 'Pending')}
            </div>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));gap:12px;background:#F8FAFC;padding:14px;border-radius:10px;border:1px solid #E2E8F0">
          <div>
            <span style="font-size:11px;color:var(--mut);display:block;text-transform:uppercase">Opening Status</span>
            <b style="color:var(--navy);font-size:13px">${escapeHtml(orderData.opening_status || '—')}</b>
          </div>
          <div>
            <span style="font-size:11px;color:var(--mut);display:block;text-transform:uppercase">Assigned Employee(s)</span>
            <b style="color:var(--navy);font-size:13px">${(orderData.assigned_employees && orderData.assigned_employees.length > 0) ? escapeHtml(orderData.assigned_employees.join(', ')) : 'None Assigned'}</b>
          </div>
          <div>
            <span style="font-size:11px;color:var(--mut);display:block;text-transform:uppercase">Actual Worker(s)</span>
            <b style="color:${isOutside ? '#991B1B' : 'var(--navy)'};font-size:13px">${(orderData.actual_employees && orderData.actual_employees.length > 0) ? escapeHtml(orderData.actual_employees.join(', ')) : 'No Action Logged'}</b>
          </div>
          <div>
            <span style="font-size:11px;color:var(--mut);display:block;text-transform:uppercase">Real Actions (Deduped)</span>
            <b style="color:var(--blue);font-size:14px">${fmt(orderData.real_actions_count)}</b>
          </div>
        </div>
      </div>

      <!-- Chronological Audit Timeline -->
      <div class="panel">
        <div class="hd" style="margin-bottom:14px">
          <div>
            <h3>⏳ Chronological Lifecycle Timeline</h3>
            <p>Every logged interaction with exact timestamps, agents, and source verification.</p>
          </div>
        </div>

        <div style="position:relative;padding-left:24px;border-left:2px solid #E2E8F0;margin-left:12px">
          ${(orderData.timeline || []).map(step => `
            <div style="position:relative;margin-bottom:20px">
              <div style="position:absolute;left:-31px;top:0;width:14px;height:14px;border-radius:50%;background:${step.type === 'OPENING' ? 'var(--blue)' : 'var(--green)'};border:3px solid #fff;box-shadow:0 0 0 2px ${step.type === 'OPENING' ? 'var(--blue)' : 'var(--green)'}"></div>
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
                <span style="font-size:12px;font-weight:700;color:var(--navy)">
                  Step #${step.step_number}: ${escapeHtml(step.status)}
                  <span class="tag" style="margin-left:6px;font-size:10.5px;background:#F1F5F9;color:#475569">${escapeHtml(step.source)}</span>
                </span>
                <span style="font-size:11.5px;color:var(--mut)">${escapeHtml(step.timestamp || '-')}</span>
              </div>
              <div style="font-size:12.5px;color:var(--slate)">
                <b>${escapeHtml(step.employee || 'System')}</b>: ${escapeHtml(step.action_text || 'Recorded')}
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  }

  container.innerHTML = html;
}

function searchOrderFromInput() {
  const input = document.getElementById('orderSearchInput');
  if (input && input.value.trim()) {
    loadOrderTrackingView(input.value.trim());
  }
}

async function loadEmployeeTrackingView(empIdToSelect) {
  const container = document.getElementById('employeeTrackingContainer');
  if (!container) return;

  try {
    let employees = [];
    try {
      employees = await apiFetch('/api/employees');
    } catch(e) {
      employees = [];
    }

    let teamSummary = null;
    try {
      teamSummary = await apiFetch(`/api/tracking/${currentWorkDate}/team-summary`);
    } catch(e) {
      teamSummary = null;
    }

    const teamList = (teamSummary && teamSummary.employees) || [];

    if (empIdToSelect) {
      currentTrackedEmployeeId = empIdToSelect;
    } else if (!currentTrackedEmployeeId) {
      if (teamList.length > 0 && teamList[0].employee_id) {
        currentTrackedEmployeeId = String(teamList[0].employee_id);
      } else if (employees.length > 0) {
        currentTrackedEmployeeId = String(employees[0].id);
      }
    }

    let empData = null;
    if (currentTrackedEmployeeId) {
      try {
        empData = await apiFetch(`/api/tracking/${currentWorkDate}/employee/${encodeURIComponent(currentTrackedEmployeeId)}`);
      } catch(e) {
        empData = null;
      }
    }

    const logUploaded = teamSummary ? Boolean(teamSummary.daily_log_uploaded) : false;
    const sources = (teamSummary && teamSummary.sources) || {};
    const teamKpis = (teamSummary && teamSummary.team_kpis) || {};

    let html = `
      <!-- Top Source Upload Integrity Status Bar -->
      <div class="panel" style="margin-bottom:20px;padding:16px 20px">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
          <div>
            <h3 style="margin:0 0 4px 0;font-size:17px;color:var(--navy)">👤 Employee Reality Tracking</h3>
            <p style="margin:0;font-size:12.5px;color:var(--mut)">
              Truth-telling tracking: manual assignment vs actual daily log activity on <b>${formatDisplayDate(currentWorkDate)}</b>.
            </p>
          </div>
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
            <span class="tag" style="background:${sources.new_orders_uploaded ? '#DCFCE7' : '#FEF3C7'};color:${sources.new_orders_uploaded ? '#15803D' : '#B45309'};font-size:11.5px;font-weight:700">
              ${sources.new_orders_uploaded ? '✓ File #1 (New)' : '⚠️ File #1 Missing'}
            </span>
            <span class="tag" style="background:${sources.pending_orders_uploaded ? '#DCFCE7' : '#FEF3C7'};color:${sources.pending_orders_uploaded ? '#15803D' : '#B45309'};font-size:11.5px;font-weight:700">
              ${sources.pending_orders_uploaded ? '✓ File #2 (Pending)' : '⚠️ File #2 Missing'}
            </span>
            <span class="tag" style="background:${logUploaded ? '#DCFCE7' : '#FEE2E2'};color:${logUploaded ? '#15803D' : '#991B1B'};font-size:11.5px;font-weight:700">
              ${logUploaded ? '✓ Daily Log Uploaded' : '⚠️ Daily Log Not Uploaded'}
            </span>
          </div>
        </div>
      </div>

      <!-- State Message Banner -->
      ${!logUploaded ? `
        <div style="background:#F8FAFC;border:1px solid #CBD5E1;border-radius:12px;padding:16px 20px;margin-bottom:20px;display:flex;align-items:center;gap:14px">
          <div style="font-size:24px">📁</div>
          <div>
            <b style="color:#334155;display:block;margin-bottom:2px">End-of-Day Log Not Uploaded</b>
            <p style="font-size:12.5px;color:#64748B;margin:0">
              The Daily Log has not been uploaded for ${formatDisplayDate(currentWorkDate)}. Showing manual account assignments. All worked activity, action counts, and allocation compliance are strictly recorded as <b>N/A</b>.
            </p>
          </div>
        </div>
      ` : (teamKpis.employees_with_activity === 0 ? `
        <div style="background:#EFF6FF;border:1px solid #BFDBFE;border-radius:12px;padding:16px 20px;margin-bottom:20px;display:flex;align-items:center;gap:14px">
          <div style="font-size:24px">ℹ️</div>
          <div>
            <b style="color:#1E40AF;display:block;margin-bottom:2px">Log Uploaded — No Activity Recorded</b>
            <p style="font-size:12.5px;color:#1E3A8A;margin:0">
              The Daily Log is uploaded for ${formatDisplayDate(currentWorkDate)}, but contains 0 action records across the team. Compliance is <b>N/A</b>.
            </p>
          </div>
        </div>
      ` : '')}

      <!-- Team-Level Summary Section -->
      <div class="panel" style="margin-bottom:24px">
        <div class="hd" style="flex-wrap:wrap;gap:12px">
          <div>
            <h3>👥 Team-Level Tracking Summary</h3>
            <p>Overview of all CS employees, assigned workload, actual touches, and compliance.</p>
          </div>
          <div style="display:flex;align-items:center;gap:10px">
            <input type="text" placeholder="Search employee..." id="teamTableSearch" class="date-in"
                   style="padding:6px 12px;border:1px solid var(--line);border-radius:8px;font-size:12.5px;width:180px"
                   oninput="filterTeamTrackingTable(this.value)">
          </div>
        </div>

        <!-- Team KPIs -->
        <div class="kpis" style="margin-bottom:16px">
          ${kpiCard('👥', fmt(teamKpis.total_employees || teamList.length), 'Total Team Members', 'Permanent & Active CS', NAVY)}
          ${kpiCard('⚡', logUploaded ? fmt(teamKpis.employees_with_activity) : '—', 'With Log Activity', logUploaded ? 'Logged at least 1 action' : 'Log not uploaded', BLUE)}
          ${kpiCard('💤', logUploaded ? fmt(teamKpis.employees_without_activity) : '—', 'Zero Activity', logUploaded ? '0 actions recorded' : 'Log not uploaded', PURPLE)}
          ${kpiCard('📦', logUploaded ? fmt(teamKpis.total_orders_worked_today) : '—', 'Orders Worked Today', logUploaded ? 'Unique orders touched' : 'Log not uploaded', GREEN)}
          ${kpiCard('⚡', logUploaded ? fmt(teamKpis.total_real_actions) : '—', 'Total Real Actions', logUploaded ? 'Deduplicated (120s)' : 'Log not uploaded', BLUE)}
          ${kpiCard('⚠️', logUploaded ? fmt(teamKpis.outside_allocation_accounts) : '—', 'Outside Accounts', logUploaded ? 'Unassigned accounts worked' : 'Log not uploaded', (teamKpis.outside_allocation_accounts > 0) ? AMBER : GREEN)}
        </div>

        <!-- Team Summary Table -->
        <div class="tbl-scroll">
          <table id="teamSummaryTable">
            <thead>
              <tr>
                <th>Employee</th>
                <th>Assigned</th>
                <th>Worked</th>
                <th>Outside Allocation</th>
                <th>Orders Worked</th>
                <th>Real Actions</th>
                <th>Printed</th>
                <th>Pending</th>
                <th>Cancelled</th>
                <th>Allocation Compliance</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              ${teamList.length === 0 ? `
                <tr><td colspan="11" style="text-align:center;padding:24px;color:var(--mut)">No team members recorded for this date.</td></tr>
              ` : teamList.map(e => {
                const empName = e.employee_name || 'Unknown';
                const complianceLabel = e.allocation_compliance_label || (e.allocation_compliance !== null ? `${e.allocation_compliance}%` : 'N/A');
                const isNA = e.allocation_compliance === null;
                const hasOut = e.has_outside_activity;
                return `
                  <tr data-emp="${escapeHtml(empName.toLowerCase())}">
                    <td>
                      <b>${escapeHtml(empName)}</b>
                      <span style="font-size:11px;color:var(--mut);display:block">${escapeHtml(e.department || 'CS')}</span>
                    </td>
                    <td>
                      <span class="tag" style="background:#EFF6FF;color:#1D4ED8;font-weight:700">
                        ${fmt(e.assigned_accounts_count)} Accounts
                      </span>
                    </td>
                    <td>
                      ${logUploaded ? `
                        <span class="tag" style="background:${e.worked_accounts_count > 0 ? '#F0FDF4' : '#F1F5F9'};color:${e.worked_accounts_count > 0 ? '#15803D' : '#64748B'}">
                          ${fmt(e.worked_accounts_count)} Accounts
                        </span>
                      ` : '<span style="color:var(--mut)">—</span>'}
                    </td>
                    <td>
                      ${logUploaded ? (
                        hasOut
                          ? `<span class="tag" style="background:#FEE2E2;color:#991B1B;font-weight:700">⚠️ ${fmt(e.extra_accounts_count)} Unassigned</span>`
                          : '<span class="tag" style="background:#F0FDF4;color:#15803D">None</span>'
                      ) : '<span style="color:var(--mut)">—</span>'}
                    </td>
                    <td><b>${logUploaded ? fmt(e.orders_worked_today) : '—'}</b></td>
                    <td><b>${logUploaded ? fmt(e.real_actions) : '—'}</b></td>
                    <td>${logUploaded ? fmt(e.printed) : '—'}</td>
                    <td>${logUploaded ? fmt(e.pending) : '—'}</td>
                    <td>${logUploaded ? fmt(e.cancelled) : '—'}</td>
                    <td>
                      ${isNA ? `
                        <span class="tag" style="background:#F1F5F9;color:#64748B;font-weight:700">N/A</span>
                      ` : (e.allocation_compliance >= 100 ? `
                        <span class="tag" style="background:#DCFCE7;color:#15803D;font-weight:700">100%</span>
                      ` : `
                        <span class="tag" style="background:#FEF3C7;color:#B45309;font-weight:700">${escapeHtml(complianceLabel)}</span>
                      `)}
                    </td>
                    <td>
                      <button class="btn sm" onclick="selectEmployeeForRealityDetail('${escapeHtml(String(e.employee_id || empName))}')">
                        Inspect Reality →
                      </button>
                    </td>
                  </tr>
                `;
              }).join('')}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Individual Employee Detail Section Anchor -->
      <div id="employeeRealityDetailSection" class="panel" style="margin-bottom:20px">
        <div class="hd" style="flex-wrap:wrap;gap:12px">
          <div>
            <h3>🔍 Individual Employee Reality Detail</h3>
            <p>Drilldown into assigned vs actually worked accounts and order breakdown.</p>
          </div>
          <div>
            <select id="empRealitySelect" class="date-in" style="font-weight:700;padding:7px 12px;border:1px solid var(--line);border-radius:8px"
                    onchange="loadEmployeeTrackingView(this.value)">
              ${employees.map(e => `
                <option value="${escapeHtml(String(e.id))}" ${String(e.id) === String(currentTrackedEmployeeId) || e.name === currentTrackedEmployeeId ? 'selected' : ''}>
                  ${escapeHtml(e.name)} (${escapeHtml(e.department || 'CS')})
                </option>
              `).join('')}
            </select>
          </div>
        </div>
      </div>
    `;

    if (!empData || empData.error) {
      html += `
        <div class="panel" style="text-align:center;padding:40px">
          <p style="color:var(--mut)">No tracking data available for this employee on ${formatDisplayDate(currentWorkDate)}.</p>
        </div>
      `;
    } else {
      const hasOutside = empData.outside_allocation && empData.outside_allocation.has_unassigned_activity;
      const isLogUp = Boolean(empData.daily_log_uploaded);
      const isNA = empData.allocation_compliance === null;
      const complianceLabel = empData.allocation_compliance_label || (empData.allocation_compliance !== null ? `${empData.allocation_compliance}%` : 'N/A');
      const assignedAccs = empData.assigned_accounts || [];
      const workedAccs = empData.actually_worked_accounts || [];
      const extraAccs = empData.extra_accounts_worked || empData.extra_unassigned_accounts || [];

      // Individual Employee Status Banner
      if (!isLogUp) {
        html += `
          <div style="background:#F8FAFC;border:1px solid #CBD5E1;border-radius:12px;padding:14px 18px;margin-bottom:20px;display:flex;align-items:center;gap:12px">
            <span style="font-size:20px">📁</span>
            <span style="font-size:13px;color:#475569">
              <b>End-of-Day Log Not Uploaded:</b> Actual worked metrics and compliance for <b>${escapeHtml(empData.employee_name)}</b> are <b>N/A</b>. Showing assigned accounts from manual allocation.
            </span>
          </div>
        `;
      } else if (empData.real_actions === 0) {
        html += `
          <div style="background:#EFF6FF;border:1px solid #BFDBFE;border-radius:12px;padding:14px 18px;margin-bottom:20px;display:flex;align-items:center;gap:12px">
            <span style="font-size:20px">ℹ️</span>
            <span style="font-size:13px;color:#1E40AF">
              <b>Log Uploaded — No Activity Recorded:</b> <b>${escapeHtml(empData.employee_name)}</b> was assigned ${assignedAccs.length} account(s), but logged 0 actions in today's Daily Log. Allocation Compliance is <b>N/A</b>.
            </span>
          </div>
        `;
      } else if (hasOutside) {
        html += `
          <div style="background:#FFFBEB;border:1px solid #FCD34D;border-radius:12px;padding:16px 20px;margin-bottom:20px;display:flex;align-items:center;gap:14px">
            <div style="font-size:24px">⚠️</div>
            <div>
              <b style="color:#B45309;display:block;margin-bottom:2px">Unassigned Activity Detected</b>
              <p style="font-size:12.5px;color:#92400E;margin:0">
                This employee logged actions on <b>${escapeHtml(extraAccs.join(', '))}</b>, which were NOT part of their assigned accounts for today.
                Allocation integrity is preserved — original manual assignment was NOT modified.
              </p>
            </div>
          </div>
        `;
      }

      html += `
        <!-- Metric Cards with Truthful N/A Handling -->
        <div class="kpis" style="margin-bottom:20px">
          ${kpiCard('📦', isLogUp ? fmt(empData.orders_worked_today) : '—', 'Orders Worked Today', isLogUp ? 'Unique orders touched' : 'Log not uploaded', NAVY)}
          ${kpiCard('⚡', isLogUp ? fmt(empData.real_actions) : '—', 'Real Actions', isLogUp ? 'Deduplicated (120s window)' : 'Log not uploaded', BLUE)}
          ${kpiCard('⚠️', isLogUp ? fmt(empData.orders_worked_outside_allocation) : '—', 'Orders Outside Allocation', isLogUp ? (hasOutside ? 'Touched unassigned accounts' : '0 unassigned') : 'Log not uploaded', hasOutside ? AMBER : GREEN)}
          ${kpiCard('✓', escapeHtml(complianceLabel), 'Allocation Compliance', isNA ? 'No activity recorded' : 'Actions in assigned accounts', isNA ? SLATE : (empData.allocation_compliance >= 100 ? GREEN : AMBER))}
        </div>

        <!-- Assigned vs Actually Worked Accounts Comparison -->
        <div class="grid g2" style="margin-bottom:20px">
          <div class="panel">
            <div class="hd">
              <div>
                <h3>📋 Assigned Accounts</h3>
                <p>Allocated through Manual Work Allocation</p>
              </div>
              <span class="tag" style="background:#EFF6FF;color:#1D4ED8;font-weight:700">${assignedAccs.length} Assigned</span>
            </div>
            <div>
              ${assignedAccs.length === 0 ? `
                <p style="font-size:12.5px;color:var(--mut);padding:14px 0">No accounts manually assigned for this date.</p>
              ` : `
                <ul style="list-style:none;padding:0;margin:0">
                  ${assignedAccs.map(acc => `
                    <li style="display:flex;justify-content:space-between;align-items:center;padding:9px 12px;border-bottom:1px solid #F1F5F9;font-size:13px">
                      <b>${escapeHtml(acc)}</b>
                      ${!isLogUp
                        ? '<span class="tag" style="background:#EFF6FF;color:#1D4ED8">Assigned</span>'
                        : (workedAccs.includes(acc)
                          ? '<span class="tag" style="background:#DCFCE7;color:#15803D">✓ Worked</span>'
                          : '<span class="tag" style="background:#F1F5F9;color:#64748B">Untouched</span>')}
                    </li>
                  `).join('')}
                </ul>
              `}
            </div>
          </div>

          <div class="panel">
            <div class="hd">
              <div>
                <h3>🔍 Actually Worked Accounts</h3>
                <p>Accounts where actions were recorded in Daily Log</p>
              </div>
              <span class="tag" style="background:#F0FDF4;color:#15803D;font-weight:700">${workedAccs.length} Worked</span>
            </div>
            <div>
              ${!isLogUp ? `
                <p style="font-size:12.5px;color:var(--mut);padding:14px 0">End-of-Day Log not uploaded for this date.</p>
              ` : (workedAccs.length === 0 ? `
                <p style="font-size:12.5px;color:var(--mut);padding:14px 0">No actions recorded in Daily Log for this date.</p>
              ` : `
                <ul style="list-style:none;padding:0;margin:0">
                  ${workedAccs.map(acc => {
                    const isExtra = extraAccs.includes(acc);
                    return `
                      <li style="display:flex;justify-content:space-between;align-items:center;padding:9px 12px;border-bottom:1px solid #F1F5F9;font-size:13px">
                        <b>${escapeHtml(acc)}</b>
                        ${isExtra
                          ? '<span class="tag" style="background:#FEE2E2;color:#991B1B">⚠️ Extra (Unassigned)</span>'
                          : '<span class="tag" style="background:#DCFCE7;color:#15803D">✓ Assigned</span>'}
                      </li>
                    `;
                  }).join('')}
                </ul>
              `)}
            </div>
          </div>
        </div>

        <!-- Account Breakdown Table -->
        <div class="panel">
          <div class="hd">
            <div>
              <h3>📊 Work Breakdown by Account</h3>
              <p>Unique orders, real actions, and sample order codes touched today.</p>
            </div>
          </div>
          ${!isLogUp || (empData.account_breakdown || []).length === 0 ? `
            <div style="text-align:center;padding:30px 20px;color:var(--mut);font-size:13px">
              ${!isLogUp ? 'End-of-Day Log not uploaded. No logged actions to display.' : 'No actions recorded in Daily Log for this employee.'}
            </div>
          ` : `
            <div class="tbl-scroll">
              <table>
                <thead>
                  <tr>
                    <th>Account</th>
                    <th>Assignment</th>
                    <th>Orders Worked</th>
                    <th>Real Actions</th>
                    <th>Latest Status</th>
                    <th>Sample Orders</th>
                  </tr>
                </thead>
                <tbody>
                  ${(empData.account_breakdown || []).map(row => `
                    <tr>
                      <td><b>${escapeHtml(row.account)}</b></td>
                      <td>${row.is_assigned ? '<span class="tag" style="background:#DCFCE7;color:#15803D">Assigned</span>' : '<span class="tag" style="background:#FEE2E2;color:#991B1B">Unassigned</span>'}</td>
                      <td><b>${fmt(row.unique_orders_worked)}</b></td>
                      <td><b>${fmt(row.real_actions)}</b></td>
                      <td>${escapeHtml(row.latest_status || '-')}</td>
                      <td style="font-size:11.5px">
                        ${(row.orders_sample || []).map(code => `
                          <a style="color:var(--blue);cursor:pointer;margin-right:6px;text-decoration:underline" onclick="show('order-tracking');loadOrderTrackingView('${escapeHtml(code)}')">${escapeHtml(code)}</a>
                        `).join('')}
                      </td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            </div>
          `}
        </div>
      `;
    }

    container.innerHTML = html;
  } catch (err) {
    console.error('Error loading Employee Reality Tracking:', err);
    container.innerHTML = `
      <div class="panel" style="text-align:center;padding:40px 20px">
        <div style="font-size:36px;margin-bottom:12px">⚠️</div>
        <h3 style="margin:0 0 8px 0;color:var(--ink);font-size:18px">Employee Reality Tracking could not be loaded.</h3>
        <p style="color:var(--mut);font-size:13px;max-width:500px;margin:0 auto 20px auto">
          <b>Error:</b> ${escapeHtml(err.message || 'Failed to retrieve tracking data')}
        </p>
        <div style="display:flex;justify-content:center;gap:12px">
          <button class="btn primary" onclick="loadEmployeeTrackingView()">↻ Retry</button>
          <button class="btn" onclick="selectDate(getTodayDate())">Return to Today</button>
        </div>
      </div>
    `;
  }
}

window.filterTeamTrackingTable = function(query) {
  const q = String(query || '').trim().toLowerCase();
  const rows = document.querySelectorAll('#teamSummaryTable tbody tr');
  rows.forEach(r => {
    const emp = r.getAttribute('data-emp') || '';
    r.style.display = emp.includes(q) ? '' : 'none';
  });
};

window.selectEmployeeForRealityDetail = function(empId) {
  currentTrackedEmployeeId = empId;
  const select = document.getElementById('empRealitySelect');
  if (select) select.value = empId;
  loadEmployeeTrackingView(empId).then(() => {
    const el = document.getElementById('employeeRealityDetailSection');
    if (el) el.scrollIntoView({ behavior: 'smooth' });
  });
};

async function loadTrackingOverviewView() {
  const container = document.getElementById('trackingOverviewContainer');
  if (!container) return;

  try {
    let overviewData = null;
    try {
      overviewData = await apiFetch(`/api/tracking/overview?date=${currentWorkDate}`);
    } catch(e) {
      overviewData = null;
    }

    if (!overviewData || overviewData.error) {
      container.innerHTML = `
        <div class="panel" style="text-align:center;padding:40px 20px">
          <div style="font-size:36px;margin-bottom:12px">🛡️</div>
          <h3 style="margin:0 0 8px 0;color:var(--ink);font-size:18px">No tracking summary data available for ${formatDisplayDate(currentWorkDate)}.</h3>
          <p style="color:var(--mut);font-size:13px;max-width:500px;margin:0 auto 20px auto">No opening inventory or daily activity recorded for this date.</p>
          <button class="btn" onclick="selectDate(getTodayDate())">Return to Today</button>
        </div>
      `;
      return;
    }

    const op = overviewData.opening_inventory || {};
    const act = overviewData.actual_work || {};
    const audit = overviewData.data_quality_audit || {};
    const sources = overviewData.sources || {};
    const logUploaded = Boolean(overviewData.daily_log_uploaded);

    let html = `
      <!-- Top Source Upload Integrity Status Bar -->
      <div class="panel" style="margin-bottom:20px;padding:16px 20px">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
          <div>
            <h3 style="margin:0 0 4px 0;font-size:17px;color:var(--navy)">🛡️ Global Tracking Overview</h3>
            <p style="margin:0;font-size:12.5px;color:var(--mut)">
              Reconciliation of opening inventory pools against daily actions for <b>${formatDisplayDate(currentWorkDate)}</b>.
            </p>
          </div>
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
            <span class="tag" style="background:${sources.new_orders_uploaded ? '#DCFCE7' : '#FEF3C7'};color:${sources.new_orders_uploaded ? '#15803D' : '#B45309'};font-size:11.5px;font-weight:700">
              ${sources.new_orders_uploaded ? '✓ File #1 (New)' : '⚠️ File #1 Missing'}
            </span>
            <span class="tag" style="background:${sources.pending_orders_uploaded ? '#DCFCE7' : '#FEF3C7'};color:${sources.pending_orders_uploaded ? '#15803D' : '#B45309'};font-size:11.5px;font-weight:700">
              ${sources.pending_orders_uploaded ? '✓ File #2 (Pending)' : '⚠️ File #2 Missing'}
            </span>
            <span class="tag" style="background:${logUploaded ? '#DCFCE7' : '#FEE2E2'};color:${logUploaded ? '#15803D' : '#991B1B'};font-size:11.5px;font-weight:700">
              ${logUploaded ? '✓ Daily Log Uploaded' : '⚠️ Daily Log Not Uploaded'}
            </span>
          </div>
        </div>
      </div>

      <!-- Status Banner if Log Missing -->
      ${!logUploaded ? `
        <div style="background:#F8FAFC;border:1px solid #CBD5E1;border-radius:12px;padding:16px 20px;margin-bottom:20px;display:flex;align-items:center;gap:14px">
          <div style="font-size:24px">📁</div>
          <div>
            <b style="color:#334155;display:block;margin-bottom:2px">End-of-Day Daily Log Not Uploaded</b>
            <p style="font-size:12.5px;color:#64748B;margin:0">
              Opening inventory is ready (${fmt(op.opening_total)} orders), but actual worked metrics and untouched orders require the Daily Log upload.
            </p>
          </div>
        </div>
      ` : ''}

      <!-- Top KPI Grid -->
      <div class="kpis" style="margin-bottom:20px">
        ${kpiCard('📦', fmt(op.opening_total), 'Opening Inventory Pool', `${fmt(op.new_orders)} New · ${fmt(op.pending_orders)} Pending`, NAVY)}
        ${kpiCard('✓', logUploaded ? fmt(act.orders_worked_today) : '—', 'Orders Worked Today', logUploaded ? 'Unique orders touched across team' : 'Log not uploaded', BLUE)}
        ${kpiCard('⏳', logUploaded ? fmt(op.untouched_orders) : '—', 'Untouched Orders', logUploaded ? 'Opening orders with 0 daily log activity' : 'N/A (log not uploaded)', PURPLE)}
        ${kpiCard('⚠️', fmt(audit.orders_in_both_conflict), 'Opening Status Conflicts', 'Existed in both New and Pending', audit.orders_in_both_conflict > 0 ? AMBER : GREEN)}
      </div>

      <!-- Inventory Reconciliation Cards -->
      <div class="grid g2" style="margin-bottom:20px">
        <div class="panel">
          <div class="hd">
            <div>
              <h3>📦 Opening Inventory Breakdown</h3>
              <p>Reconciliation of Specific Orders File #1 and File #2</p>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:10px;text-align:center;padding:12px 0">
            <div style="background:#EFF6FF;padding:12px;border-radius:10px">
              <span style="font-size:11px;color:var(--mut);display:block">New Orders (Slot 1)</span>
              <b style="font-size:18px;color:#1D4ED8">${fmt(op.new_orders)}</b>
            </div>
            <div style="background:#F5F3FF;padding:12px;border-radius:10px">
              <span style="font-size:11px;color:var(--mut);display:block">Pending Orders (Slot 2)</span>
              <b style="font-size:18px;color:#7C3AED">${fmt(op.pending_orders)}</b>
            </div>
            <div style="background:${op.opening_status_conflicts > 0 ? '#FFFBEB' : '#F0FDF4'};padding:12px;border-radius:10px">
              <span style="font-size:11px;color:var(--mut);display:block">Status Conflicts</span>
              <b style="font-size:18px;color:${op.opening_status_conflicts > 0 ? '#B45309' : '#15803D'}">${fmt(op.opening_status_conflicts)}</b>
            </div>
          </div>
        </div>

        <div class="panel">
          <div class="hd">
            <div>
              <h3>⚡ Actual Daily Actions Recorded</h3>
              <p>Processed from End-of-Day Daily Log (120s Deduplication)</p>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:8px;text-align:center;padding:12px 0">
            <div style="background:#F0FDF4;padding:10px;border-radius:8px">
              <span style="font-size:10px;color:var(--mut);display:block">Printed</span>
              <b style="font-size:16px;color:#15803D">${logUploaded ? fmt(act.printed_orders) : '—'}</b>
            </div>
            <div style="background:#F5F3FF;padding:10px;border-radius:8px">
              <span style="font-size:10px;color:var(--mut);display:block">Pending Backlog</span>
              <b style="font-size:16px;color:#7C3AED">${logUploaded ? fmt(act.pending_backlog) : '—'}</b>
            </div>
            <div style="background:#FEF2F2;padding:10px;border-radius:8px">
              <span style="font-size:10px;color:var(--mut);display:block">Cancelled</span>
              <b style="font-size:16px;color:#DC2626">${logUploaded ? fmt(act.cancelled_orders) : '—'}</b>
            </div>
            <div style="background:#FFFBEB;padding:10px;border-radius:8px">
              <span style="font-size:10px;color:var(--mut);display:block">Alt Phone</span>
              <b style="font-size:16px;color:#B45309">${logUploaded ? fmt(act.alt_phones) : '—'}</b>
            </div>
          </div>
        </div>
      </div>

      <!-- Employees Outside Allocation -->
      <div class="panel" style="margin-bottom:20px">
        <div class="hd">
          <div>
            <h3>⚠️ Unassigned Work & Allocation Discrepancies</h3>
            <p>Employees who worked on accounts that were NOT in their manual assignment for today.</p>
          </div>
          <span class="tag" style="background:${(overviewData.employees_outside_allocation || []).length > 0 ? '#FEE2E2' : '#DCFCE7'};color:${(overviewData.employees_outside_allocation || []).length > 0 ? '#991B1B' : '#15803D'};font-weight:700">
            ${(overviewData.employees_outside_allocation || []).length} Discrepancies
          </span>
        </div>
        ${(overviewData.employees_outside_allocation || []).length === 0 ? `
          <p style="font-size:13px;color:#15803D;padding:16px 0;margin:0">✓ Perfect alignment: All employees operated strictly within their assigned accounts.</p>
        ` : `
          <div class="tbl-scroll">
            <table>
              <thead>
                <tr>
                  <th>Employee</th>
                  <th>Assigned Accounts</th>
                  <th>Extra Accounts Worked</th>
                  <th>Outside Orders</th>
                  <th>Outside Actions</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                ${(overviewData.employees_outside_allocation || []).map(row => `
                  <tr>
                    <td><b>${escapeHtml(row.employee_name)}</b></td>
                    <td><span class="tag" style="background:#EFF6FF;color:#1D4ED8">${(row.assigned_accounts || []).join(', ') || 'None'}</span></td>
                    <td><span class="tag" style="background:#FEE2E2;color:#991B1B">${(row.extra_accounts_worked || []).join(', ')}</span></td>
                    <td><b>${fmt(row.orders_worked_outside)}</b></td>
                    <td><b>${fmt(row.real_actions_outside)}</b></td>
                    <td>
                      <button class="btn sm" onclick="show('employee-tracking');loadEmployeeTrackingView('${escapeHtml(row.employee_name)}')">View Reality →</button>
                    </td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        `}
      </div>
    `;

    container.innerHTML = html;
  } catch (err) {
    console.error('Error loading Tracking Overview:', err);
    container.innerHTML = `
      <div class="panel" style="text-align:center;padding:40px 20px">
        <div style="font-size:36px;margin-bottom:12px">⚠️</div>
        <h3 style="margin:0 0 8px 0;color:var(--ink);font-size:18px">Tracking Overview could not be loaded.</h3>
        <p style="color:var(--mut);font-size:13px;max-width:500px;margin:0 auto 20px auto">
          <b>Error:</b> ${escapeHtml(err.message || 'Failed to retrieve overview data')}
        </p>
        <div style="display:flex;justify-content:center;gap:12px">
          <button class="btn primary" onclick="loadTrackingOverviewView()">↻ Retry</button>
          <button class="btn" onclick="selectDate(getTodayDate())">Return to Today</button>
        </div>
      </div>
    `;
  }
}

async function loadTrackingAuditView() {
  const container = document.getElementById('trackingAuditContainer');
  if (!container) return;

  let overviewData = null;
  try {
    overviewData = await apiFetch(`/api/tracking/overview?date=${currentWorkDate}`);
  } catch(e) {
    overviewData = null;
  }

  if (!overviewData || overviewData.error) {
    container.innerHTML = `
      <div class="panel" style="text-align:center;padding:40px">
        <p style="color:var(--mut)">No audit data available for ${formatDisplayDate(currentWorkDate)}.</p>
      </div>
    `;
    return;
  }

  const audit = overviewData.data_quality_audit || {};
  const op = overviewData.opening_inventory || {};
  const logUploaded = overviewData.daily_log_uploaded;
  const sources = overviewData.sources || {};

  let html = `
    <!-- Top Audit Header -->
    <div class="panel" style="margin-bottom:20px;padding:16px 20px">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
        <div>
          <h3 style="margin:0 0 4px 0;font-size:17px;color:var(--navy)">📋 Tracking & Quality Audit</h3>
          <p style="margin:0;font-size:12.5px;color:var(--mut)">
            Rigorous data integrity check across opening inventory, status conflicts, and unmatched daily log orders.
          </p>
        </div>
        <div style="display:flex;gap:8px">
          <button class="btn sm" onclick="show('tracking-overview')">← Overview</button>
          <button class="btn sm" onclick="show('employee-tracking')">Employee Reality</button>
        </div>
      </div>
    </div>

    <!-- Audit KPI Cards -->
    <div class="kpis" style="margin-bottom:20px">
      ${kpiCard('⚠️', fmt(audit.conflicting_opening_orders_count), 'Opening Conflicts', 'Present in both File #1 & #2', audit.conflicting_opening_orders_count > 0 ? AMBER : GREEN)}
      ${kpiCard('🔍', fmt(audit.unmatched_order_codes_count), 'Unmatched Daily Log Orders', 'Logged but missing from inventory', audit.unmatched_order_codes_count > 0 ? AMBER : GREEN)}
      ${kpiCard('⏳', logUploaded ? fmt(audit.orders_without_daily_log) : '—', 'Untouched Opening Orders', logUploaded ? 'Zero Daily Log actions' : 'Log not uploaded', PURPLE)}
      ${kpiCard('✓', logUploaded ? fmt(audit.orders_with_daily_log) : '—', 'Touched Opening Orders', logUploaded ? 'Had at least 1 action' : 'Log not uploaded', BLUE)}
    </div>

    <!-- Audit Details Grid -->
    <div class="grid g2" style="margin-bottom:20px">
      <!-- Opening Status Conflicts List -->
      <div class="panel">
        <div class="hd">
          <div>
            <h3>⚠️ Opening Status Conflicts (${audit.conflicting_opening_orders_count || 0})</h3>
            <p>Orders present in both File #1 (New) and File #2 (Pending).</p>
          </div>
        </div>
        <div>
          ${(!audit.conflicting_opening_orders_sample || audit.conflicting_opening_orders_sample.length === 0) ? `
            <p style="font-size:12.5px;color:#15803D;padding:14px 0;margin:0">✓ No conflicting opening orders found. Clean opening separation.</p>
          ` : `
            <ul style="list-style:none;padding:0;margin:0">
              ${audit.conflicting_opening_orders_sample.map(code => `
                <li style="display:flex;justify-content:space-between;align-items:center;padding:9px 12px;border-bottom:1px solid #F1F5F9;font-size:13px">
                  <b>${code}</b>
                  <button class="btn sm" onclick="show('order-tracking');loadOrderTrackingView('${code}')">Track Lifecycle →</button>
                </li>
              `).join('')}
            </ul>
          `}
        </div>
      </div>

      <!-- Unmatched Daily Log Orders List -->
      <div class="panel">
        <div class="hd">
          <div>
            <h3>🔍 Unmatched Daily Log Orders (${audit.unmatched_order_codes_count || 0})</h3>
            <p>Orders logged in Daily Log but not present in opening inventory.</p>
          </div>
        </div>
        <div>
          ${(!audit.unmatched_order_codes_sample || audit.unmatched_order_codes_sample.length === 0) ? `
            <p style="font-size:12.5px;color:#15803D;padding:14px 0;margin:0">✓ All Daily Log orders matched opening inventory.</p>
          ` : `
            <ul style="list-style:none;padding:0;margin:0">
              ${audit.unmatched_order_codes_sample.map(code => `
                <li style="display:flex;justify-content:space-between;align-items:center;padding:9px 12px;border-bottom:1px solid #F1F5F9;font-size:13px">
                  <b>${code}</b>
                  <button class="btn sm" onclick="show('order-tracking');loadOrderTrackingView('${code}')">Track Lifecycle →</button>
                </li>
              `).join('')}
            </ul>
          `}
        </div>
      </div>
    </div>
  `;

  container.innerHTML = html;
}

// -------------------------------------------------------------
// DASHBOARD VIEWS GENERATOR
// -------------------------------------------------------------
function pages(){
  const hr=D.hr||{},st=D.status_totals||{},tot=D.log_totals||{},ded=D.dedup||{};
  const dops=tot.actions||1;
  const pctv=x=>((x||0)/dops*100);
  const p1=pctv(st.Printed),p2=p1+pctv(st.Pending),p3=p2+pctv(st.Processing);
  const donutBg=`conic-gradient(${GREEN} 0 ${p1}%,${PURPLE} ${p1}% ${p2}%,${AMBER} ${p2}% ${p3}%,${RED} ${p3}% 100%)`;

  const dedupBanner=`
    <div class="dedup-banner">
      <div class="di">⚡</div>
      <div class="dt">
        <b>Deduplication Engine Active</b>
        <p>Each real status change is counted once per <b>order code + employee + status</b> within a 2-minute window. Removed <b>${fmt(ded.removed)}</b> duplicate rows (${ded.removed_pct}% of raw status logs).</p>
      </div>
      <div class="dm">
        <b>−${ded.removed_pct}%</b>
        <span>raw rows removed</span>
      </div>
    </div>
  `;

  // Top 10 by Performance Score vs Most Active (Part 9, 31)
  const top10ByScore = [...(D.employees||[])].sort((a,b)=>b.performance_score - a.performance_score).slice(0,10);
  const top10ByActions = [...(D.employees||[])].sort((a,b)=>b.actions - a.actions).slice(0,10);

  const overview = dedupBanner + `
    <div class="kpis">
      ${kpiCard('▤',fmt(dops),'Total Real Actions',`Across <b>${D.employees.length}</b> agents · Deduplicated`,NAVY)}
      ${kpiCard('📦',fmt(hr.tot_new),'Total New Orders',`Unique order codes created`,BLUE)}
      ${kpiCard('✓',fmt(st.Printed),'Printed Orders',`<b>${pctv(st.Printed).toFixed(1)}%</b> of actions`,GREEN)}
      ${kpiCard('✕',fmt(st.Cancelled),'Cancelled Orders',`<b>${D.team_cancel_rate}%</b> cancel rate`,RED)}
    </div>
    <div class="kpis">
      ${kpiCard('⏳',fmt(st.Pending),'Current Pending Backlog',`<b>${D.team_pending_rate}%</b> queue volume`,PURPLE)}
      ${kpiCard('⧗',fmt(st.Processing),'Processing Orders',`<b>${pctv(st.Processing).toFixed(1)}%</b> of actions`,AMBER)}
      ${kpiCard('☎',fmt(tot.alt),'Alt Phones Added','Deduplicated phone updates',BLUE)}
      ${kpiCard('★',initials(top10ByScore[0]?.name||''),'Top Performer',`<b>${top10ByScore[0]?.name||'-'}</b> (Score: ${top10ByScore[0]?.performance_score||0})`,GREEN)}
    </div>

    <div class="grid g2">
      <div class="panel">
        <div class="hd">
          <div>
            <h3>★ Top 10 Performers <span class="tag" style="background:#DCFCE7;color:#15803D">KPI Score</span></h3>
            <p>Ranked strictly by Performance Score (Avoids double-counting)</p>
          </div>
        </div>
        ${barList(top10ByScore.map(e=>({name: `${e.name} [${e.grade}]`, value: e.performance_score})), 100, GREEN, v=>v.toFixed(1))}
      </div>

      <div class="panel">
        <div class="hd">
          <div>
            <h3>Status Distribution</h3>
            <p>Unique actions breakdown — includes Pending</p>
          </div>
        </div>
        <div class="donut-wrap">
          <div class="donut" style="background:${donutBg}">
            <div class="ctr"><b>${fmt(dops)}</b><span>Actions</span></div>
          </div>
          <div class="leg">
            <div class="li"><span class="dot" style="background:${GREEN}"></span><span class="lt">Printed</span><span class="lv">${fmt(st.Printed)}<span class="lp">${pctv(st.Printed).toFixed(1)}%</span></span></div>
            <div class="li"><span class="dot" style="background:${PURPLE}"></span><span class="lt">Pending</span><span class="lv">${fmt(st.Pending)}<span class="lp">${pctv(st.Pending).toFixed(1)}%</span></span></div>
            <div class="li"><span class="dot" style="background:${AMBER}"></span><span class="lt">Processing</span><span class="lv">${fmt(st.Processing)}<span class="lp">${pctv(st.Processing).toFixed(1)}%</span></span></div>
            <div class="li"><span class="dot" style="background:${RED}"></span><span class="lt">Cancelled</span><span class="lv">${fmt(st.Cancelled)}<span class="lp">${pctv(st.Cancelled).toFixed(1)}%</span></span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid g2">
      <div class="panel">
        <div class="hd">
          <div>
            <h3>⚡ Most Active Agents</h3>
            <p>By total real (deduplicated) action events</p>
          </div>
        </div>
        ${barList(top10ByActions.map(e=>({name: e.name, value: e.actions})), null, NAVY)}
      </div>

      <div class="panel">
        <div class="hd">
          <div>
            <h3>Daily Volume Trend</h3>
            <p>New vs Printed Orders</p>
          </div>
        </div>
        ${lineChart(D.daily||[],['new','printed'],[BLUE,GREEN],['New','Printed'],false)}
      </div>
    </div>
  `;

  // Work Allocation view
  const workAllocation = `<div id="workAllocContainer"></div>`;
  const allocationHistory = `<div id="allocHistoryContainer"></div>`;
  const currentOrders = `<div id="currentOrdersContainer"></div>`;
  const workingTeam = `<div id="workingTeamContainer"></div>`;
  const teamMembers = `<div id="teamMembersContainer"></div>`;

  // Daily Trend
  const daily = `
    <div class="kpis">
      ${kpiCard('📦',fmt(hr.tot_new),'Total New Orders',`${hr.days} days recorded`,BLUE)}
      ${kpiCard('✓',fmt(hr.tot_printed),'Total Printed',`${(hr.tot_printed/hr.tot_new*100).toFixed(1)}% printing rate`,GREEN)}
      ${kpiCard('✕',fmt(hr.tot_cancel),'Total Cancelled',`${(hr.tot_cancel/hr.tot_new*100).toFixed(1)}% cancel rate`,RED)}
      ${kpiCard('＋',fmt(hr.tot_add),'Total Numbers Added',`${(hr.tot_add/hr.tot_new*100).toFixed(1)}% of new orders`,BLUE)}
    </div>
    <div class="panel">
      <div class="hd"><h3>Daily Order Volume</h3><p>New · Printed · Cancelled across ${hr.days} days</p></div>
      ${lineChart(D.daily||[],['new','printed','cancel'],[BLUE,GREEN,RED],['New','Printed','Cancelled'],false)}
    </div>
    <div class="grid g2e">
      <div class="panel"><div class="hd"><h3>Daily Printing Rate %</h3><p>Daily efficiency</p></div>${lineChart(D.daily||[],['printed_pct'],[GREEN],['Printed %'],true)}</div>
      <div class="panel"><div class="hd"><h3>Daily Cancellation Rate %</h3><p>Lower is better</p></div>${lineChart(D.daily||[],['cancel_pct'],[RED],['Cancel %'],true)}</div>
    </div>
  `;

  // Cancellation Analysis
  const cr = D.cancel_rate_rank || [];
  const highRisk = (D.employees||[]).filter(e=>e.cancel_risk==='High').length;
  const cancel = `
    <div class="kpis">
      ${kpiCard('✕',fmt(tot.cancelled),'Total Cancelled','Deduplicated status actions',RED)}
      ${kpiCard('%',D.team_cancel_rate+'%','Team Cancel Rate','Of all real actions',AMBER)}
      ${kpiCard('⚠',highRisk,'High-Risk Agents','Rate ≥ 1.5× team average',RED)}
      ${kpiCard('▲',cr[0]?.value+'%','Highest Individual',`<b>${cr[0]?.name||'-'}</b>`,RED)}
    </div>
    <div class="grid g2">
      <div class="panel">
        <div class="hd"><h3>Cancellation Rate per Agent %</h3><p>Cancelled ÷ that agent's total actions</p></div>
        <div class="bars">${cr.map((e,i)=>{
          const col=e.value>=D.team_cancel_rate*1.5?RED:e.value>=D.team_cancel_rate*1.15?AMBER:GREEN;
          return `<div class="bar-row"><div class="nm"><span class="rk ${i<3?'g'+(i+1):''}">${i+1}</span>${e.name}</div><div class="bar-track"><div class="bar-fill" style="width:0" data-w="${Math.min(e.value*1.6,100)}" data-c="${col}"></div></div><div class="vv" style="color:${col}">${e.value}%</div></div>`;
        }).join('')}</div>
      </div>
      <div class="panel">
        <div class="hd"><h3>Highest Cancelled Volume</h3><p>Absolute deduplicated count</p></div>
        ${barList(D.rankings.cancelled,null,RED)}
      </div>
    </div>
  `;

  // Scorecard (Rank by Performance Score)
  const scorecard = `
    <div class="panel">
      <div class="hd">
        <div>
          <h3>★ Executive Scorecard</h3>
          <p>Ranked strictly by Performance Score (Avoids double-counting)</p>
        </div>
      </div>
      <div class="tbl-scroll">
        <table>
          <thead>
            <tr>
              <th>Rank</th>
              <th>Employee</th>
              <th>Score</th>
              <th>Grade</th>
              <th>Segment</th>
              <th>Real Actions</th>
              <th>Printed %</th>
              <th>Pending %</th>
              <th>Cancel %</th>
              <th>Risk Tier</th>
            </tr>
          </thead>
          <tbody>
            ${(D.employees||[]).map(e=>`
              <tr>
                <td><span class="rk ${e.rank<=3?'g'+e.rank:''}">${e.rank}</span></td>
                <td class="nm-cell">${e.name}</td>
                <td>${scoreCell(e.performance_score)}</td>
                <td><span class="grade gr-${e.grade[0]}">${e.grade}</span></td>
                <td><span class="seg seg-${segClass(e.segment)}">${e.segment}</span></td>
                <td><b>${fmt(e.actions)}</b></td>
                <td><span style="color:${GREEN};font-weight:700">${e.own_printed_rate}%</span></td>
                <td><span style="color:${PURPLE};font-weight:600">${e.own_pending_rate}%</span></td>
                <td><b style="color:${e.own_cancel_rate>=D.team_cancel_rate*1.5?RED:'var(--slate)'}">${e.own_cancel_rate}%</b></td>
                <td><span class="risk risk-${riskClass(e.cancel_risk)}">${e.cancel_risk}</span></td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    </div>
  `;

  // Added Orders: CS ONLY for Top Contributors (Part 23, 33, 60, 85)
  let allCSContributors = [];
  if (Array.isArray(D.allCSContributors) && D.allCSContributors.length > 0) {
    allCSContributors = D.allCSContributors;
  } else if (Array.isArray(D.topCSContributors) && D.topCSContributors.length > 0) {
    allCSContributors = D.topCSContributors;
  } else if (Array.isArray(D.addedOrders?.allCSContributors) && D.addedOrders.allCSContributors.length > 0) {
    allCSContributors = D.addedOrders.allCSContributors;
  } else if (Array.isArray(D.addedOrders?.topCSContributors) && D.addedOrders.topCSContributors.length > 0) {
    allCSContributors = D.addedOrders.topCSContributors;
  } else if (Array.isArray(D.employees)) {
    allCSContributors = D.employees
      .filter(e => (e.added > 0) && (e.is_cs || e.department === 'CS' || isCSName(e.name)))
      .map(e => ({
        name: e.name,
        employee: e.name,
        value: e.added,
        count: e.added,
        is_cs: true,
      }))
      .sort((a, b) => b.value - a.value);
  }

  // Standardize properties and sort descending
  allCSContributors = allCSContributors.map(c => {
    const empName = c.employee || c.name || '';
    const cnt = c.count !== undefined ? c.count : (c.value || 0);
    return {
      name: empName,
      employee: empName,
      value: cnt,
      count: cnt,
      is_cs: true,
    };
  }).sort((a, b) => b.value - a.value);

  const topCSAdded = allCSContributors.slice(0, 15);
  const topCS = allCSContributors[0] || D.topCSContributor || D.addedOrders?.topCSContributor || null;
  const topCSName = topCS ? (topCS.employee || topCS.name || '-') : '-';
  const topCSCount = topCS ? (topCS.count !== undefined ? topCS.count : (topCS.value || 0)) : 0;

  const fromCS = D.fromCS ?? D.added_cs ?? (D.addedOrders?.fromCS ?? 0);
  const fromOther = D.fromOtherDepartments ?? D.added_noncs ?? (D.addedOrders?.fromOtherDepartments ?? 0);
  const totalAdded = fromCS + fromOther;

  const orders = `
    <div class="kpis">
      ${kpiCard('＋',fmt(totalAdded),'Total Added Orders','All departments · Unique codes',NAVY)}
      ${kpiCard('◉',fmt(fromCS),'From CS',totalAdded > 0 ? `${(fromCS/totalAdded*100).toFixed(1)}%` : '0%',BLUE)}
      ${kpiCard('◫',fmt(fromOther),'From Other Depts',totalAdded > 0 ? `${(fromOther/totalAdded*100).toFixed(1)}%` : '0%',GREEN)}
      ${kpiCard('★',topCS ? initials(topCSName) : '-','Top CS Contributor',topCS ? `<b>${topCSName}</b> · ${fmt(topCSCount)}` : '<b>-</b> · 0',AMBER)}
    </div>
    <div class="grid g2">
      <div class="panel">
        <div class="hd">
          <div>
            <h3>Top Added-Order Contributors <span class="tag" style="background:#DCFCE7;color:#15803D">CS ONLY</span></h3>
            <p>Counts CS employees only · Ranked strictly by added orders</p>
          </div>
        </div>
        ${topCSAdded.length > 0
          ? barList(topCSAdded.map(e => ({ name: e.name, value: e.value })), null, null)
          : '<div style="padding:36px;text-align:center;color:var(--mut);font-size:13px">No CS employee-level added-order records available.</div>'
        }
      </div>
      <div class="panel">
        <div class="hd"><h3>CS vs Other Departments</h3><p>Where new orders originate</p></div>
        <div class="donut-wrap">
          <div class="donut" style="background:conic-gradient(${BLUE} 0 ${totalAdded > 0 ? (fromCS / totalAdded * 100) : 0}%,${GREEN} ${totalAdded > 0 ? (fromCS / totalAdded * 100) : 0}% 100%)">
            <div class="ctr"><b>${fmt(totalAdded)}</b><span>Orders</span></div>
          </div>
          <div class="leg">
            <div class="li"><span class="dot" style="background:${BLUE}"></span><span class="lt">CS Department</span><span class="lv">${fmt(fromCS)}<span class="lp">${totalAdded > 0 ? (fromCS / totalAdded * 100).toFixed(1) : 0}%</span></span></div>
            <div class="li"><span class="dot" style="background:${GREEN}"></span><span class="lt">Other Depts (Data Entry)</span><span class="lv">${fmt(fromOther)}<span class="lp">${totalAdded > 0 ? (fromOther / totalAdded * 100).toFixed(1) : 0}%</span></span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="panel" style="margin-top:16px">
      <div class="hd">
        <div>
          <h3>CS Added-Orders Contributor Breakdown <span class="tag" style="background:#DBEAFE;color:#1D4ED8">${allCSContributors.length} Employees</span></h3>
          <p>Complete audit of all CS employee contributor rows · Sum reconciles to From CS total</p>
        </div>
        <div class="search" style="max-width:260px">
          <span class="si">🔍</span>
          <input type="text" id="csAddedSearch" placeholder="Filter CS employee..." oninput="filterCSAddedTable(this.value)">
        </div>
      </div>
      <div class="tbl-scroll" style="max-height:420px;overflow-y:auto">
        <table id="csAddedTable">
          <thead>
            <tr>
              <th style="width:60px">#</th>
              <th>Employee Name</th>
              <th style="text-align:right">Added Orders</th>
              <th style="text-align:right">% of CS Added</th>
              <th style="text-align:right">% of Total Added</th>
            </tr>
          </thead>
          <tbody>
            ${allCSContributors.length > 0 ? allCSContributors.map((e, idx) => `
              <tr data-emp="${e.name.toLowerCase()}">
                <td><span class="rk ${idx < 3 ? 'g' + (idx + 1) : ''}">${idx + 1}</span></td>
                <td class="nm-cell">${e.name}</td>
                <td style="text-align:right;font-weight:700">${fmt(e.value)}</td>
                <td style="text-align:right;color:var(--mut)">${fromCS > 0 ? ((e.value / fromCS) * 100).toFixed(1) : 0}%</td>
                <td style="text-align:right;color:var(--mut)">${totalAdded > 0 ? ((e.value / totalAdded) * 100).toFixed(1) : 0}%</td>
              </tr>
            `).join('') : `
              <tr>
                <td colspan="5" style="text-align:center;padding:36px;color:var(--mut)">No CS employee-level added-order records available.</td>
              </tr>
            `}
          </tbody>
          ${allCSContributors.length > 0 ? `
          <tfoot>
            <tr style="font-weight:800;background:var(--panel2);border-top:2px solid var(--line)">
              <td colspan="2" style="padding:10px 12px">Total CS Contributors (${allCSContributors.length})</td>
              <td style="text-align:right;padding:10px 12px;color:var(--navy)">${fmt(fromCS)}</td>
              <td style="text-align:right;padding:10px 12px">100.0%</td>
              <td style="text-align:right;padding:10px 12px">${totalAdded > 0 ? ((fromCS / totalAdded) * 100).toFixed(1) : 0}%</td>
            </tr>
          </tfoot>
          ` : ''}
        </table>
      </div>
    </div>
  `;

  // Existing other views
  const pendEmp=[...(D.employees||[])].filter(e=>e.pending>0).sort((a,b)=>b.own_pending_rate-a.own_pending_rate);
  const pending=`
    <div class="kpis">
      ${kpiCard('⏳',fmt(tot.pending),'Current Pending Backlog','Orders currently in pending queue',PURPLE)}
      ${kpiCard('%',D.team_pending_rate+'%','Pending Rate','Of all actions',BLUE)}
      ${kpiCard('◉',pendEmp.length,'Agents with Pending',`Of ${D.employees.length}`,NAVY)}
      ${kpiCard('▲',pendEmp[0]?pendEmp[0].own_pending_rate+'%':'-','Highest Own Rate',`<b>${pendEmp[0]?.name||''}</b>`,PURPLE)}
    </div>
    <div class="grid g2">
      <div class="panel">
        <div class="hd"><h3>Pending Rate per Agent %</h3><p>Pending ÷ that agent's total actions</p></div>
        <div class="bars">${pendEmp.slice(0,12).map((e,i)=>`<div class="bar-row"><div class="nm"><span class="rk ${i<3?'g'+(i+1):''}">${i+1}</span>${e.name}</div><div class="bar-track"><div class="bar-fill" style="width:0" data-w="${Math.min(e.own_pending_rate*1.6,100)}" data-c="${PURPLE}"></div></div><div class="vv">${e.own_pending_rate}%</div></div>`).join('')}</div>
      </div>
      <div class="panel">
        <div class="hd"><h3>Highest Pending Volume</h3><p>Count of orders left pending</p></div>
        ${barList(D.rankings.pending,null,PURPLE)}
      </div>
    </div>
  `;

  const prEmp=[...(D.employees||[])].filter(e=>e.printed>0).sort((a,b)=>b.own_printed_rate-a.own_printed_rate);
  const printed=`
    <div class="kpis">
      ${kpiCard('✓',fmt(tot.printed),'Total Printed Orders','Deduplicated print executions',GREEN)}
      ${kpiCard('%',(tot.printed/tot.actions*100).toFixed(1)+'%','Team Print Rate','Of all actions',GREEN)}
      ${kpiCard('◉',prEmp.length,'Agents Printing',`Of ${D.employees.length}`,NAVY)}
      ${kpiCard('▲',prEmp[0]?prEmp[0].own_printed_rate+'%':'-','Highest Own Rate',`<b>${prEmp[0]?.name||''}</b>`,GREEN)}
    </div>
    <div class="grid g2">
      <div class="panel">
        <div class="hd"><h3>Printing Rate per Agent %</h3><p>Printed ÷ that agent's total actions</p></div>
        <div class="bars">${prEmp.filter(e=>e.actions>=50).slice(0,12).map((e,i)=>`<div class="bar-row"><div class="nm"><span class="rk ${i<3?'g'+(i+1):''}">${i+1}</span>${e.name}</div><div class="bar-track"><div class="bar-fill" style="width:0" data-w="${e.own_printed_rate}" data-c="${GREEN}"></div></div><div class="vv">${e.own_printed_rate}%</div></div>`).join('')}</div>
      </div>
      <div class="panel">
        <div class="hd"><h3>Highest Printed Volume</h3><p>Absolute count</p></div>
        ${barList(D.rankings.printed,null,GREEN)}
      </div>
    </div>
  `;

  const altEmp=(D.employees||[]).filter(e=>e.alt>0).sort((a,b)=>b.alt-a.alt);
  const phone=`
    <div class="kpis">
      ${kpiCard('☎',fmt(tot.alt),'Total Alt Phones Added','Deduplicated corrections',BLUE)}
      ${kpiCard('◉',altEmp.length,'Agents Involved',`Of ${D.employees.length}`,NAVY)}
      ${kpiCard('▲',altEmp[0]?altEmp[0].own_alt_rate+'%':'-','Highest Own Rate',`<b>${altEmp[0]?.name||''}</b>`,BLUE)}
      ${kpiCard('★',altEmp[0]?.name||'-','Top Alt Contributor',`${altEmp[0]?.alt||0} corrections`,NAVY)}
    </div>
    <div class="grid g2">
      <div class="panel">
        <div class="hd"><h3>Alt Phone Rate per Agent %</h3><p>Alt-phone corrections ÷ total actions</p></div>
        <div class="bars">${altEmp.slice(0,12).map((e,i)=>`<div class="bar-row"><div class="nm"><span class="rk ${i<3?'g'+(i+1):''}">${i+1}</span>${e.name}</div><div class="bar-track"><div class="bar-fill" style="width:0" data-w="${Math.min(e.own_alt_rate*3,100)}" data-c="${BLUE}"></div></div><div class="vv">${e.own_alt_rate}%</div></div>`).join('')}</div>
      </div>
      <div class="panel">
        <div class="hd"><h3>Alt Phone Volume & Share</h3><p>Count and share of all corrections</p></div>
        ${barList(altEmp.slice(0,10).map(e=>({name:e.name,value:e.alt})),null,BLUE)}
      </div>
    </div>
  `;

  const employees=`<div class="prof-grid">${(D.employees||[]).map((e,i)=>profileCard(e,i)).join('')}</div>`;
  const insights=`
    <div class="grid g2">
      <div class="panel">
        <div class="hd"><h3>◈ Executive Insights</h3><p>From deduplicated operational events</p></div>
        ${(D.insights||[]).map((t,i)=>`<div class="ins"><div class="n">${i+1}</div><p>${t}</p></div>`).join('')}
      </div>
      <div class="panel">
        <div class="hd"><h3>⚑ Key Observations</h3><p>Cancellation · Backlog · Trends</p></div>
        ${(D.observations||[]).map(o=>`<div class="obs"><div class="th"><span class="b">${o[0]}</span><span class="chip">Attention</span></div><p>${o[1]}</p></div>`).join('')}
      </div>
    </div>
  `;

  const dataP=`
    <div class="panel">
      <div class="tbl-tools">
        <div class="search"><span class="si">⌕</span><input id="tSearch" placeholder="Search employee…" oninput="filterTable()"></div>
        <select class="filter" id="tSeg" onchange="filterTable()"><option value="">All Segments</option><option>Top Performer</option><option>Core Contributor</option><option>Developing</option><option>Needs Attention</option></select>
        <select class="filter" id="tRisk" onchange="filterTable()"><option value="">All Cancel Risk</option><option>High</option><option>Elevated</option><option>Normal</option></select>
      </div>
      <div class="tbl-scroll">
        <table id="mainTable">
          <thead>
            <tr>
              ${['#','Employee','Actions','Printed','Print%','Pending','Pend%','Processing','Cancelled','Cancel%','Alt','Alt%','Added','Contrib%','Grade'].map((h,i)=>`<th onclick="sortTable(${i})">${h}</th>`).join('')}
            </tr>
          </thead>
          <tbody id="tBody">${tableRows(D.employees||[])}</tbody>
        </table>
      </div>
      <p style="font-size:11px;color:var(--mut);margin-top:12px">Showing <b id="tCount">${(D.employees||[]).length}</b> agents · Click column headers to sort</p>
    </div>
  `;

  const hasPerf = D && D.exists !== false && Array.isArray(D.employees) && D.employees.length > 0;
  const hasAdded = (totalAdded > 0) || (allCSContributors.length > 0);
  const emptyPerf = (tabName, icon) => renderEmptyState(`No ${tabName} for ${formatDisplayDate(currentWorkDate)}`, `No Daily Log performance records available for this date.`, icon);

  return {
    overview: hasPerf ? overview : renderEmptyState(`No Performance Data for ${formatDisplayDate(currentWorkDate)}`, 'No Daily Log performance snapshot was recorded for this date.', '📊'),
    'work-allocation': workAllocation,
    'account-config': `<div id="accountConfigContainer"><div style="text-align:center;padding:40px;color:var(--mut)">Loading Account Configuration...</div></div>`,
    'allocation-history': allocationHistory,
    'current-orders': currentOrders,
    'accounts': `<div id="accountsDirectoryContainer"><div style="text-align:center;padding:40px;color:var(--mut)">Loading Accounts Directory...</div></div>`,
    'order-tracking': `<div id="orderTrackingContainer"><div style="text-align:center;padding:40px;color:var(--mut)">Loading Order Tracking...</div></div>`,
    'employee-tracking': `<div id="employeeTrackingContainer"><div style="text-align:center;padding:40px;color:var(--mut)">Loading Employee Reality Tracking...</div></div>`,
    'tracking-overview': `<div id="trackingOverviewContainer"><div style="text-align:center;padding:40px;color:var(--mut)">Loading Tracking Overview...</div></div>`,
    'tracking-audit': `<div id="trackingAuditContainer"><div style="text-align:center;padding:40px;color:var(--mut)">Loading Tracking & Quality Audit...</div></div>`,
    'team-setup': `<div id="teamSetupContainer"><div style="text-align:center;padding:40px;color:var(--mut)">Loading Team Setup...</div></div>`,
    'working-team': workingTeam,
    'team-members': teamMembers,
    daily: hasPerf ? daily : emptyPerf('Daily Trend', '📈'),
    cancel: hasPerf ? cancel : emptyPerf('Cancellation Data', '✕'),
    pending: hasPerf ? pending : emptyPerf('Pending Queue Data', '⏳'),
    printed: hasPerf ? printed : emptyPerf('Printed Orders Data', '✓'),
    phone: hasPerf ? phone : emptyPerf('Phone Updates Data', '☎'),
    employees: hasPerf ? employees : emptyPerf('Employee Profiles', '👥'),
    orders: hasAdded ? orders : renderEmptyState(`No Added Orders for ${formatDisplayDate(currentWorkDate)}`, 'No order additions recorded for this date.', '📦'),
    insights: hasPerf ? insights : emptyPerf('Executive Insights', '💡'),
    scorecard: hasPerf ? scorecard : emptyPerf('Executive Scorecard', '★'),
    data: hasPerf ? dataP : emptyPerf('Dataset Records', '📋')
  };
}

function profileCard(e,i){
  const col=AV[i%AV.length];const t=e.printed+e.pending+e.processing+e.cancelled||1;
  return `
    <div class="prof">
      <div class="ph"><div class="av" style="background:linear-gradient(135deg,${col},${col}cc)">${initials(e.name)}</div>
        <div style="flex:1"><div class="pn">${e.name}</div><div class="pr">Rank #${e.rank} · <span class="grade gr-${e.grade[0]}" style="padding:1px 7px">${e.grade}</span> · ${e.segment}</div></div>
      </div>
      <div class="stats">
        <div class="st"><b>${fmt(e.actions)}</b><span>ACTIONS</span></div>
        <div class="st"><b>${e.printed}</b><span>PRINTED</span></div>
        <div class="st"><b>${e.pending}</b><span>PENDING</span></div>
        <div class="st" style="background:${e.cancelled>0?'#FEF2F2':'var(--panel2)'}"><b style="color:${RED}">${e.cancelled}</b><span>CANCEL</span></div>
      </div>
      <div class="stack">
        <div class="sg" style="background:${GREEN};width:${e.printed/t*100}%">${e.printed/t>0.1?e.printed:''}</div>
        <div class="sg" style="background:${PURPLE};width:${e.pending/t*100}%">${e.pending/t>0.1?e.pending:''}</div>
        <div class="sg" style="background:${AMBER};width:${e.processing/t*100}%"></div>
        <div class="sg" style="background:${RED};width:${e.cancelled/t*100}%">${e.cancelled/t>0.1?e.cancelled:''}</div>
      </div>
      <div class="metric"><div class="ml"><span>Printed rate (own)</span><b>${e.own_printed_rate}%</b></div><div class="pbar"><i style="width:${e.own_printed_rate}%;background:${GREEN}"></i></div></div>
      <div class="metric"><div class="ml"><span>Pending rate (own)</span><b>${e.own_pending_rate}%</b></div><div class="pbar"><i style="width:${Math.min(e.own_pending_rate*2,100)}%;background:${PURPLE}"></i></div></div>
      <div class="metric"><div class="ml"><span>Cancel rate (own)</span><b style="color:${e.own_cancel_rate>=D.team_cancel_rate*1.5?RED:'var(--slate)'}">${e.own_cancel_rate}%</b></div><div class="pbar"><i style="width:${Math.min(e.own_cancel_rate*2,100)}%;background:${e.own_cancel_rate>=D.team_cancel_rate*1.5?RED:AMBER}"></i></div></div>
      <div class="metric"><div class="ml"><span>Alt-phone rate (own)</span><b>${e.own_alt_rate}%</b></div><div class="pbar"><i style="width:${Math.min(e.own_alt_rate*3,100)}%;background:${BLUE}"></i></div></div>
    </div>
  `;
}

function tableRows(list){
  return list.map(e=>`
    <tr data-seg="${e.segment}" data-risk="${e.cancel_risk}" data-name="${e.name.toLowerCase()}">
      <td><span class="rk ${e.rank<=3?'g'+e.rank:''}">${e.rank}</span></td>
      <td class="nm-cell">${e.name}</td>
      <td>${fmt(e.actions)}</td>
      <td>${fmt(e.printed)}</td>
      <td><b style="color:${GREEN}">${e.own_printed_rate}%</b></td>
      <td>${fmt(e.pending)}</td>
      <td><b style="color:${PURPLE}">${e.own_pending_rate}%</b></td>
      <td>${fmt(e.processing)}</td>
      <td>${fmt(e.cancelled)}</td>
      <td><b style="color:${e.own_cancel_rate>=D.team_cancel_rate*1.5?RED:'var(--slate)'}">${e.own_cancel_rate}%</b></td>
      <td>${e.alt}</td>
      <td><b style="color:${BLUE}">${e.own_alt_rate}%</b></td>
      <td>${e.added}</td>
      <td>${e.contribution_pct}%</td>
      <td><span class="grade gr-${e.grade[0]}">${e.grade}</span></td>
    </tr>
  `).join('');
}

window.filterTable=function(){
  const q=(document.getElementById('tSearch').value||'').toLowerCase();
  const sg=document.getElementById('tSeg').value,rk=document.getElementById('tRisk').value;let n=0;
  document.querySelectorAll('#tBody tr').forEach(r=>{
    const ok=r.dataset.name.includes(q)&&(!sg||r.dataset.seg===sg)&&(!rk||r.dataset.risk===rk);
    r.style.display=ok?'':'none';if(ok)n++;
  });
  document.getElementById('tCount').textContent=n;
};

let sortState={};
window.sortTable=function(col){
  const tb=document.getElementById('tBody');const rows=[...tb.querySelectorAll('tr')];
  const dir=sortState[col]=-(sortState[col]||1);const num=c=>parseFloat(c.replace(/[^0-9.\-]/g,''))||0;
  rows.sort((a,b)=>{let x=a.children[col].textContent,y=b.children[col].textContent;if(col===1)return dir*x.localeCompare(y);return dir*(num(x)-num(y));});
  rows.forEach(r=>tb.appendChild(r));
};

let RENDERED={},currentPage='overview';
const TITLES={
  overview:['Executive Overview','Customer Service — Deduplicated Performance & Quality'],
  'work-allocation':['Manual Work Allocation','Controlled Daily Task Assignment (No Auto-Assignment)'],
  'account-config':['Account Configuration','Account-Specific Eligibility Rules & Date Exceptions'],
  'allocation-history':['Allocation History','Audit Trail of Assigned Accounts & Statuses'],
  'current-orders':['Current Active Work Pool','Browse Accounts Extracted from Specific Orders'],
  accounts:['Accounts Directory','Date-Aware Account Inventory, Actual Touches & Audit'],
  'order-tracking':['Order Tracking & Lifecycle','Full Chronological Audit Trail & Multi-Employee Touches'],
  'employee-tracking':['Employee Reality Tracking','Assigned Accounts vs Actually Worked Reality & Team Summary'],
  'tracking-overview':['Tracking Overview','Global Work Date Status, Upload Integrity & Team Alignment'],
  'tracking-audit':['Tracking & Quality Audit','Inventory Reconciliation, Opening Conflicts & Unmatched Logs'],
  'team-setup':['Team Setup','Permanent CS Team Membership (New / Pending)'],
  'working-team':["Today's Working Team",'Select Daily Active CS Team Members'],
  'team-members':['Employee Master','Permanent Employee Registry & Active Status'],
  daily:['Daily Trend','Volume and Conversion Rates Across Days'],
  cancel:['Cancellation Analysis','Per-Agent Rates & Risk Tiers'],
  pending:['Pending Analysis','Orders Left in Pending Queue'],
  printed:['Printed Analysis','Printing Efficiency by Agent'],
  phone:['Alt Phone Analysis','Alternative Number Modifications'],
  employees:['Employee Profiles','In-Depth Agent Performance Cards'],
  orders:['Added Orders','Top Contributors (CS Only) & Department Split'],
  insights:['Executive Insights','Operational Recommendations'],
  scorecard:['Executive Scorecard','Ranked by KPI Performance Score'],
  data:['Detailed Data','Full Searchable Dataset']
};

function show(p){
  currentPage=p;
  try {
    const url = new URL(window.location.href);
    url.searchParams.set('page', p);
    url.searchParams.set('date', currentWorkDate);
    window.history.replaceState({ date: currentWorkDate, page: p }, '', url.toString());
  } catch (e) {}

  const root=document.getElementById('root');
  root.innerHTML=`<div class="page active">${RENDERED[p]||''}</div>`;
  document.getElementById('pgTitle').textContent=TITLES[p]?TITLES[p][0]:'';
  document.getElementById('pgSub').textContent=TITLES[p]?TITLES[p][1]:'';
  document.querySelectorAll('.nav a').forEach(a=>a.classList.toggle('active',a.dataset.p===p));
  animateBars();
  window.scrollTo(0,0);
  document.getElementById('side').classList.remove('open');

  if (p === 'work-allocation') loadWorkAllocationData();
  else if (p === 'working-team') loadWorkingTeamView();
  else if (p === 'team-members') loadTeamMembersView();
  else if (p === 'team-setup') loadTeamSetupView();
  else if (p === 'account-config') loadAccountConfigView();
  else if (p === 'accounts') loadAccountsDirectoryView();
  else if (p === 'allocation-history') loadAllocationHistoryView();
  else if (p === 'current-orders') loadCurrentOrdersView();
  else if (p === 'order-tracking') loadOrderTrackingView();
  else if (p === 'employee-tracking') loadEmployeeTrackingView();
  else if (p === 'tracking-overview') loadTrackingOverviewView();
  else if (p === 'tracking-audit') loadTrackingAuditView();
}

function render(){
  RENDERED=pages();
  show(currentPage);
}

document.querySelectorAll('.nav a').forEach(a=>{
  a.addEventListener('click',()=>show(a.dataset.p));
});

function showToast(title, body) {
  const old = document.getElementById('appToast');
  if (old) old.remove();
  const el = document.createElement('div');
  el.id = 'appToast';
  el.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#0F172A;color:#fff;padding:14px 22px;border-radius:12px;box-shadow:0 12px 40px rgba(0,0,0,.35);z-index:999;font-size:13px;display:flex;align-items:center;gap:12px;max-width:540px';
  el.innerHTML = `
    <span style="width:26px;height:26px;border-radius:50%;background:#16A34A;display:grid;place-items:center;font-weight:800;font-size:14px">✓</span>
    <div><b style="display:block">${title}</b><span style="color:#CBD5E1;font-size:12px">${body}</span></div>
    <button onclick="this.parentElement.remove()" style="margin-left:auto;background:transparent;border:none;color:#94A3B8;cursor:pointer;font-size:16px">✕</button>
  `;
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 6000);
}

async function initApp() {
  currentWorkDate = getInitialDate();
  try {
    const params = new URLSearchParams(window.location.search);
    const p = params.get('page');
    if (p && TITLES[p]) currentPage = p;
  } catch (e) {}

  updateUrlDate(currentWorkDate);
  updateGlobalDateUI();

  if (currentWorkDate !== getTodayDate()) {
    await fetchPerformanceDataForDate(currentWorkDate);
  }

  render();
}

window.addEventListener('popstate', async () => {
  const newDate = getInitialDate();
  if (newDate !== currentWorkDate) {
    currentWorkDate = newDate;
    updateGlobalDateUI();
    await fetchPerformanceDataForDate(newDate);
    render();
  }
});

initApp();
</script>

<!-- Add / Edit Employee Modal -->
<div id="employeeModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,0.6);z-index:9999;align-items:center;justify-content:center;padding:20px" onclick="if(event.target===this)closeEmployeeModal()">
  <div style="background:#fff;border-radius:14px;max-width:480px;width:100%;box-shadow:var(--shadow-lg);overflow:hidden;display:flex;flex-direction:column">
    <div style="padding:16px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;background:#F8FAFC">
      <div>
        <h3 id="empModalTitle" style="margin:0;font-size:16px;font-weight:700;color:var(--ink)">+ Add Employee</h3>
        <p id="empModalSubtitle" style="margin:3px 0 0 0;font-size:12px;color:var(--mut)">Manually add a permanent team member to Master</p>
      </div>
      <button class="btn sm" onclick="closeEmployeeModal()" type="button" style="padding:4px 9px">✕ Close</button>
    </div>
    <form id="empModalForm" onsubmit="handleEmployeeFormSubmit(event)" style="padding:20px;display:flex;flex-direction:column;gap:14px;margin:0">
      <input type="hidden" id="empModalId" value="">
      
      <div>
        <label for="empModalName" style="display:block;font-size:12px;font-weight:700;color:var(--slate);margin-bottom:6px">Employee Name <span style="color:#DC2626">*</span></label>
        <input type="text" id="empModalName" placeholder="e.g. Ahmed Test" required style="width:100%;box-sizing:border-box;padding:9px 12px;border:1px solid var(--line);border-radius:8px;font-size:13px;outline:none">
      </div>

      <div>
        <label for="empModalDept" style="display:block;font-size:12px;font-weight:700;color:var(--slate);margin-bottom:6px">Department <span style="color:#DC2626">*</span></label>
        <select id="empModalDept" style="width:100%;box-sizing:border-box;padding:9px 12px;border:1px solid var(--line);border-radius:8px;font-size:13px;outline:none;background:#fff">
          <option value="CS">CS (Customer Service)</option>
          <option value="Other">Other</option>
          <option value="Data Entry">Data Entry</option>
        </select>
      </div>

      <div>
        <label for="empModalActive" style="display:block;font-size:12px;font-weight:700;color:var(--slate);margin-bottom:6px">Status</label>
        <select id="empModalActive" style="width:100%;box-sizing:border-box;padding:9px 12px;border:1px solid var(--line);border-radius:8px;font-size:13px;outline:none;background:#fff">
          <option value="1">Active</option>
          <option value="0">Inactive</option>
        </select>
        <p style="margin:4px 0 0 0;font-size:11px;color:var(--mut)">Inactive employees retain all historical allocations and performance logs permanently.</p>
      </div>

      <div id="empModalError" style="display:none;padding:10px 14px;background:#FEE2E2;border:1px solid #FECACA;color:#991B1B;border-radius:8px;font-size:12px;line-height:1.4"></div>

      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:6px">
        <button type="button" class="btn" onclick="closeEmployeeModal()">Cancel</button>
        <button type="submit" class="btn primary" id="empModalSubmitBtn">Save Employee</button>
      </div>
    </form>
  </div>
</div>

<!-- Account Rule Modal -->
<div id="accountRuleModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,0.6);z-index:9999;align-items:center;justify-content:center;padding:20px" onclick="if(event.target===this)closeAccountRuleModal()">
  <div style="background:#fff;border-radius:14px;max-width:620px;width:100%;box-shadow:var(--shadow-lg);overflow:hidden;display:flex;flex-direction:column;max-height:90vh">
