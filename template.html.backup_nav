      <button class="btn sm" onclick="closeAccountRuleModal()" type="button" style="padding:4px 9px">✕ Close</button>
    </div>
    <form id="accRuleModalForm" onsubmit="handleAccountRuleSubmit(event)" style="padding:20px;display:flex;flex-direction:column;gap:14px;margin:0;overflow-y:auto">
      <input type="hidden" id="accRuleModalId" value="">
      
