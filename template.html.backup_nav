      </div>
    </div>
  </div>
</div>

<!-- Order-Level Audit & Manual Override Modal -->
<div id="orderLevelModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,0.65);z-index:9999;align-items:center;justify-content:center;padding:20px" onclick="if(event.target===this)closeOrderLevelModal()">
  <div style="background:#fff;border-radius:16px;max-width:980px;width:100%;box-shadow:var(--shadow-lg);overflow:hidden;display:flex;flex-direction:column;max-height:92vh">
    <div style="padding:16px 22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;background:#F8FAFC">
      <div>
        <h3 style="margin:0;font-size:17px;font-weight:800;color:var(--navy)">🔍 Order-Level Allocation & Manual Overrides</h3>
        <p style="margin:3px 0 0 0;font-size:12px;color:var(--mut)">Inspect individual order code assignments, fair quotas, and reassign orders on the fly</p>
      </div>
      <button class="btn sm" onclick="closeOrderLevelModal()" type="button" style="padding:4px 9px">✕ Close</button>
    </div>
    <div id="orderLevelModalContent" style="padding:20px;overflow-y:auto;flex:1"></div>
  </div>
</div>

<div id="shareModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:100;align-items:center;justify-content:center;padding:20px" onclick="if(event.target===this)this.style.display='none'">
  <div style="background:#fff;max-width:560px;width:100%;border-radius:16px;padding:26px;box-shadow:0 24px 60px rgba(0,0,0,.3)">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
      <h3 style="font-size:17px;font-weight:800;color:#0F172A;margin:0">Share this dashboard</h3>
      <button onclick="document.getElementById('shareModal').style.display='none'" style="border:none;background:#F1F5F9;width:30px;height:30px;border-radius:8px;cursor:pointer;font-size:15px;color:#64748B">&#10005;</button>
    </div>
    <p style="font-size:13px;color:#475569;line-height:1.6;margin-bottom:16px">This application is running live with a real persistent database backend.</p>
    <button class="btn primary" style="width:100%;justify-content:center" onclick="downloadSelf()">&#8595; Download Static Backup</button>
  </div>
</div>

<script>
function downloadSelf(){
  const out = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
  const blob = new Blob([out], { type: 'text/html' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'CS_Executive_Dashboard.html';
  document.body.appendChild(a);
  a.click();
  a.remove();
}
</script>
</body>
</html>
